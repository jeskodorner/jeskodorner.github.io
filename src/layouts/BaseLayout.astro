---
import '@fontsource/instrument-serif/400.css';
import '@fontsource/instrument-serif/400-italic.css';
import '@fontsource-variable/archivo/standard.css';
import '../styles/global.css';

import BaseHead, { type Props as HeadProps } from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../config/site';
import { useTranslations } from '../i18n';

export interface Props extends HeadProps {
  /** Zusätzliche Klasse für <main> */
  mainClass?: string;
  /** Ohne weiße Leiste und Fußzeile (Startseite = blaues Menü) */
  bare?: boolean;
}

const { mainClass, bare = false, ...head } = Astro.props;
const t = useTranslations();
---

<!doctype html>
<html lang={site.lang} id="top">
  <head>
    <BaseHead {...head} />
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">{t.skipLink}</a>
    {!bare && <Header />}
    <main id="main" class={mainClass} tabindex="-1">
      <slot />
    </main>
    {!bare && <Footer />}
  </body>
</html>

<style>
  main:focus {
    outline: none;
  }
</style>
