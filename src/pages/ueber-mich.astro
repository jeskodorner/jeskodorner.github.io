---
import { getEntry, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ParallaxImage from '../components/ParallaxImage.astro';
import EmailLink from '../components/EmailLink.astro';
import Icon from '../components/Icon.astro';
import portrait from '../assets/portrait.jpg';
import { site } from '../config/site';
import { useTranslations } from '../i18n';
import { cardImage } from '../lib/og';
import { preloadImage } from '../lib/images';
import { PORTRAIT_SIZES } from '../lib/sizes';
import { inlineMd } from '../lib/text';

const t = useTranslations();
// Texte: src/content/pages/ueber-mich.md · Porträt: src/assets/portrait.jpg
const entry = await getEntry('pages', 'ueber-mich');
const data = entry?.data;
const Content = entry ? (await render(entry)).Content : null;
const stations = data?.stations ?? [];
const gear = data?.gear ?? [];
const portraitAlt = data?.portraitAlt ?? `Porträt von ${site.name}`;
const og = cardImage('ueber-mich', portraitAlt);
// Porträt schon im Kopf ankündigen
const hero = await preloadImage(portrait, PORTRAIT_SIZES);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  mainEntity: { '@type': 'Person', name: site.name, url: site.url, jobTitle: site.jobTitle, sameAs: [site.instagram.url] },
};
---

<BaseLayout
  title={t.about.title}
  description={data?.lead ?? `Über ${site.name}`}
  image={og}
  type="profile"
  jsonLd={jsonLd}
  preload={hero}
>
  <section class="container container--wide head">
    <h1 class="display display-1">{t.about.title}</h1>
  </section>

  <section class="container container--wide intro">
    <div class="portrait">
      {/* Ohne Einblenden (reveal): Das Porträt steht oben auf der Seite und war beim Laden schon halb im Bild – es blieb
          dann blass, bis man scrollte. Die leichte Bewegung beim Scrollen bleibt. */}
      <ParallaxImage src={portrait} alt={portraitAlt} sizes={PORTRAIT_SIZES} ratio="4 / 5" loading="eager" fetchpriority="high" soft reveal={false} />
    </div>
    <div class="text">
      {data?.lead && <p class="lead" set:html={inlineMd(data.lead)} />}
      {
        Content && (
          <div class="prose">
            <Content />
          </div>
        )
      }
      <p class="actions btn-row">
        <EmailLink class="btn btn--solid" text={t.selected.write} subject="Anfrage über die Website" />
        <a class="btn" href="/portfolio/">
          {t.home.cta} <Icon name="arrow-right" class="arrow" />
        </a>
      </p>
    </div>
  </section>

  {
    stations.length > 0 && (
      <section class="container container--wide section stations" aria-labelledby="st-h">
        <h2 id="st-h" class="display display-3">{t.about.stations}</h2>
        <ol role="list">
          {stations.map((s) => (
            <li class="rise">
              <span class="display yr">{s.year}</span>
              <span class="st-title">{s.title}</span>
              {s.text && <span class="muted">{s.text}</span>}
            </li>
          ))}
        </ol>
      </section>
    )
  }

  {
    gear.length > 0 && (
      <section class="container container--wide gear" aria-labelledby="gear-h">
        <h2 id="gear-h" class="subhead">{t.about.gear}</h2>
        <ul role="list">
          {gear.map((g) => (
            <li>{g}</li>
          ))}
        </ul>
      </section>
    )
  }
</BaseLayout>

<style>
  .head {
    padding-bottom: clamp(2rem, 4vw, 3.5rem);
  }
  .intro {
    display: grid;
    gap: clamp(2rem, 5vw, 5rem);
  }
  @media (min-width: 900px) {
    .intro {
      grid-template-columns: 5fr 7fr;
      align-items: start;
    }
    .portrait {
      position: sticky;
      top: calc(var(--header-h) + 1.5rem);
    }
  }
  .portrait :global(.px) {
    width: 100%;
    box-shadow: var(--hang-shadow);
  }
  .text {
    display: grid;
    gap: 2rem;
    align-content: start;
  }
  .text .lead {
    font-size: clamp(1.6rem, 1.1rem + 1.8vw, 3rem);
    line-height: 1.18;
  }
  /* Stationen als schlichte Liste mit feinen Linien (bis 20.11.2026 graue Kästen – wirkte wie ein Formular):
     Jahr · was · Zeitraum. Laptop drei Spalten, Handy untereinander. */
  .stations ol {
    list-style: none;
    padding: 0;
    margin-top: clamp(1.25rem, 3vw, 2rem);
    border-bottom: 1px solid var(--line);
  }
  .stations li {
    display: grid;
    gap: 0.15rem 2rem;
    padding-block: 0.9rem;
    border-top: 1px solid var(--line);
  }
  @media (min-width: 760px) {
    .stations li {
      grid-template-columns: 7rem minmax(0, 1.2fr) minmax(0, 1fr);
      align-items: baseline;
    }
  }
  /* Jahreszahlen untereinander: gleich breite Ziffern */
  .yr {
    font-size: 1.5rem;
    line-height: 1;
    font-variant-numeric: lining-nums tabular-nums;
  }
  .st-title {
    font-weight: 600;
  }
  .gear ul {
    margin-top: 0.75rem;
    columns: 2 16rem;
  }
</style>
