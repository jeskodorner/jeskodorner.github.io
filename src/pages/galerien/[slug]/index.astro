---
import GalleryPage from '../../../components/GalleryPage.astro';
import { getPublicGalleries, type Gallery } from '../../../lib/galleries';

export async function getStaticPaths() {
  const galleries = await getPublicGalleries();
  return galleries.map((gallery) => ({ params: { slug: gallery.slug }, props: { gallery } }));
}

const { gallery } = Astro.props as { gallery: Gallery };
---

<GalleryPage gallery={gallery} />
