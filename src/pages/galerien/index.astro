---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Picture from '../../components/Picture.astro';
import { getPublicGalleries } from '../../lib/galleries';
import { ogImage } from '../../lib/images';
import { useTranslations, formatMonth } from '../../i18n';

const t = useTranslations();
const galleries = await getPublicGalleries();
const og = galleries[0] ? await ogImage(galleries[0].cover.src) : undefined;
---

<BaseLayout title={t.galleries.title} description={`${t.galleries.title}: ${t.galleries.intro}`} image={og}>
  <section class="container container--wide head">
    <h1 class="display display-1">
      {t.galleries.title}<sup class="count">({String(galleries.length).padStart(2, '0')})</sup>
    </h1>
    <p class="lead muted">{t.galleries.intro}</p>
  </section>

  <section class="container container--wide">
    {galleries.length === 0 && <p>{t.galleries.empty}</p>}
    <ul class="tiles" role="list">
      {
        galleries.map((g, i) => (
          <li class:list={['tile reveal', { 'tile--wide': i % 3 === 0 }]}>
            <a href={g.url}>
              <span class="media">
                <Picture
                  src={g.cover.src}
                  alt={g.cover.alt}
                  sizes={i % 3 === 0 ? '(min-width: 900px) 66vw, 100vw' : '(min-width: 900px) 33vw, 100vw'}
                  color={g.cover.color}
                  lqip={g.cover.lqip}
                  loading={i < 2 ? 'eager' : 'lazy'}
                />
                <span class="crop" aria-hidden="true" />
                <span class="overlay" aria-hidden="true">
                  <span class="label">{t.galleries.images(g.images.length)} →</span>
                </span>
              </span>
              <span class="info">
                <span class="nr display" aria-hidden="true">
                  {String(i + 1).padStart(2, '0')}
                </span>
                <span class="txt">
                  <span class="display display-3 name" style={`view-transition-name: gt-${g.slug}`}>
                    {g.title}
                  </span>
                  <span class="label muted meta-row">
                    <span>{t.galleries.images(g.images.length)}</span>
                    <span>{formatMonth(g.date)}</span>
                    {g.location && <span>{g.location}</span>}
                  </span>
                </span>
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>

<style>
  .head {
    padding-top: clamp(2.5rem, 6vw, 5rem);
    padding-bottom: clamp(2rem, 5vw, 4rem);
  }
  .count {
    font-size: 0.28em;
    vertical-align: top;
    margin-left: 0.15em;
    color: var(--accent-vivid);
    letter-spacing: 0.02em;
  }
  .lead {
    margin-top: 1rem;
  }
  .tiles {
    list-style: none;
    padding: 0;
    display: grid;
    gap: clamp(2.5rem, 5vw, 4.5rem) var(--gutter);
  }
  @media (min-width: 900px) {
    .tiles {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
    .tile--wide {
      grid-column: span 2;
    }
  }
  .tile a {
    display: grid;
    gap: 1rem;
    text-decoration: none;
  }
  .media {
    position: relative;
    display: block;
    overflow: hidden;
    aspect-ratio: 4 / 5;
    background: var(--sand);
  }
  /* 2 Spalten breit mit 16:10 ist fast genau so hoch wie 1 Spalte mit 4:5 → ruhige Zeilen */
  @media (min-width: 900px) {
    .tiles {
      grid-auto-flow: dense;
    }
    .tile--wide .media {
      aspect-ratio: 16 / 10;
    }
  }
  .media :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1.1s var(--ease);
  }
  /* Schnittmarken wie auf einem Kontaktbogen */
  .crop {
    position: absolute;
    inset: 0.9rem;
    pointer-events: none;
    opacity: 0;
    transition:
      opacity 0.4s,
      inset 0.5s var(--ease);
    --c: #fbf6ef;
    background:
      linear-gradient(var(--c), var(--c)) top left / 22px 2px,
      linear-gradient(var(--c), var(--c)) top left / 2px 22px,
      linear-gradient(var(--c), var(--c)) top right / 22px 2px,
      linear-gradient(var(--c), var(--c)) top right / 2px 22px,
      linear-gradient(var(--c), var(--c)) bottom left / 22px 2px,
      linear-gradient(var(--c), var(--c)) bottom left / 2px 22px,
      linear-gradient(var(--c), var(--c)) bottom right / 22px 2px,
      linear-gradient(var(--c), var(--c)) bottom right / 2px 22px;
    background-repeat: no-repeat;
  }
  .overlay {
    position: absolute;
    inset: auto 0 0;
    padding: 2.5rem 1.25rem 1.1rem;
    color: #fbf6ef;
    background: linear-gradient(to top, rgb(var(--scrim) / 0.75), transparent);
    opacity: 0;
    transform: translateY(0.75rem);
    transition:
      opacity 0.35s,
      transform 0.45s var(--ease);
  }
  .tile a:hover .media :global(img),
  .tile a:focus-visible .media :global(img) {
    transform: scale(1.06);
  }
  .tile a:hover .crop,
  .tile a:focus-visible .crop {
    opacity: 1;
    inset: 1.25rem;
  }
  .tile a:hover .overlay,
  .tile a:focus-visible .overlay {
    opacity: 1;
    transform: none;
  }
  .info {
    display: flex;
    gap: 1rem;
    align-items: flex-start;
  }
  .nr {
    font-size: clamp(2.5rem, 1.6rem + 2.5vw, 4.5rem);
    line-height: 0.8;
    color: var(--accent-vivid);
  }
  .txt {
    display: grid;
    gap: 0.5rem;
  }
  .name {
    transition: color 0.25s;
  }
  .tile a:hover .name {
    color: var(--accent);
  }
</style>
