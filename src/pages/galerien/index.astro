---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Picture from '../../components/Picture.astro';
import { getPublicGalleries } from '../../lib/galleries';
import { ogImage } from '../../lib/images';
import { useTranslations, formatMonth } from '../../i18n';

const t = useTranslations();
const galleries = await getPublicGalleries();
const og = galleries[0] ? await ogImage(galleries[0].cover.src) : undefined;
---

<BaseLayout title={t.galleries.title} description={`${t.galleries.title}: ${t.galleries.intro}`} image={og}>
  <section class="container container--wide head">
    <h1 class="display display-1 head-title">
      <span class="stretch">{t.galleries.title}</span>
    </h1>
    <p class="lead muted rise">{t.galleries.intro}</p>
  </section>

  {galleries.length === 0 && <p class="container">{t.galleries.empty}</p>}

  <!-- Alle Galerien wie in Lightroom in gleich hohen, randvollen Reihen; ein Klick öffnet das Album -->
  <div class="container container--wide">
    <ul class="cards" role="list" data-justify>
      {
        galleries.map((g, i) => {
          const r = g.cover.src.width / g.cover.src.height;
          return (
            <li class:list={['card-item', `c-${g.color}`]} style={`--r:${r.toFixed(4)}`}>
              <a class="card" href={g.url} data-index={i + 1}>
                <span class="card-frame">
                  <Picture
                    src={g.cover.src}
                    alt={g.cover.alt}
                    sizes={`(min-width: 700px) ${Math.round(r * 330)}px, ${Math.round(Math.min(100, r * 50))}vw`}
                    color={g.cover.color}
                    loading={i < 8 ? 'eager' : 'lazy'}
                    fetchpriority={i === 0 ? 'high' : undefined}
                    maxWidth={1200}
                  />
                </span>
                <span class="card-title" style={`view-transition-name: gt-${g.slug}`}>
                  {g.title}
                </span>
                <span class="label card-meta">
                  {t.galleries.images(g.images.length)} · {formatMonth(g.date)}
                </span>
              </a>
            </li>
          );
        })
      }
    </ul>
  </div>
</BaseLayout>
<script>
  import { initJustify } from '../../scripts/justify';
  initJustify();
</script>

<style>
  .head {
    padding-top: clamp(2rem, 5vw, 4.5rem);
    padding-bottom: clamp(2.5rem, 6vw, 5.5rem);
  }
  .head-title {
    --stretch-from: 50%;
    --stretch-to: 100%;
    font-size: clamp(4rem, 0.5rem + 16vw, 20rem);
  }
  .lead {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
    margin-top: 1rem;
  }

  /* ---------- Übersicht: Titelbilder in gleich hohen Reihen (wie Lightroom) ----------
     Jedes Bild bleibt im Originalformat. Pro Reihe sind alle Bilder gleich hoch und füllen die Breite:
     Breite ∝ Seitenverhältnis (flex-grow). scripts/justify.ts füllt jede Reihe, ohne JS bleibt die letzte ungestreckt (::after). */
  .cards {
    --row: clamp(118px, 45px + 19vw, 340px);
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: clamp(1.1rem, 2vw, 1.9rem) clamp(0.45rem, 0.8vw, 0.8rem);
  }
  .cards::after {
    content: '';
    flex-grow: 1000000;
  }
  .card-item {
    flex-grow: calc(var(--r) * 100);
    flex-basis: calc(var(--r) * var(--row));
    min-width: 0;
  }
  .card {
    display: grid;
    align-content: start;
    gap: 0.45rem;
    text-decoration: none;
    color: var(--ink);
    outline-offset: 6px;
  }
  .card-frame {
    display: block;
    overflow: hidden;
    background: var(--sand);
    margin-bottom: 0.3rem;
  }
  .card-frame :global(img) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: var(--r);
    transition: transform 0.9s var(--ease);
  }
  .card-title {
    font-family: var(--font-display);
    font-weight: 860;
    font-stretch: 70%;
    text-transform: uppercase;
    font-size: clamp(1rem, 0.85rem + 0.6vw, 1.5rem);
    line-height: 0.95;
    letter-spacing: -0.005em;
    text-wrap: balance;
    overflow-wrap: break-word;
    hyphens: auto;
  }
  .card-meta {
    color: var(--ink-soft);
    font-size: clamp(0.68rem, 0.62rem + 0.25vw, var(--fs-xs));
  }
  @media (hover: hover) {
    .card:hover :global(img) {
      transform: scale(1.04);
    }
    .card:hover .card-title {
      text-decoration: underline;
      text-decoration-color: var(--c);
      text-decoration-thickness: 0.12em;
      text-underline-offset: 0.12em;
    }
  }

</style>
