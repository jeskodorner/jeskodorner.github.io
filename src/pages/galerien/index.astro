---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ParallaxImage from '../../components/ParallaxImage.astro';
import Picture from '../../components/Picture.astro';
import ViewSwitch from '../../components/ViewSwitch.astro';
import { getPublicGalleries } from '../../lib/galleries';
import { ogImage } from '../../lib/images';
import { useTranslations, formatMonth } from '../../i18n';

const t = useTranslations();
const galleries = await getPublicGalleries();
const og = galleries[0] ? await ogImage(galleries[0].cover.src) : undefined;
---

<BaseLayout title={t.galleries.title} description={`${t.galleries.title}: ${t.galleries.intro}`} image={og}>
  <section class="container container--wide head">
    <h1 class="display display-1 head-title">
      <span class="stretch">{t.galleries.title}</span>
    </h1>
    <p class="lead muted rise">{t.galleries.intro} <span class="pill c-lime">{galleries.length} {galleries.length === 1 ? 'Galerie' : 'Galerien'}</span></p>
  </section>

  {galleries.length === 0 && <p class="container">{t.galleries.empty}</p>}

  <div class="gview">
    {galleries.length >= 4 && <ViewSwitch storageKey="jd-ansicht-galerien" />}

    <ol class="rooms view-main" role="list">
      {
        galleries.map((g, i) => (
          <li class:list={['room-item', `c-${g.color}`, { 'room-item--flip': i % 2 === 1 }]}>
            <a class="room-link" href={g.url} data-index={i + 1}>
              <ParallaxImage
                class="room-cover"
                src={g.cover.src}
                alt={g.cover.alt}
                sizes="(min-width: 900px) 55vw, 100vw"
                color={g.cover.color}
                lqip={g.cover.lqip}
                focus={g.cover.focus}
                ratio="4 / 3"
                loading={i === 0 ? 'eager' : 'lazy'}
                fetchpriority={i === 0 ? 'high' : undefined}
              />
              <span class="room-info room">
                <span class="display display-2 name" style={`view-transition-name: gt-${g.slug}`}>
                  {g.title}
                </span>
                <span class="label meta-row">
                  <span>{t.galleries.images(g.images.length)}</span>
                  <span>{formatMonth(g.date)}</span>
                  {g.location && <span>{g.location}</span>}
                </span>
                <span class="desc">{g.description}</span>
                <span class="go">
                  Galerie ansehen <span class="arrow" aria-hidden="true">→</span>
                </span>
              </span>
            </a>
          </li>
        ))
      }
    </ol>

    {
      galleries.length >= 4 && (
        <div class="view-tiles container container--wide">
          <ul class="cards" role="list">
            {galleries.map((g, i) => (
              <li class={`c-${g.color}`}>
                <a class="card" href={g.url} data-index={i + 1}>
                  <span class="card-img">
                    <Picture
                      src={g.cover.src}
                      alt={g.cover.alt}
                      sizes="(min-width: 1500px) 18vw, (min-width: 700px) 30vw, 48vw"
                      color={g.cover.color}
                      loading="lazy"
                      maxWidth={1200}
                      style={`object-position:${g.cover.focus}`}
                    />
                  </span>
                  <span class="card-title">{g.title}</span>
                  <span class="label card-meta">
                    {t.galleries.images(g.images.length)} · {formatMonth(g.date)}
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      )
    }
  </div>
</BaseLayout>
<script>
  import { initViewSwitch } from '../../scripts/view-switch';
  initViewSwitch();
</script>

<style>
  .head {
    padding-top: clamp(2rem, 5vw, 4.5rem);
    padding-bottom: clamp(2.5rem, 6vw, 5.5rem);
  }
  .head-title {
    --stretch-from: 50%;
    --stretch-to: 100%;
    font-size: clamp(4rem, 0.5rem + 16vw, 20rem);
  }
  .lead {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
    margin-top: 1rem;
  }

  .rooms {
    list-style: none;
    padding: 0;
    display: grid;
    gap: clamp(0.5rem, 1vw, 0.9rem);
  }
  .room-link {
    display: grid;
    text-decoration: none;
  }
  .room-link :global(.room-cover) {
    width: 100%;
    --px-scale: 1.08;
    --px-from: -3.5%;
    --px-to: 3.5%;
  }
  .room-info {
    display: grid;
    gap: 1rem;
    justify-items: start;
    align-content: end;
    padding: clamp(1.75rem, 4vw, 4.5rem) var(--gutter);
  }

  /* Desktop: jede Galerie füllt den Bildschirm – eine Hälfte Bild, eine Hälfte Farbe */
  @media (min-width: 900px) {
    .room-link {
      grid-template-columns: 55fr 45fr;
      height: calc(100svh - var(--header-h) + 1rem);
      min-height: 32rem;
    }
    .room-link :global(.room-cover) {
      aspect-ratio: auto !important;
      height: 100%;
    }
    .room-item--flip .room-link {
      grid-template-columns: 45fr 55fr;
    }
    .room-item--flip .room-link :global(.room-cover) {
      grid-column: 2;
      grid-row: 1;
    }
    .room-item--flip .room-info {
      grid-column: 1;
      grid-row: 1;
    }
    .room-info {
      padding: clamp(2rem, 4vw, 4.5rem);
    }
  }

  @media (hover: hover) {
    .room-link:hover :global(.px picture) {
      scale: 1.035;
    }
  }
  /* ---------- Übersicht: alle Galerien als Karten ---------- */
  .cards {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(15rem, 45%), 1fr));
    gap: clamp(1.5rem, 3vw, 2.75rem) clamp(0.6rem, 1.4vw, 1.5rem);
  }
  .card {
    display: grid;
    align-content: start;
    gap: 0.55rem;
    text-decoration: none;
    color: var(--ink);
    outline-offset: 6px;
  }
  /* Titelbild mit Streifen in der Galeriefarbe */
  .card-img {
    display: block;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--sand);
    border-bottom: 6px solid var(--c);
    margin-bottom: 0.25rem;
  }
  .card-img :global(picture),
  .card-img :global(img) {
    display: block;
    width: 100%;
    height: 100%;
  }
  .card-img :global(img) {
    object-fit: cover;
    transition: transform 0.9s var(--ease);
  }
  .card-title {
    font-family: var(--font-display);
    font-weight: 860;
    font-stretch: 70%;
    text-transform: uppercase;
    font-size: clamp(1.15rem, 0.95rem + 0.7vw, 1.65rem);
    line-height: 0.95;
    letter-spacing: -0.005em;
    text-wrap: balance;
  }
  .card-meta {
    color: var(--ink-soft);
  }
  @media (hover: hover) {
    .card:hover :global(img) {
      transform: scale(1.04);
    }
    .card:hover .card-title {
      text-decoration: underline;
      text-decoration-color: var(--c);
      text-decoration-thickness: 0.12em;
      text-underline-offset: 0.12em;
    }
  }

  .desc {
    font-size: var(--fs-lead);
    font-weight: 500;
    line-height: 1.3;
    max-width: 30ch;
  }
  .go {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    margin-top: 0.5rem;
    padding: 0.7em 1.3em;
    border-radius: 999px;
    border: 2.5px solid currentColor;
    font-size: var(--fs-sm);
    font-weight: 800;
    font-stretch: 85%;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    transition:
      background-color 0.2s,
      color 0.2s;
  }
  .room-link:hover .go {
    background: var(--on-c);
    color: var(--c);
  }
</style>
