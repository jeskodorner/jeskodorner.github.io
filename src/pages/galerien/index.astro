---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Picture from '../../components/Picture.astro';
import JustifyNow from '../../components/JustifyNow.astro';
import { getPublicGalleries } from '../../lib/galleries';
import { cardImage } from '../../lib/og';
import { preloadImage } from '../../lib/images';
import { cardSizes } from '../../lib/sizes';
import { useTranslations, formatMonth } from '../../i18n';
import { tidyTitle } from '../../lib/text';

const t = useTranslations();
const galleries = await getPublicGalleries();
const og = cardImage('galerie', galleries[0]?.cover.alt);
// erstes Titelbild schon im Kopf ankündigen (gleiche Größenangabe und Höchstbreite wie in der Kachel)
const c0 = galleries[0]?.cover.src;
const hero = c0 ? await preloadImage(c0, cardSizes(c0.width / c0.height), 1200) : undefined;
---

<BaseLayout title={t.galleries.title} description={t.galleries.intro} image={og} preload={hero}>
  <section class="container container--wide head">
    <h1 class="display display-1">{t.galleries.title}</h1>
    <p class="lead muted rise">{t.galleries.intro}</p>
  </section>

  {galleries.length === 0 && <p class="container">{t.galleries.empty}</p>}

  <!-- Alle Galerien wie in Lightroom in gleich hohen, randvollen Reihen; ein Klick öffnet das Album -->
  <div class="container container--wide">
    <ul class="cards" role="list" data-justify>
      {
        galleries.map((g, i) => {
          const r = g.cover.src.width / g.cover.src.height;
          return (
            <li class:list={['card-item', `c-${g.color}`]} id={`album-${g.slug}`} style={`--r:${r.toFixed(4)}`}>
              <a class="card" href={g.url} data-index={i + 1}>
                <span class="card-frame">
                  <Picture
                    src={g.cover.src}
                    alt={g.cover.alt}
                    sizes={cardSizes(r)}
                    color={g.cover.color}
                    loading={i < 4 ? 'eager' : 'lazy'}
                    fetchpriority={i === 0 ? 'high' : undefined}
                    maxWidth={1200}
                  />
                </span>
                <span class="card-title" style={`view-transition-name: gt-${g.slug}`}>
                  {tidyTitle(g.title)}
                </span>
                {/* Unter dem Titel nur Monat und Jahr (die Anzahl der Fotos stand bis 20.11.2026 davor); geschütztes
                    Leerzeichen: nie zwischen Monat und Jahr umbrechen */}
                <span class="label card-meta">{formatMonth(g.date).replace(' ', '\u00A0')}</span>
              </a>
            </li>
          );
        })
      }
    </ul>
    {/* Reihen sofort verteilen, noch vor dem ersten Bild */}
    <JustifyNow />
  </div>
</BaseLayout>
<script>
  import { initJustify } from '../../scripts/justify';
  initJustify();
  // Aus einem Album zurück: nach dem Verteilen der Reihen das Album mittig zeigen. Die Stelle, die sich der Browser
  // gemerkt hat, passt nicht mehr, sobald die Reihen neu verteilt sind (gemessen 21.11.2026: Album 300 px zu tief,
  // halb unter dem Bildschirmrand). Zwei Wege hierher:
  // - „← Zurück“ oder Zurück-Knopf des Browsers (Album war vorher hier angeklickt, gemerkt im Tab): das Album zeigen
  // - Link von außen ins Album, dort „← Zurück“ (keine Vorgeschichte): Adresse /galerien/#album-…
  const KEY = 'galerien-album';
  const remember = (id: string | null) => {
    try {
      if (id) sessionStorage.setItem(KEY, id);
      else sessionStorage.removeItem(KEY);
    } catch {
      /* ohne Speicher (privates Fenster): dann eben die Stelle des Browsers */
    }
  };
  let last: string | null = null;
  try {
    last = sessionStorage.getItem(KEY);
  } catch {
    /* s. o. */
  }
  const nav = performance.getEntriesByType('navigation')[0] as PerformanceNavigationTiming | undefined;
  const id = location.hash.startsWith('#album-') ? location.hash.slice(1) : nav?.type === 'back_forward' ? last : null;
  const target = id ? document.getElementById(id) : null;
  remember(null);
  if (target) {
    const show = () => target.scrollIntoView({ block: 'center', behavior: 'instant' });
    requestAnimationFrame(show);
    // Der Browser setzt seine gemerkte Stelle bis zum Ende des Ladens noch einmal – danach noch einmal zeigen,
    // außer man hat inzwischen selbst gescrollt
    let moved = false;
    const stop = () => (moved = true);
    addEventListener('wheel', stop, { once: true, passive: true });
    addEventListener('touchmove', stop, { once: true, passive: true });
    addEventListener('keydown', stop, { once: true });
    const again = () => requestAnimationFrame(() => !moved && show());
    if (document.readyState === 'complete') again();
    else addEventListener('load', again, { once: true });
  }
  for (const card of document.querySelectorAll<HTMLAnchorElement>('.cards .card')) {
    card.addEventListener('click', () => remember(card.closest('li')?.id ?? null));
  }
  // Aus dem Zwischenspeicher des Browsers zurück (Seite unverändert, Stelle stimmt): nichts tun, Merkzettel weg
  addEventListener('pageshow', (e) => e.persisted && remember(null));
</script>

<style>
  .head {
    padding-bottom: clamp(2.5rem, 6vw, 5.5rem);
  }
  .lead {
    max-width: 52ch;
  }

  /* ---------- Übersicht: Titelbilder in gleich hohen Reihen (wie Lightroom) ----------
     Jedes Bild bleibt im Originalformat. Pro Reihe sind alle Bilder gleich hoch und füllen die Breite:
     Breite ∝ Seitenverhältnis (flex-grow). scripts/justify.ts füllt jede Reihe, ohne JS bleibt die letzte ungestreckt (::after). */
  .cards {
    --row: clamp(118px, 45px + 19vw, 340px);
    /* So schmal wird kein Titelbild (Hochformate bleiben groß genug, der Titel passt darunter) */
    --min-w: clamp(150px, 40vw, 200px);
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: clamp(1.1rem, 2vw, 1.9rem) clamp(0.45rem, 0.8vw, 0.8rem);
  }
  .cards::after {
    content: '';
    flex-grow: 1000000;
  }
  .card-item {
    flex-grow: calc(var(--r) * 100);
    flex-basis: calc(var(--r) * var(--row));
    min-width: 0;
  }
  .card {
    display: grid;
    align-content: start;
    gap: 0.45rem;
    text-decoration: none;
    color: var(--ink);
    outline-offset: 6px;
  }
  .card-frame {
    display: block;
    overflow: hidden;
    background: var(--wall-3);
    margin-bottom: 0.3rem;
  }
  .card-frame :global(img) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: var(--r);
    transition: transform 0.9s var(--ease);
  }
  .card-title {
    font-family: var(--font-display);
    font-weight: var(--display-wght);
    font-synthesis-weight: none;
    font-size: clamp(1.15rem, 0.95rem + 0.7vw, 1.75rem);
    line-height: 1;
    letter-spacing: -0.005em;
    text-wrap: balance;
    overflow-wrap: break-word;
    hyphens: auto;
  }
  .card-meta {
    color: var(--ink-soft);
    font-size: clamp(0.72rem, 0.66rem + 0.25vw, var(--fs-xs));
  }
  @media (hover: hover) {
    .card:hover :global(img) {
      transform: scale(var(--hover-zoom));
    }
    .card:hover .card-title {
      text-decoration: underline;
      text-decoration-color: var(--hover-line);
      text-decoration-thickness: 0.12em;
      text-underline-offset: 0.12em;
    }
  }

</style>
