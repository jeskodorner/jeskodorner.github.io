---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Picture from '../../components/Picture.astro';
import ViewSwitch from '../../components/ViewSwitch.astro';
import { getPublicGalleries } from '../../lib/galleries';
import { ogImage } from '../../lib/images';
import { useTranslations, formatMonth } from '../../i18n';

const t = useTranslations();
const galleries = await getPublicGalleries();
const og = galleries[0] ? await ogImage(galleries[0].cover.src) : undefined;
---

<BaseLayout title={t.galleries.title} description={`${t.galleries.title}: ${t.galleries.intro}`} image={og}>
  <section class="container container--wide head">
    <h1 class="display display-1 head-title">
      <span class="stretch">{t.galleries.title}</span>
    </h1>
    <p class="lead muted rise">{t.galleries.intro} <span class="pill c-lime">{galleries.length} {galleries.length === 1 ? 'Galerie' : 'Galerien'}</span></p>
  </section>

  {galleries.length === 0 && <p class="container">{t.galleries.empty}</p>}

  <div class="gview">
    {galleries.length >= 4 && <ViewSwitch storageKey="jd-ansicht-galerien" />}

    <ol class="rooms view-main container container--wide" role="list">
      {
        galleries.map((g, i) => {
          const r = g.cover.src.width / g.cover.src.height;
          return (
            <li class:list={['room-item', `c-${g.color}`]} style={`--r:${r.toFixed(4)}`}>
              <a class="room-link" href={g.url} data-index={i + 1}>
                <span class="room-media">
                  <Picture
                    src={g.cover.src}
                    alt={g.cover.alt}
                    sizes={`(min-width: 900px) ${Math.min(58, Math.round(r * 46))}vw, 92vw`}
                    color={g.cover.color}
                    lqip={g.cover.lqip}
                    loading={i === 0 ? 'eager' : 'lazy'}
                    fetchpriority={i === 0 ? 'high' : undefined}
                    class="room-img"
                  />
                </span>
                <span class="room-info">
                  <span class="label meta-row">
                    <span>{t.galleries.images(g.images.length)}</span>
                    <span>{formatMonth(g.date)}</span>
                    {g.location && <span>{g.location}</span>}
                  </span>
                  <span class="display name" style={`view-transition-name: gt-${g.slug}`}>
                    {g.title}
                  </span>
                  <span class="desc">{g.description}</span>
                  <span class="go">
                    Galerie ansehen <span class="arrow" aria-hidden="true">→</span>
                  </span>
                </span>
              </a>
            </li>
          );
        })
      }
    </ol>

    {
      galleries.length >= 4 && (
        <div class="view-tiles container container--wide">
          <ul class="cards" role="list">
            {galleries.map((g, i) => (
              <li class={`c-${g.color}`} style={`--r:${(g.cover.src.width / g.cover.src.height).toFixed(4)}`}>
                <a class="card" href={g.url} data-index={i + 1}>
                  <span class="card-img">
                    <span class="card-frame">
                      <Picture
                        src={g.cover.src}
                        alt={g.cover.alt}
                        sizes="(min-width: 1500px) 18vw, (min-width: 700px) 30vw, 46vw"
                        color={g.cover.color}
                        loading="lazy"
                        maxWidth={1200}
                      />
                    </span>
                  </span>
                  <span class="card-title">{g.title}</span>
                  <span class="label card-meta">
                    {t.galleries.images(g.images.length)} · {formatMonth(g.date)}
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      )
    }
  </div>
</BaseLayout>
<script>
  import { initViewSwitch } from '../../scripts/view-switch';
  initViewSwitch();
</script>

<style>
  .head {
    padding-top: clamp(2rem, 5vw, 4.5rem);
    padding-bottom: clamp(2.5rem, 6vw, 5.5rem);
  }
  .head-title {
    --stretch-from: 50%;
    --stretch-to: 100%;
    font-size: clamp(4rem, 0.5rem + 16vw, 20rem);
  }
  .lead {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
    margin-top: 1rem;
  }

  /* ---------- Groß: jedes Titelbild hängt unbeschnitten an der Wand, Text daneben ---------- */
  .rooms {
    list-style: none;
    display: grid;
    gap: clamp(4rem, 2rem + 8vw, 10rem);
    /* Höchstens so hoch, dass das ganze Foto auf den Bildschirm passt */
    --room-h: max(18rem, calc(100svh - var(--header-h) - 8rem));
  }
  .room-link {
    display: grid;
    gap: 1.25rem;
    text-decoration: none;
    color: var(--ink);
  }
  .room-media {
    display: block;
    justify-self: start;
    width: min(100%, calc(var(--room-h) * var(--r)));
    box-shadow: var(--hang-shadow);
    transition: box-shadow 0.4s var(--ease);
  }
  .room-media :global(.room-img) {
    display: block;
    width: 100%;
    height: auto;
  }
  .room-info {
    display: grid;
    gap: 0.9rem;
    justify-items: start;
    max-width: 34rem;
  }
  .name {
    font-size: clamp(2rem, 1.1rem + 2.6vw, 3.9rem);
    line-height: 0.9;
    padding-top: 0.08em;
    text-wrap: balance;
  }

  /* Desktop: Foto und Text nebeneinander, abwechselnd links und rechts */
  @media (min-width: 900px) {
    .room-link {
      display: flex;
      align-items: flex-end;
      gap: clamp(2rem, 4vw, 5rem);
    }
    .room-item:nth-child(even) .room-link {
      flex-direction: row-reverse;
    }
    /* Foto rechts: Text rechtsbündig, damit er am Foto steht */
    .room-item:nth-child(even) .room-info {
      justify-items: end;
      text-align: right;
    }
    .room-item:nth-child(even) .meta-row {
      justify-content: flex-end;
    }
    .room-media {
      flex: none;
      width: min(58%, calc(var(--room-h) * var(--r)));
    }
    .room-info {
      flex: 1 1 18rem;
      padding-bottom: 0.25rem;
    }
  }

  @media (hover: hover) {
    .room-link:hover .room-media {
      box-shadow:
        0 2px 4px rgb(0 0 0 / 0.1),
        0 18px 40px -12px rgb(0 0 0 / 0.35),
        0 50px 90px -30px rgb(0 0 0 / 0.3);
    }
    .room-link:hover .name {
      text-decoration: underline;
      text-decoration-color: var(--c);
      text-decoration-thickness: 0.1em;
      text-underline-offset: 0.1em;
    }
  }

  /* ---------- Übersicht: alle Galerien als Karten ---------- */
  .cards {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(15rem, 45%), 1fr));
    gap: clamp(1.5rem, 3vw, 2.75rem) clamp(0.6rem, 1.4vw, 1.5rem);
  }
  .card {
    display: grid;
    align-content: start;
    gap: 0.55rem;
    text-decoration: none;
    color: var(--ink);
    outline-offset: 6px;
  }
  /* Titelbild unbeschnitten in einem gleich großen Feld, unten links bündig mit dem Titel */
  .card-img {
    display: grid;
    aspect-ratio: 4 / 3;
    align-items: end;
    justify-items: start;
    margin-bottom: 0.35rem;
  }
  .card-frame {
    display: block;
    width: calc(min(1, var(--r) / 1.3333) * 100%);
    overflow: hidden;
    box-shadow:
      0 1px 2px rgb(0 0 0 / 0.08),
      0 10px 24px -10px rgb(0 0 0 / 0.35);
  }
  .card-frame :global(img) {
    display: block;
    width: 100%;
    height: auto;
    transition: transform 0.9s var(--ease);
  }
  .card-title {
    font-family: var(--font-display);
    font-weight: 860;
    font-stretch: 70%;
    text-transform: uppercase;
    font-size: clamp(1.15rem, 0.95rem + 0.7vw, 1.65rem);
    line-height: 0.95;
    letter-spacing: -0.005em;
    text-wrap: balance;
  }
  .card-meta {
    color: var(--ink-soft);
  }
  @media (hover: hover) {
    .card:hover :global(img) {
      transform: scale(1.04);
    }
    .card:hover .card-title {
      text-decoration: underline;
      text-decoration-color: var(--c);
      text-decoration-thickness: 0.12em;
      text-underline-offset: 0.12em;
    }
  }

  .desc {
    font-size: clamp(1.05rem, 0.95rem + 0.4vw, 1.3rem);
    line-height: 1.4;
    max-width: 36ch;
  }
  /* Button in der Galeriefarbe */
  .go {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    margin-top: 0.35rem;
    padding: 0.7em 1.3em;
    border-radius: 999px;
    border: 2.5px solid var(--ink);
    background: var(--c);
    color: var(--on-c);
    font-size: var(--fs-sm);
    font-weight: 800;
    font-stretch: 85%;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    transition:
      background-color 0.2s,
      color 0.2s;
  }
  .room-link:hover .go {
    background: var(--ink);
    color: var(--wall);
  }
</style>
