---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ParallaxImage from '../../components/ParallaxImage.astro';
import { getPublicGalleries } from '../../lib/galleries';
import { ogImage } from '../../lib/images';
import { useTranslations, formatMonth } from '../../i18n';

const t = useTranslations();
const galleries = await getPublicGalleries();
const og = galleries[0] ? await ogImage(galleries[0].cover.src) : undefined;
---

<BaseLayout title={t.galleries.title} description={`${t.galleries.title}: ${t.galleries.intro}`} image={og}>
  <section class="container container--wide head">
    <h1 class="display display-1 drift-left">
      {t.galleries.title}<sup class="count">({String(galleries.length).padStart(2, '0')})</sup>
    </h1>
    <p class="lead muted rise">{t.galleries.intro}</p>
  </section>

  {galleries.length === 0 && <p class="container">{t.galleries.empty}</p>}

  <ol class="glist" role="list">
    {
      galleries.map((g, i) => (
        <li class:list={['gitem', { 'gitem--flip': i % 2 === 1 }]}>
          <a class="glink" href={g.url}>
            <ParallaxImage
              class="gcover"
              src={g.cover.src}
              alt={g.cover.alt}
              sizes="(min-width: 900px) 62vw, 100vw"
              color={g.cover.color}
              lqip={g.cover.lqip}
              ratio="4 / 3"
              loading={i === 0 ? 'eager' : 'lazy'}
              fetchpriority={i === 0 ? 'high' : undefined}
            >
              <span class="crop" aria-hidden="true" />
            </ParallaxImage>
            <span class="ginfo rise">
              <span class="nr display" aria-hidden="true">
                {String(i + 1).padStart(2, '0')}
              </span>
              <span class="display display-2 name" style={`view-transition-name: gt-${g.slug}`}>
                {g.title}
              </span>
              <span class="label muted meta-row">
                <span>{t.galleries.images(g.images.length)}</span>
                <span>{formatMonth(g.date)}</span>
                {g.location && <span>{g.location}</span>}
              </span>
              <span class="desc">{g.description}</span>
              <span class="go label">
                Galerie ansehen <span class="arrow" aria-hidden="true">→</span>
              </span>
            </span>
          </a>
        </li>
      ))
    }
  </ol>
</BaseLayout>

<style>
  .head {
    padding-top: clamp(2.5rem, 6vw, 5rem);
    padding-bottom: clamp(3rem, 8vw, 7rem);
  }
  .count {
    font-size: 0.28em;
    vertical-align: top;
    margin-left: 0.15em;
    color: var(--accent-vivid);
    letter-spacing: 0.02em;
  }
  .lead {
    margin-top: 1rem;
  }

  .glist {
    list-style: none;
    padding: 0;
    display: grid;
    gap: clamp(5rem, 2rem + 11vw, 14rem);
  }
  .gitem {
    width: 100%;
    max-width: 2400px;
    margin-inline: auto;
    padding-inline: var(--gutter);
  }
  .glink {
    display: grid;
    gap: clamp(1.25rem, 3vw, 2.5rem);
    text-decoration: none;
    align-items: center;
  }
  @media (min-width: 900px) {
    .glink {
      grid-template-columns: 62fr 38fr;
      column-gap: clamp(2rem, 5vw, 6rem);
    }
    .gitem--flip .glink {
      grid-template-columns: 38fr 62fr;
    }
    .gitem--flip :global(.gcover) {
      grid-column: 2;
      grid-row: 1;
    }
    .gitem--flip .ginfo {
      grid-column: 1;
      grid-row: 1;
    }
  }
  .glink :global(.gcover) {
    width: 100%;
  }

  /* Schnittmarken wie auf einem Kontaktbogen */
  .crop {
    position: absolute;
    inset: 1rem;
    pointer-events: none;
    opacity: 0;
    transition:
      opacity 0.4s,
      inset 0.6s var(--ease);
    --c: #fbf6ef;
    background:
      linear-gradient(var(--c), var(--c)) top left / 26px 2px,
      linear-gradient(var(--c), var(--c)) top left / 2px 26px,
      linear-gradient(var(--c), var(--c)) top right / 26px 2px,
      linear-gradient(var(--c), var(--c)) top right / 2px 26px,
      linear-gradient(var(--c), var(--c)) bottom left / 26px 2px,
      linear-gradient(var(--c), var(--c)) bottom left / 2px 26px,
      linear-gradient(var(--c), var(--c)) bottom right / 26px 2px,
      linear-gradient(var(--c), var(--c)) bottom right / 2px 26px;
    background-repeat: no-repeat;
  }
  .glink:hover .crop,
  .glink:focus-visible .crop {
    opacity: 1;
    inset: 1.6rem;
  }
  @media (hover: hover) {
    .glink:hover :global(.px picture) {
      scale: 1.04;
    }
  }

  .ginfo {
    display: grid;
    gap: 0.9rem;
    justify-items: start;
  }
  .nr {
    font-size: clamp(3.5rem, 2rem + 5vw, 8rem);
    line-height: 0.8;
    color: var(--accent-vivid);
  }
  .name {
    transition: color 0.25s;
  }
  .glink:hover .name {
    color: var(--accent);
  }
  .desc {
    font-family: var(--font-serif);
    font-weight: 340;
    font-size: var(--fs-lead);
    line-height: 1.35;
    max-width: 30ch;
  }
  .go {
    margin-top: 0.5rem;
    padding-bottom: 0.3rem;
    border-bottom: 2px solid currentColor;
  }
</style>
