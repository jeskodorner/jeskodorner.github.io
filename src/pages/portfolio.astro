---
/**
 * Portfolio: die kuratierte Auswahl aus startseite.md (Liste "showroom") als kleine Ausstellung.
 * Gegenpol zur Galerie (offenes Archiv). Jedes Foto hängt einzeln an der Wand; ein Klick öffnet die Mappe seines Albums.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Hanging from '../components/Hanging.astro';
import Icon from '../components/Icon.astro';
import EmailLink from '../components/EmailLink.astro';
import { getSelectedWorks } from '../lib/showroom';
import { cardImage } from '../lib/og';
import { useTranslations } from '../i18n';

const t = useTranslations();
const works = await getSelectedWorks();
const og = cardImage('portfolio', works[0]?.image.alt);

---

<BaseLayout title={t.selected.title} description={t.selected.intro} image={og}>
  <section class="container container--wide head">
    <h1 class="display display-1">{t.selected.title}</h1>
    <p class="lead muted rise">
      {t.selected.intro}
    </p>
  </section>

  <div class="container container--wide">
    <Hanging items={works} />
  </div>

  {/* Abschluss: erst die wichtigste Handlung (schreiben), daneben der Weg zu allen Fotos */}
  <p class="container container--wide more btn-row">
    <EmailLink class="btn btn--solid" text={t.selected.write} subject="Anfrage über die Website" />
    <a class="btn" href="/galerien/">
      {t.selected.toGallery} <Icon name="arrow-right" class="arrow" />
    </a>
  </p>
</BaseLayout>

<style>
  .head {
    padding-bottom: clamp(2.5rem, 6vw, 5.5rem);
  }
  .lead {
    max-width: 52ch;
  }
  .more {
    padding-top: var(--section);
  }
  /* Handy: Überschrift und Einleitung linksbündig wie auf allen Seiten, nur der Inhalt mittig – Fotos mit Schildern
     (Hanging.astro) und die Knöpfe am Ende */
  @media (max-width: 899.98px) {
    .more {
      justify-content: center;
    }
  }
</style>
