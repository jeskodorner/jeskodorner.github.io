---
/**
 * Ausgewählte Arbeiten: die kuratierte Auswahl aus startseite.md (Liste "showroom") als kleine Ausstellung.
 * Gegenpol zur Galerie (offenes Archiv). Jedes Foto hängt einzeln an der Wand; ein Klick öffnet es im Album.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Hanging from '../components/Hanging.astro';
import { getSelectedWorks } from '../lib/showroom';
import { ogImage } from '../lib/images';
import { useTranslations } from '../i18n';

const t = useTranslations();
const works = await getSelectedWorks();
const og = works[0] ? await ogImage(works[0].image.src) : undefined;
---

<BaseLayout title={t.selected.title} description={t.selected.intro} image={og}>
  <section class="container container--wide head">
    <h1 class="display display-1 head-title">
      <span class="stretch">{t.selected.title.split(' ')[0]}</span>
      <span class="stretch">{t.selected.title.split(' ').slice(1).join(' ')}</span>
    </h1>
    <p class="lead muted rise">
      {t.selected.intro} <span class="pill c-lime">{t.selected.count(works.length)}</span>
    </p>
  </section>

  <div class="container container--wide">
    <Hanging items={works} />
  </div>

  <p class="container container--wide more">
    <a class="btn" href="/galerien/">
      {t.selected.toGallery} <span class="arrow" aria-hidden="true">→</span>
    </a>
  </p>
</BaseLayout>

<style>
  .head {
    /* Schriftgröße folgt der verfügbaren Breite (cqi), damit „AUSGEWÄHLTE“ auch gedehnt nie über den Rand ragt */
    container-type: inline-size;
    padding-top: clamp(2rem, 5vw, 4.5rem);
    padding-bottom: clamp(2.5rem, 6vw, 5.5rem);
  }
  .head-title {
    --stretch-from: 50%;
    --stretch-to: 100%;
    display: grid;
    /* „AUSGEWÄHLTE“ ist bei voller Dehnung knapp 7,8 Schrifthöhen breit */
    font-size: min(14rem, 100cqi / 8);
  }
  .lead {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
    max-width: 52ch;
    margin-top: 1rem;
  }
  .more {
    padding-top: var(--section);
  }
</style>
