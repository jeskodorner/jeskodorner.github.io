---
import BaseLayout from '../layouts/BaseLayout.astro';
import { useTranslations } from '../i18n';
const t = useTranslations().notFound;
---

<BaseLayout title={t.title} description={t.text} noindex>
  <section class="container container--wide nf">
    <p class="label muted">Fehler 404</p>
    <h1 class="display mega">Unter&shy;<em>belichtet.</em></h1>
    <p class="lead">{t.text}</p>
    <p class="actions">
      <a class="btn btn--solid" href="/">{t.home}</a>
      <a class="btn" href="/galerien/">{t.galleries}</a>
    </p>
  </section>
</BaseLayout>

<style>
  .nf {
    padding-top: clamp(3rem, 8vw, 7rem);
    display: grid;
    gap: 1.75rem;
    justify-items: start;
  }
  .lead {
    max-width: 40ch;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
</style>
