---
import BaseLayout from '../layouts/BaseLayout.astro';
import { useTranslations } from '../i18n';
const t = useTranslations().notFound;
---

<BaseLayout title={t.title} description={t.text} noindex>
  <section class="container container--wide head nf">
    {/* bis 20.11.2026 „Unterbelichtet.“ */}
    <h1 class="display display-1">{t.title}.</h1>
    <p class="lead">{t.text}</p>
    <p class="actions">
      <a class="btn btn--solid" href="/">{t.home}</a>
      <a class="btn" href="/galerien/">{t.galleries}</a>
    </p>
  </section>
</BaseLayout>

<style>
  .nf {
    display: grid;
    gap: 1.75rem;
    justify-items: start;
  }
  .lead {
    max-width: 40ch;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
</style>
