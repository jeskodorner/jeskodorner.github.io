---
import BaseLayout from '../layouts/BaseLayout.astro';
import EmailLink from '../components/EmailLink.astro';
import ContactForm from '../components/ContactForm.astro';
import Icon from '../components/Icon.astro';
import { site } from '../config/site';
import { useTranslations } from '../i18n';

const t = useTranslations();
---

<BaseLayout title={t.contact.title} description={`Kontakt zu ${site.name}: E-Mail und Instagram.`}>
  <section class="container container--wide head">
    <h1 class="display display-1">{t.contact.title}</h1>
    <p class="lead muted">{t.contact.intro}</p>
  </section>

  <section class:list={['container container--wide grid', { 'has-form': Boolean(site.contactForm.endpoint) }]}>
    <dl class="channels">
      <div id="email">
        <dt class="visually-hidden">{t.contact.email}</dt>
        <dd><EmailLink class="channel" subject="Anfrage über die Website" /></dd>
      </div>
      <div>
        <dt class="visually-hidden">{t.contact.instagram}</dt>
        <dd>
          <a class="channel" href={site.instagram.url} rel="me noopener" target="_blank">
            <Icon name="instagram" size="0.9em" />
            <span class="channel-text">{site.instagram.handle.toLowerCase()}</span>
            <span class="visually-hidden">(Instagram, neuer Tab)</span>
          </a>
        </dd>
      </div>
    </dl>
    <ContactForm />
  </section>
</BaseLayout>

<style>
  .head {
    padding-bottom: clamp(2rem, 4vw, 3.5rem);
  }
  .lead {
    max-width: 40ch;
  }
  .grid {
    display: grid;
    gap: clamp(2.5rem, 6vw, 6rem);
  }
  @media (min-width: 1000px) {
    .grid.has-form {
      grid-template-columns: 1fr 1fr;
    }
  }
  .channels {
    display: grid;
    gap: clamp(1rem, 2.5vw, 1.75rem);
    align-content: start;
    justify-items: start;
  }
  .channels dd {
    margin: 0;
  }
  /* Symbol vor der Adresse: feine Linie passend zur Schrift, optisch auf die Mitte der Kleinbuchstaben gesetzt */
  .channels :global(.channel svg) {
    flex: none;
    width: 0.62em;
    height: 0.62em;
    align-self: center;
    stroke-width: 1.2;
    translate: 0 0.06em;
  }
  .channels :global(.channel) {
    font-family: var(--font-display);
    font-weight: 400;
    font-synthesis-weight: none;
    font-size: clamp(1.9rem, 0.6rem + 5.6vw, 6rem);
    line-height: 0.95;
    text-decoration: none;
    overflow-wrap: break-word;
    display: inline-flex;
    align-items: baseline;
    gap: 0.25em;
  }
  /* Unterstrich im Blau der Links, nur unter der Adresse (nicht unter dem Symbol); beim Überfahren wächst er zur
     orangen Fläche */
  .channels :global(.channel-text),
  .channels :global(.email-text) {
    background: linear-gradient(var(--accent), var(--accent)) no-repeat 0 100% / 100% 0.14em;
    transition: background-size 0.3s var(--pop);
  }
  .channels :global(.channel:hover) {
    color: var(--ink);
  }
  .channels :global(.channel:hover .channel-text),
  .channels :global(.channel:hover .email-text) {
    background-image: linear-gradient(var(--hover), var(--hover));
    background-size: 100% 100%;
  }
</style>
