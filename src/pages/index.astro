---
/**
 * Startseite = das blaue Menü: oben groß der Name, darunter die Menüpunkte (rechts daneben ein kleines Bildfeld
 * mit überblendeten Portfolio-Fotos, BlendLoop.astro), unten Instagram und Rechtliches.
 * Füllt genau den Bildschirm (ohne weißen Streifen, ohne Scrollen, solange alles passt). Baustein: BlueMenu.astro
 * Die frühere Startseite (Karussell, Bilderstapel, Statement, Film, Kontakt) liegt in der Git-Geschichte.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import BlueMenu from '../components/BlueMenu.astro';
import BlendLoop from '../components/BlendLoop.astro';
import { site } from '../config/site';
import { getSelectedWorks } from '../lib/showroom';
import { ogImage } from '../lib/images';

// Vorschaubild für Link-Vorschauen (WhatsApp, Instagram …): erstes Foto aus dem Portfolio
const works = await getSelectedWorks();
const og = works[0] ? await ogImage(works[0].image.src) : undefined;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  url: site.url,
  jobTitle: site.jobTitle,
  sameAs: [site.instagram.url],
};
---

<BaseLayout image={og} jsonLd={jsonLd} bare mainClass="home">
  <BlueMenu>
    <BlendLoop slot="aside" works={works} />
  </BlueMenu>
</BaseLayout>

<style>
  /* Ganze Seite blau – auch beim Überziehen am Rand und hinter der Adressleiste am Handy */
  :global(html:has(main.home)),
  :global(html:has(main.home) body) {
    background: var(--menu-bg);
  }
  :global(main.home) {
    display: flex;
    flex-direction: column;
    min-height: 100dvh;
  }
  :global(main.home) > :global(.bm) {
    flex: 1;
  }
</style>
