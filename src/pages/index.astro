---
/**
 * Startseite = das blaue Menü mit einem Foto daneben („Bild neben Name“): Name, „Fotografie“, Menüpunkte und
 * Instagram auf Blau, daneben (Handy: darüber) ein scharfes Foto aus dem Portfolio mit Bildunterschrift
 * (HomeSlides.astro). Die frühere Doppelbelichtung liegt im Git-Tag alte-version-startseite-ueberblendung.
 * Füllt genau den Bildschirm (ohne weißen Streifen, ohne Scrollen, solange alles passt). Baustein: BlueMenu.astro
 * Die frühere Startseite (Karussell, Bilderstapel, Statement, Film, Kontakt) liegt in der Git-Geschichte.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import BlueMenu from '../components/BlueMenu.astro';
import HomeSlides from '../components/HomeSlides.astro';
import { site } from '../config/site';
import { getSelectedWorks } from '../lib/showroom';
import { cardImage } from '../lib/og';

// Vorschaukarte für Link-Vorschauen (WhatsApp, Instagram …): src/lib/og.ts
const works = await getSelectedWorks();
const og = cardImage('start', `${site.name} – Fotografie, Kamera und Film`);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  url: site.url,
  jobTitle: site.jobTitle,
  sameAs: [site.instagram.url],
};
---

<BaseLayout image={og} jsonLd={jsonLd} bare mainClass="home">
  <BlueMenu>
    <HomeSlides slot="aside" works={works} />
  </BlueMenu>
</BaseLayout>

<style>
  /* Ganze Seite blau – auch beim Überziehen am Rand und hinter der Adressleiste am Handy */
  :global(html:has(main.home)),
  :global(html:has(main.home) body) {
    background: var(--menu-bg);
  }
  :global(main.home) {
    display: flex;
    flex-direction: column;
    min-height: 100dvh;
  }
  :global(main.home) > :global(.bm) {
    flex: 1;
  }
</style>
