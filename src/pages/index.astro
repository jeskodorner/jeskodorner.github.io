---
import { getCollection, getEntry, type CollectionEntry } from 'astro:content';
import { inlineMd, wordSpans } from '../lib/text';
import BaseLayout from '../layouts/BaseLayout.astro';
import Picture from '../components/Picture.astro';
import ParallaxImage from '../components/ParallaxImage.astro';
import PhotoPile from '../components/PhotoPile.astro';
import Icon from '../components/Icon.astro';
import EmailLink from '../components/EmailLink.astro';
import portrait from '../assets/portrait.jpg';
import { site } from '../config/site';
import { useTranslations } from '../i18n';
import { getSelectedWorks } from '../lib/showroom';
import { ogImage } from '../lib/images';

const t = useTranslations();
const text: Partial<CollectionEntry<'pages'>['data']> = (await getEntry('pages', 'startseite'))?.data ?? {};
const films = (await getCollection('films')).sort((a, b) => a.data.order - b.data.order || (b.data.year ?? 0) - (a.data.year ?? 0));
// Ausgewählte Arbeiten: Liste "showroom" in src/content/pages/startseite.md (siehe lib/showroom.ts)
const works = await getSelectedWorks();
const og = works[0] ? await ogImage(works[0].image.src) : undefined;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  url: site.url,
  jobTitle: site.jobTitle,
  sameAs: [site.instagram.url],
};

// Wörter für die schlichte Zeile unter dem Statement (aus der Zeile über dem Namen, z. B. „Fotografie · Kamera · Film“)
const words = (text.kicker ?? 'Fotografie · Kamera · Film').split('·').map((w) => w.trim()).filter(Boolean);

// Karussell neben dem Namen: die ausgewählten Arbeiten blenden schlicht nacheinander über (nur Überblendung,
// keine Bewegung; reines CSS, ohne Knöpfe)
const slides = works;
const duration = slides.length * site.hero.secondsPerImage;
const share = 100 / Math.max(1, slides.length);
const fadePct = Math.min(share / 3, (1.2 / Math.max(1, duration)) * 100);
const fadeCss =
  slides.length > 1
    ? `@keyframes cs-fade{0%{opacity:0}${fadePct.toFixed(2)}%{opacity:1}${share.toFixed(2)}%{opacity:1}${(share + fadePct).toFixed(2)}%{opacity:0}100%{opacity:0}}`
    : '';
---

<BaseLayout image={og} jsonLd={jsonLd}>
  {fadeCss && <style is:inline set:html={fadeCss} slot="head" />}

  <!-- Kopf: großer Name, daneben (Handy: darunter) ein Karussell der ausgewählten Arbeiten -->
  <section class="hero container container--wide" aria-label={site.name}>
    <h1 class="hero-title display">
      <span class="ht">Jesko</span>
      <span class="ht ht-2">Dorner</span>
    </h1>
    {
      slides.length > 0 && (
        <div
          class:list={['carousel', { 'is-running': slides.length > 1 }]}
          style={`--n:${slides.length};--dur:${duration}s`}
          role="img"
          aria-label={t.home.selected}
        >
          {slides.map((w, i) => {
            const r = w.image.src.width / w.image.src.height;
            return (
              <div class="cs-slide" style={`--i:${i};--r:${r.toFixed(4)}`} aria-hidden="true">
                <Picture
                  src={w.image.src}
                  alt=""
                  sizes="(min-width: 900px) 45vw, 90vw"
                  color={w.image.color}
                  lqip={w.image.lqip}
                  loading={i === 0 ? 'eager' : 'lazy'}
                  fetchpriority={i === 0 ? 'high' : undefined}
                  maxWidth={1600}
                  class="cs-img"
                />
              </div>
            );
          })}
        </div>
      )
    }
    <div class="hero-bottom">
      <p class="hero-claim">{site.claim}</p>
      <div class="hero-ctas">
        <a class="btn btn--solid" href="/ausgewaehlte-arbeiten/">
          {t.home.cta} <span class="arrow" aria-hidden="true">→</span>
        </a>
        <a class="hero-link" href="/galerien/">
          {t.home.galleryLink} <span class="arrow" aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </section>

  <!-- Statement mit Leuchtmarker -->
  {
    (text.statement || text.note) && (
      <section class="statement container container--wide section">
        {text.statement && <p class="display display-2 words" set:html={wordSpans(text.statement)} />}
        {text.note && <p class="statement-note lead muted rise">{text.note}</p>}
      </section>
    )
  }

  <!-- Schlichte Zeile: Fotografie —— Kamera —— Film (Wörter aus der Zeile über dem Namen) -->
  <div class="disciplines container container--wide" aria-hidden="true">
    {
      words.map((w, i) => (
        <>
          {i > 0 && <span class="disc-line" />}
          <span class="disc-word">{w}</span>
        </>
      ))
    }
  </div>

  <!-- Ausgewählte Arbeiten -->
  {
    works.length > 0 && (
      <section class="selected" aria-labelledby="sel-h">
        <div class="sec-head container container--wide">
          <h2 id="sel-h" class="display display-2 sec-title">
            <span class="stretch">{t.home.selected.split(' ')[0]}</span>
            <span class="stretch">{t.home.selected.split(' ').slice(1).join(' ')}</span>
          </h2>
          <a class="btn btn--small" href="/ausgewaehlte-arbeiten/">
            {t.home.allSelected} ({works.length}) <span class="arrow" aria-hidden="true">→</span>
          </a>
        </div>
        <div class="container container--wide">
          <PhotoPile items={works} />
        </div>
      </section>
    )
  }

  <!-- Film: blaue Fläche -->
  {
    films.length > 0 && (
      <section class="film-room room c-blue" aria-labelledby="film-h">
        <div class="container container--wide section">
          <div class="sec-head">
            <h2 id="film-h" class="display display-2" set:html={inlineMd(t.home.filmTeaser.replace(/(\S+)$/, '*$1*'))} />
            <a class="btn btn--small" href="/film/">
              {t.home.filmMore} <span class="arrow" aria-hidden="true">→</span>
            </a>
          </div>
          <ul class="film-list" role="list">
            {films.slice(0, 6).map((f) => (
              <li class="rise">
                <a href={`/film/#${f.id}`} class="film-row">
                  <span class="display display-3">{f.data.title}</span>
                  <span class="label">{f.data.roles.join(' & ')}</span>
                  <span class="label">{[f.data.format, f.data.year].filter(Boolean).join(' · ')}</span>
                  <span class="arrow" aria-hidden="true">
                    →
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  <!-- Über mich (an/aus: site.home.aboutTeaser in src/config/site.ts) -->
  {
    site.home.aboutTeaser && (
      <section class="about container container--wide section" aria-labelledby="about-h">
        <ParallaxImage
          class="about-img hang"
          src={portrait}
          alt="Porträt von Jesko Dorner in orangefarbener Fleecejacke vor dichtem Grün, Blick zur Seite"
          sizes="(min-width: 900px) 40vw, 100vw"
          ratio="4 / 5"
          soft
        />
        <div class="about-text rise">
          <h2 id="about-h" class="pill c-pink">
            {t.home.aboutTeaser}
          </h2>
          {text.aboutTeaser && <p class="about-lead" set:html={inlineMd(text.aboutTeaser)} />}
          <a class="btn" href="/ueber-mich/">
            {t.home.aboutMore} <span class="arrow" aria-hidden="true">→</span>
          </a>
        </div>
      </section>
    )
  }

  <!-- Kontakt: Lime-Fläche -->
  <section class="cta room c-lime" aria-labelledby="cta-h">
    <div class="container container--wide">
      <h2 id="cta-h" class="display cta-title">
        {t.home.contactTitle.split(' ').map((w) => (
          <span class="stretch">{w}</span>
        ))}
      </h2>
      <div class="cta-row">
        <p class="lead">{t.home.contactText}</p>
        <div class="cta-actions">
          <EmailLink class="btn btn--solid" text="E-Mail schreiben" />
          <a class="btn" href={site.instagram.url} rel="me noopener" target="_blank">
            <Icon name="instagram" /> @{site.instagram.handle}
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* ---------- Kopf: Name + Karussell ----------
     Handy: Name, darunter Karussell, dann Satz und Links. Ab 900px: Name, Satz, Links links, Karussell rechts. */
  .hero {
    display: grid;
    grid-template-areas: 'name' 'carousel' 'bottom';
    gap: clamp(1.25rem, 3vw, 2.5rem);
    padding-top: clamp(1.5rem, 4vw, 3rem);
    padding-bottom: clamp(1rem, 3vw, 2rem);
    container-type: inline-size;
  }
  .hero-title {
    grid-area: name;
    display: flex;
    flex-direction: column;
    /* Größe aus der Breite: „DORNER“ passt auch voll gedehnt (100 %) in die Spalte */
    font-size: min(22rem, 100cqi / 4.6);
    line-height: 0.8;
    margin-left: -0.03em;
    padding-top: 0.06em;
  }
  .ht {
    white-space: nowrap;
    font-stretch: 58%;
  }
  .ht-2 {
    color: var(--pink);
  }
  .hero-bottom {
    grid-area: bottom;
    display: grid;
    gap: clamp(1rem, 2.5vw, 1.5rem);
    justify-items: start;
  }
  .hero-claim {
    font-size: clamp(1.35rem, 1rem + 1.2vw, 2.2rem);
    font-weight: 600;
    line-height: 1.12;
    letter-spacing: -0.015em;
    max-width: 22ch;
  }
  .hero-ctas {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.5rem;
  }
  .hero-link {
    font-size: var(--fs-sm);
    font-weight: 700;
    color: var(--ink);
  }
  .hero-link:hover {
    color: var(--accent);
  }

  /* Karussell: Fotos unbeschnitten mit Schatten, blenden nacheinander über – keine Knöpfe */
  .carousel {
    --ch: clamp(16rem, 72vw, 30rem);
    grid-area: carousel;
    position: relative;
    height: var(--ch);
  }
  .cs-slide {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
  }
  .cs-slide :global(picture) {
    display: contents;
  }
  /* Breite aus dem Seitenverhältnis: nie höher als das Karussell, nie breiter als die Spalte */
  .cs-slide :global(.cs-img) {
    display: block;
    width: min(100%, calc(var(--ch) * var(--r)));
    height: auto;
    box-shadow: var(--hang-shadow);
  }
  .is-running .cs-slide:not(:first-child) {
    opacity: 0;
  }
  @media (prefers-reduced-motion: no-preference) {
    .is-running .cs-slide {
      animation: cs-fade var(--dur) linear infinite both;
      animation-delay: calc(var(--i) * var(--dur) / var(--n) - 1.2s);
    }
    .ht,
    .hero-bottom {
      animation: hero-in 0.9s var(--ease) both;
    }
    .ht-2 {
      animation-delay: 0.08s;
    }
    /* Karussell erscheint nur, ohne sich zu bewegen */
    .carousel {
      animation: cs-in 0.8s ease both;
    }
    .hero-bottom {
      animation-delay: 0.2s;
    }
  }
  @keyframes hero-in {
    from {
      opacity: 0;
      translate: 0 2rem;
    }
  }
  @keyframes cs-in {
    from {
      opacity: 0;
    }
  }

  @media (min-width: 900px) {
    .hero {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
      grid-template-areas: 'name carousel' 'bottom carousel';
      align-content: center;
      align-items: end;
      column-gap: clamp(2rem, 5vw, 6rem);
      min-height: calc(100svh - var(--header-h) - 2rem);
    }
    .hero-title {
      /* Spalte ist gut halb so breit */
      font-size: min(16rem, 49cqi / 4.6);
      align-self: end;
    }
    .hero-bottom {
      align-self: start;
    }
    .carousel {
      --ch: min(calc(100svh - var(--header-h) - 6rem), 44rem);
      align-self: center;
    }
  }

  /* Name zieht sich beim Scrollen in die Breite */
  @supports (animation-timeline: scroll()) {
    @media (prefers-reduced-motion: no-preference) {
      .ht {
        animation-name: hero-in, ht-stretch;
        animation-duration: 0.9s, auto;
        animation-timing-function: var(--ease), linear;
        animation-fill-mode: both, both;
        animation-timeline: auto, scroll(root);
        animation-range: normal, 0 60svh;
      }
    }
  }
  @keyframes ht-stretch {
    to {
      font-stretch: 100%;
    }
  }

  /* ---------- Statement ---------- */
  .statement .words {
    max-width: 16ch;
  }
  .statement-note {
    margin-top: clamp(1.5rem, 3vw, 2.5rem);
    max-width: 44ch;
    margin-left: auto;
  }

  /* ---------- Schlichte Zeile: Fotografie —— Kamera —— Film ---------- */
  .disciplines {
    display: flex;
    align-items: center;
    gap: clamp(0.75rem, 2vw, 1.5rem);
    font-size: clamp(0.75rem, 0.68rem + 0.3vw, 0.95rem);
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }
  .disc-word {
    flex: none;
  }
  .disc-line {
    flex: 1;
    min-width: 1.25rem;
    height: 1.5px;
    background: var(--ink);
  }

  /* ---------- Abschnittsköpfe ---------- */
  .sec-head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem 2rem;
    margin-bottom: clamp(3rem, 8vw, 7rem);
  }
  .sec-title {
    display: flex;
    flex-direction: column;
    --stretch-from: 50%;
    --stretch-to: 84%;
  }
  .selected {
    padding-top: var(--section);
    /* weggeworfene Fotos fliegen über den Rand, ohne seitlich scrollbar zu machen */
    overflow-x: clip;
  }

  /* ---------- Film-Bereich ---------- */
  .film-room {
    margin-top: var(--section);
  }
  .film-room .sec-head :global(.btn) {
    border-color: var(--wall);
  }
  .film-list {
    list-style: none;
    padding: 0;
    border-top: 2.5px solid currentColor;
  }
  .film-row {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 0.4rem 1.5rem;
    align-items: baseline;
    padding-block: clamp(1rem, 2.5vw, 1.75rem);
    border-bottom: 2.5px solid currentColor;
    text-decoration: none;
    transition: padding 0.35s var(--pop);
  }
  .film-row .arrow {
    font-size: 1.6rem;
    grid-row: 1;
    grid-column: 2;
  }
  @media (min-width: 760px) {
    .film-row {
      grid-template-columns: 1.4fr 0.8fr 0.8fr auto;
    }
    .film-row .arrow {
      grid-row: auto;
      grid-column: auto;
    }
  }
  .film-row:hover {
    padding-left: 1rem;
    color: var(--lime);
  }

  /* ---------- Über mich ---------- */
  .about {
    display: grid;
    gap: clamp(2rem, 5vw, 5rem);
    align-items: center;
  }
  @media (min-width: 900px) {
    .about {
      grid-template-columns: 5fr 7fr;
    }
  }
  .about :global(.about-img) {
    width: 100%;
    max-width: 34rem;
  }
  .about-text {
    display: grid;
    gap: 1.5rem;
    justify-items: start;
  }
  .about-lead {
    font-size: clamp(1.6rem, 1.1rem + 2vw, 3.2rem);
    font-weight: 650;
    line-height: 1.08;
    letter-spacing: -0.02em;
    max-width: 22ch;
  }

  /* ---------- Kontakt-Bereich ---------- */
  .cta {
    padding-block: clamp(4rem, 9vw, 9rem);
    overflow: hidden;
  }
  /* Ohne „Über mich“ dazwischen: weiße Wand zwischen den beiden Farbflächen */
  .film-room + .cta {
    margin-top: var(--section);
  }
  .cta-title {
    display: flex;
    flex-direction: column;
    font-size: clamp(4rem, 0.6rem + 15vw, 19rem);
    line-height: 0.8;
    --stretch-from: 50%;
    --stretch-to: 96%;
  }
  .cta-row {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-end;
    gap: 1.5rem 3rem;
    margin-top: clamp(1.5rem, 4vw, 3rem);
  }
  .cta-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
</style>
