---
import { getCollection, getEntry, type CollectionEntry } from 'astro:content';
import { inlineMd, wordSpans } from '../lib/text';
import BaseLayout from '../layouts/BaseLayout.astro';
import Picture from '../components/Picture.astro';
import ParallaxImage from '../components/ParallaxImage.astro';
import Hanging, { type WorkItem } from '../components/Hanging.astro';
import Icon from '../components/Icon.astro';
import EmailLink from '../components/EmailLink.astro';
import portrait from '../assets/portrait.jpg';
import { site } from '../config/site';
import { useTranslations, formatMonth } from '../i18n';
import { getHeroImages, getPublicGalleries } from '../lib/galleries';
import { ogImage } from '../lib/images';

const t = useTranslations();
const text: Partial<CollectionEntry<'pages'>['data']> = (await getEntry('pages', 'startseite'))?.data ?? {};
const heroes = await getHeroImages();
const slideshow = site.hero.mode === 'slideshow' && heroes.length > 1;
const heroList = slideshow ? heroes : heroes.slice(0, 1);
const hero = heroes[0];
const galleries = await getPublicGalleries();
const films = (await getCollection('films')).sort((a, b) => a.data.order - b.data.order || (b.data.year ?? 0) - (a.data.year ?? 0));
const og = hero ? await ogImage(hero.image.src) : undefined;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  url: site.url,
  jobTitle: site.jobTitle,
  sameAs: [site.instagram.url],
};

// Ausgewählte Arbeiten: jede öffentliche Galerie einmal, mit ihrem Vorschaubild (Feld "cover", sonst das erste Bild)
const works: WorkItem[] = galleries.map((g) => ({
  image: g.cover,
  href: g.url,
  title: g.title,
  meta: [t.galleries.images(g.images.length), formatMonth(g.date), g.location].filter(Boolean).join(' · '),
  color: g.color,
}));

// Wörter für die Farbbänder (aus der Zeile über dem Namen, z. B. „Fotografie · Kamera · Film“)
const words = (text.kicker ?? 'Fotografie · Kamera · Film').split('·').map((w) => w.trim()).filter(Boolean);

// Ruhige Überblendung im Hero-Rahmen, falls mehrere Hero-Bilder (site.hero.mode = 'slideshow')
const duration = heroList.length * site.hero.secondsPerImage;
const share = 100 / heroList.length;
const fadePct = Math.min(share / 3, (1.5 / duration) * 100);
const fadeCss = slideshow
  ? `@keyframes hero-fade{0%{opacity:0}${fadePct.toFixed(2)}%{opacity:1}${share.toFixed(2)}%{opacity:1}${(share + fadePct).toFixed(2)}%{opacity:0}100%{opacity:0}}`
  : '';
const heroRatio = hero ? `${hero.image.src.width} / ${hero.image.src.height}` : '3 / 2';
---

<BaseLayout image={og} jsonLd={jsonLd}>
  {fadeCss && <style is:inline set:html={fadeCss} slot="head" />}

  <!-- Hero: Vollbild-Foto mit großem Namen -->
  <section class="hero" aria-label={site.name}>
    {
      hero && (
        <div
          class:list={['px px--soft hero-media', { 'is-slideshow': slideshow }]}
          style={`--n:${heroList.length};--dur:${duration}s;--focus:${hero.image.focus}`}
        >
          {heroList.map((h, i) => (
            <div class="slide" style={`--i:${i};--focus:${h.image.focus}`}>
              <Picture
                src={h.image.src}
                alt={i === 0 ? h.image.alt : ''}
                sizes="100vw"
                color={h.image.color}
                lqip={h.image.lqip}
                loading={i === 0 ? 'eager' : 'lazy'}
                fetchpriority={i === 0 ? 'high' : undefined}
              />
            </div>
          ))}
        </div>
      )
    }
    <div class="hero-shade" aria-hidden="true"></div>
    <div class="hero-content container container--wide">
      {text.kicker && <p class="pill c-lime hero-kicker">{text.kicker}</p>}
      <h1 class="hero-title display">
        <span class="ht">Jesko</span>
        <span class="ht ht-2">Dorner</span>
      </h1>
      <div class="hero-bottom">
        <p class="hero-claim">{site.claim}</p>
        <div class="hero-ctas">
          <a class="btn" href="/galerien/">
            {t.home.cta} <span class="arrow" aria-hidden="true">→</span>
          </a>
          {
            hero && (
              <a class="hero-credit" href={hero.image.pageUrl}>
                {hero.image.caption ?? hero.gallery.title} <span aria-hidden="true">→</span>
              </a>
            )
          }
        </div>
      </div>
    </div>
  </section>

  <!-- Statement mit Leuchtmarker -->
  {
    (text.statement || text.note) && (
      <section class="statement container container--wide section">
        {text.statement && <p class="display display-2 words" set:html={wordSpans(text.statement)} />}
        {text.note && <p class="statement-note lead muted rise">{text.note}</p>}
      </section>
    )
  }

  <!-- Zwei Farbbänder, die sich kreuzen und gegenläufig ziehen -->
  <div class="tapes" aria-hidden="true">
    {
      ['c-pink', 'c-lime'].map((c) => (
        <div class:list={['tape', c]}>
          <div class="tape-track">
            {[0, 1, 2, 3].flatMap(() =>
              words.map((w) => (
                <>
                  <span>{w}</span>
                  <span class="star">✺</span>
                </>
              )),
            )}
          </div>
        </div>
      ))
    }
  </div>

  <!-- Ausgewählte Arbeiten -->
  {
    works.length > 0 && (
      <section class="selected" aria-labelledby="sel-h">
        <div class="sec-head container container--wide">
          <h2 id="sel-h" class="display display-2 sec-title">
            <span class="stretch">{t.home.selected.split(' ')[0]}</span>
            <span class="stretch">{t.home.selected.split(' ').slice(1).join(' ')}</span>
          </h2>
          <a class="btn btn--small" href="/galerien/">
            {t.home.allGalleries} ({galleries.length}) <span class="arrow" aria-hidden="true">→</span>
          </a>
        </div>
        <div class="container container--wide">
          <Hanging items={works} />
        </div>
      </section>
    )
  }

  <!-- Film: blaue Fläche -->
  {
    films.length > 0 && (
      <section class="film-room room c-blue" aria-labelledby="film-h">
        <div class="container container--wide section">
          <div class="sec-head">
            <h2 id="film-h" class="display display-2" set:html={inlineMd('Auch in *Bewegung*')} />
            <a class="btn btn--small" href="/film/">
              {t.home.filmMore} <span class="arrow" aria-hidden="true">→</span>
            </a>
          </div>
          <ul class="film-list" role="list">
            {films.slice(0, 6).map((f) => (
              <li class="rise">
                <a href={`/film/#${f.id}`} class="film-row">
                  <span class="display display-3">{f.data.title}</span>
                  <span class="label">{f.data.roles.join(' & ')}</span>
                  <span class="label">{[f.data.format, f.data.year].filter(Boolean).join(' · ')}</span>
                  <span class="arrow" aria-hidden="true">
                    →
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  <!-- Über mich -->
  <section class="about container container--wide section" aria-labelledby="about-h">
    <ParallaxImage class="about-img hang" src={portrait} alt="Jesko Dorner fotografiert mit einer Fujifilm-Kamera an einer felsigen Küste, im Hintergrund Meer und Berge" sizes="(min-width: 900px) 40vw, 100vw" ratio="4 / 5" soft />
    <div class="about-text rise">
      <h2 id="about-h" class="pill c-pink">{t.home.aboutTeaser}</h2>
      {text.aboutTeaser && <p class="about-lead" set:html={inlineMd(text.aboutTeaser)} />}
      <a class="btn" href="/ueber-mich/">{t.home.aboutMore} <span class="arrow" aria-hidden="true">→</span></a>
    </div>
  </section>

  <!-- Kontakt: Lime-Fläche -->
  <section class="cta room c-lime" aria-labelledby="cta-h">
    <div class="container container--wide">
      <h2 id="cta-h" class="display cta-title">
        <span class="stretch">Lass uns</span>
        <span class="stretch">reden!</span>
      </h2>
      <div class="cta-row">
        <p class="lead">{t.home.contactText}</p>
        <div class="cta-actions">
          <EmailLink class="btn btn--solid" text="E-Mail schreiben" />
          <a class="btn" href={site.instagram.url} rel="me noopener" target="_blank">
            <Icon name="instagram" /> @{site.instagram.handle}
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* ---------- Hero: Vollbild ---------- */
  .hero {
    position: relative;
    display: flex;
    align-items: flex-end;
    min-height: calc(100svh - var(--header-h));
    color: #ffffff;
    background: #0b0b0b;
    overflow: hidden;
    isolation: isolate;
  }
  .hero-media {
    position: absolute;
    inset: 0;
    z-index: -2;
    aspect-ratio: auto;
    background: #0b0b0b;
  }
  .hero-media .slide {
    position: absolute;
    inset: 0;
  }
  .hero-media .slide :global(picture),
  .hero-media .slide :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--focus, 50% 50%);
  }
  .is-slideshow .slide:not(:first-child) {
    opacity: 0;
  }
  @media (prefers-reduced-motion: no-preference) {
    .is-slideshow .slide {
      animation: hero-fade var(--dur) linear infinite both;
      animation-delay: calc(var(--i) * var(--dur) / var(--n) - 1.5s);
    }
    .ht,
    .hero-bottom,
    .hero-kicker {
      animation: hero-in 0.9s var(--ease) both;
    }
    .ht-2 {
      animation-delay: 0.08s;
    }
    .hero-bottom {
      animation-delay: 0.2s;
    }
  }
  @keyframes hero-in {
    from {
      opacity: 0;
      translate: 0 2rem;
    }
  }
  /* Abdunklung unten, damit Name und Text auf jedem Foto lesbar bleiben */
  .hero-shade {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(to top, rgb(11 11 11 / 0.85) 0%, rgb(11 11 11 / 0.6) 45%, rgb(11 11 11 / 0.28) 80%, rgb(11 11 11 / 0.12) 100%);
  }
  .hero-content {
    display: grid;
    gap: clamp(1rem, 2.5vw, 1.75rem);
    justify-items: start;
    padding-top: 6rem;
    padding-bottom: clamp(1.5rem, 4vw, 3.5rem);
  }
  .hero-title {
    display: flex;
    flex-direction: column;
    font-size: clamp(4.6rem, 0.6rem + 18vw, 22rem);
    line-height: 0.8;
    margin-left: -0.03em;
  }
  .ht {
    white-space: nowrap;
    font-stretch: 58%;
  }
  .ht-2 {
    color: var(--pink);
  }
  .hero-bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.25rem 2rem;
    width: 100%;
  }
  .hero-claim {
    font-size: clamp(1.35rem, 1rem + 1.4vw, 2.4rem);
    font-weight: 600;
    line-height: 1.12;
    letter-spacing: -0.015em;
    max-width: 22ch;
  }
  .hero-ctas {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.5rem;
  }
  .hero-credit {
    font-size: var(--fs-sm);
    font-weight: 600;
    color: #ffffff;
  }
  .hero-credit:hover {
    color: var(--lime);
  }

  /* Name zieht sich beim Scrollen in die Breite */
  @supports (animation-timeline: scroll()) {
    @media (prefers-reduced-motion: no-preference) {
      .ht {
        animation-name: hero-in, ht-stretch;
        animation-duration: 0.9s, auto;
        animation-timing-function: var(--ease), linear;
        animation-fill-mode: both, both;
        animation-timeline: auto, scroll(root);
        animation-range: normal, 0 60svh;
      }
    }
  }
  @keyframes ht-stretch {
    to {
      font-stretch: 100%;
    }
  }

  /* ---------- Statement ---------- */
  .statement .words {
    max-width: 16ch;
  }
  .statement-note {
    margin-top: clamp(1.5rem, 3vw, 2.5rem);
    max-width: 44ch;
    margin-left: auto;
  }

  /* ---------- Abschnittsköpfe ---------- */
  .sec-head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem 2rem;
    margin-bottom: clamp(3rem, 8vw, 7rem);
  }
  .sec-title {
    display: flex;
    flex-direction: column;
    --stretch-from: 50%;
    --stretch-to: 84%;
  }
  .selected {
    padding-top: var(--section);
  }

  /* ---------- Film-Bereich ---------- */
  .film-room {
    margin-top: var(--section);
  }
  .film-room .sec-head :global(.btn) {
    border-color: var(--wall);
  }
  .film-list {
    list-style: none;
    padding: 0;
    border-top: 2.5px solid currentColor;
  }
  .film-row {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 0.4rem 1.5rem;
    align-items: baseline;
    padding-block: clamp(1rem, 2.5vw, 1.75rem);
    border-bottom: 2.5px solid currentColor;
    text-decoration: none;
    transition: padding 0.35s var(--pop);
  }
  .film-row .arrow {
    font-size: 1.6rem;
    grid-row: 1;
    grid-column: 2;
  }
  @media (min-width: 760px) {
    .film-row {
      grid-template-columns: 1.4fr 0.8fr 0.8fr auto;
    }
    .film-row .arrow {
      grid-row: auto;
      grid-column: auto;
    }
  }
  .film-row:hover {
    padding-left: 1rem;
    color: var(--lime);
  }

  /* ---------- Über mich ---------- */
  .about {
    display: grid;
    gap: clamp(2rem, 5vw, 5rem);
    align-items: center;
  }
  @media (min-width: 900px) {
    .about {
      grid-template-columns: 5fr 7fr;
    }
  }
  .about :global(.about-img) {
    width: 100%;
    max-width: 34rem;
  }
  .about-text {
    display: grid;
    gap: 1.5rem;
    justify-items: start;
  }
  .about-lead {
    font-size: clamp(1.6rem, 1.1rem + 2vw, 3.2rem);
    font-weight: 650;
    line-height: 1.08;
    letter-spacing: -0.02em;
    max-width: 22ch;
  }

  /* ---------- Kontakt-Bereich ---------- */
  .cta {
    padding-block: clamp(4rem, 9vw, 9rem);
    overflow: hidden;
  }
  .cta-title {
    display: flex;
    flex-direction: column;
    font-size: clamp(4rem, 0.6rem + 15vw, 19rem);
    line-height: 0.8;
    --stretch-from: 50%;
    --stretch-to: 96%;
  }
  .cta-row {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-end;
    gap: 1.5rem 3rem;
    margin-top: clamp(1.5rem, 4vw, 3rem);
  }
  .cta-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
</style>
