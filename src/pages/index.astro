---
import { getCollection, getEntry, type CollectionEntry } from 'astro:content';
import { inlineMd, wordSpans } from '../lib/text';
import BaseLayout from '../layouts/BaseLayout.astro';
import Picture from '../components/Picture.astro';
import ParallaxImage from '../components/ParallaxImage.astro';
import Showcase, { type StageItem } from '../components/Showcase.astro';
import Icon from '../components/Icon.astro';
import EmailLink from '../components/EmailLink.astro';
import portrait from '../assets/portrait.jpg';
import { site } from '../config/site';
import { useTranslations } from '../i18n';
import { getFeaturedImages, getHeroImages, getPublicGalleries } from '../lib/galleries';
import { ogImage } from '../lib/images';

const t = useTranslations();
const text: Partial<CollectionEntry<'pages'>['data']> = (await getEntry('pages', 'startseite'))?.data ?? {};
const heroes = await getHeroImages();
const slideshow = site.hero.mode === 'slideshow' && heroes.length > 1;
const heroList = slideshow ? heroes : heroes.slice(0, 1);
const hero = heroes[0];
const featured = await getFeaturedImages(9);
const galleries = await getPublicGalleries();
const films = (await getCollection('films')).sort((a, b) => a.data.order - b.data.order || b.data.year - a.data.year);
const og = hero ? await ogImage(hero.image.src) : undefined;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  url: site.url,
  jobTitle: site.jobTitle,
  sameAs: [site.instagram.url],
};

// Ausgewählte Arbeiten: jedes Bild hängt an seiner eigenen Wand, Farbe = Raumfarbe seiner Galerie
const stageItems: StageItem[] = featured.map(({ gallery, image }) => ({
  image,
  href: image.pageUrl,
  title: image.caption ?? gallery.title,
  kicker: gallery.title + (gallery.location ? `, ${gallery.location}` : ''),
  kickerHref: gallery.url,
  color: gallery.color,
}));

// Wörter für Sticker und Farbbänder (aus der Zeile über dem Namen, z. B. „Fotografie · Kamera · Drehbuch“)
const words = (text.kicker ?? 'Fotografie · Kamera · Drehbuch').split('·').map((w) => w.trim()).filter(Boolean);
const stickerText = `${words.join(' ✺ ')} ✺ `.toUpperCase();

// Ruhige Überblendung im Hero-Rahmen, falls mehrere Hero-Bilder (site.hero.mode = 'slideshow')
const duration = heroList.length * site.hero.secondsPerImage;
const share = 100 / heroList.length;
const fadePct = Math.min(share / 3, (1.5 / duration) * 100);
const fadeCss = slideshow
  ? `@keyframes hero-fade{0%{opacity:0}${fadePct.toFixed(2)}%{opacity:1}${share.toFixed(2)}%{opacity:1}${(share + fadePct).toFixed(2)}%{opacity:0}100%{opacity:0}}`
  : '';
const heroRatio = hero ? `${hero.image.src.width} / ${hero.image.src.height}` : '3 / 2';
---

<BaseLayout image={og} jsonLd={jsonLd}>
  {fadeCss && <style is:inline set:html={fadeCss} slot="head" />}

  <!-- Hero: Name + erstes Werk an der Wand -->
  <section class="hero container container--wide" aria-label={site.name}>
    {text.kicker && <p class="label hero-kicker">{text.kicker}</p>}
    <h1 class="hero-title display">
      <span class="ht ht-1">Jesko</span>
      <span class="ht ht-2">Dorner</span>
    </h1>

    {
      hero && (
        <figure class="hero-art">
          <a
            class:list={['px hero-frame hang', { 'is-slideshow': slideshow }]}
            href={hero.image.pageUrl}
            style={`aspect-ratio:${heroRatio};--n:${heroList.length};--dur:${duration}s`}
          >
            {heroList.map((h, i) => (
              <div class="slide" style={`--i:${i}`}>
                <Picture
                  src={h.image.src}
                  alt={i === 0 ? h.image.alt : ''}
                  sizes="(min-width: 900px) 46vw, 100vw"
                  color={h.image.color}
                  lqip={h.image.lqip}
                  loading={i === 0 ? 'eager' : 'lazy'}
                  fetchpriority={i === 0 ? 'high' : undefined}
                />
              </div>
            ))}
          </a>
          <div class="sticker spin" aria-hidden="true">
            <svg viewBox="0 0 200 200">
              <defs>
                <path id="sticker-circle" d="M100,100 m-74,0 a74,74 0 1,1 148,0 a74,74 0 1,1 -148,0" />
              </defs>
              <circle cx="100" cy="100" r="99" />
              <text class="sticker-text" textLength="458" lengthAdjust="spacing">
                <textPath href="#sticker-circle">{stickerText}</textPath>
              </text>
              <text class="sticker-mid" x="100" y="118" text-anchor="middle">
                JD
              </text>
            </svg>
          </div>
          <figcaption class="hero-placard">
            <span class="pill c-lime">Nº 01</span>
            <span>
              <strong>{hero.image.caption ?? hero.gallery.title}</strong>
              <span class="muted">
                {' '}
                — {hero.gallery.title}
                {hero.gallery.location && `, ${hero.gallery.location}`}
              </span>
            </span>
          </figcaption>
        </figure>
      )
    }

    <div class="hero-bottom">
      <p class="hero-claim">{site.claim}</p>
      <div class="hero-ctas">
        <a class="btn btn--solid" href="/galerien/">
          {t.home.cta} <span class="arrow" aria-hidden="true">→</span>
        </a>
        <a class="btn" href="/kontakt/">{t.nav.contact}</a>
      </div>
    </div>
  </section>

  <!-- Statement mit Leuchtmarker -->
  {
    (text.statement || text.note) && (
      <section class="statement container container--wide section">
        {text.statement && <p class="display display-2 words" set:html={wordSpans(text.statement)} />}
        {text.note && <p class="statement-note lead muted rise">{text.note}</p>}
      </section>
    )
  }

  <!-- Zwei Farbbänder, die sich kreuzen und gegenläufig ziehen -->
  <div class="tapes" aria-hidden="true">
    {
      ['c-pink', 'c-lime'].map((c) => (
        <div class:list={['tape', c]}>
          <div class="tape-track">
            {[0, 1, 2, 3].flatMap(() =>
              words.map((w) => (
                <>
                  <span>{w}</span>
                  <span class="star">✺</span>
                </>
              )),
            )}
          </div>
        </div>
      ))
    }
  </div>

  <!-- Ausgewählte Arbeiten -->
  {
    featured.length > 0 && (
      <section class="selected" aria-labelledby="sel-h">
        <div class="sec-head container container--wide">
          <h2 id="sel-h" class="display display-2 sec-title">
            <span class="stretch">{t.home.selected.split(' ')[0]}</span>
            <span class="stretch">{t.home.selected.split(' ').slice(1).join(' ')}</span>
          </h2>
          <a class="btn btn--small" href="/galerien/">
            {t.home.allGalleries} ({galleries.length}) <span class="arrow" aria-hidden="true">→</span>
          </a>
        </div>
        <Showcase items={stageItems} />
      </section>
    )
  }

  <!-- Film: blauer Raum -->
  {
    films.length > 0 && (
      <section class="film-room room c-blue" aria-labelledby="film-h">
        <div class="container container--wide section">
          <div class="sec-head">
            <h2 id="film-h" class="display display-2" set:html={inlineMd('Auch in *Bewegung*')} />
            <a class="btn btn--small" href="/film/">
              {t.home.filmMore} <span class="arrow" aria-hidden="true">→</span>
            </a>
          </div>
          <ul class="film-list" role="list">
            {films.slice(0, 3).map((f) => (
              <li class="rise">
                <a href={`/film/#${f.id}`} class="film-row">
                  <span class="display display-3">{f.data.title}</span>
                  <span class="label">{f.data.roles.join(' & ')}</span>
                  <span class="label">
                    {f.data.format} · {f.data.year}
                  </span>
                  <span class="arrow" aria-hidden="true">
                    →
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  <!-- Über mich -->
  <section class="about container container--wide section" aria-labelledby="about-h">
    <ParallaxImage class="about-img hang" src={portrait} alt="Porträt von Jesko Dorner" sizes="(min-width: 900px) 40vw, 100vw" ratio="4 / 5" />
    <div class="about-text rise">
      <h2 id="about-h" class="pill c-pink">{t.home.aboutTeaser}</h2>
      {text.aboutTeaser && <p class="about-lead" set:html={inlineMd(text.aboutTeaser)} />}
      <a class="btn" href="/ueber-mich/">{t.home.aboutMore} <span class="arrow" aria-hidden="true">→</span></a>
    </div>
  </section>

  <!-- Kontakt: Lime-Raum -->
  <section class="cta room c-lime" aria-labelledby="cta-h">
    <div class="container container--wide">
      <h2 id="cta-h" class="display cta-title">
        <span class="stretch">Lass uns</span>
        <span class="stretch">reden!</span>
      </h2>
      <div class="cta-row">
        <p class="lead">{t.home.contactText}</p>
        <div class="cta-actions">
          <EmailLink class="btn btn--solid" text="E-Mail schreiben" />
          <a class="btn" href={site.instagram.url} rel="me noopener" target="_blank">
            <Icon name="instagram" /> @{site.instagram.handle}
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* ---------- Hero ---------- */
  .hero {
    position: relative;
    display: grid;
    gap: clamp(1.25rem, 3vw, 2rem);
    padding-top: clamp(1.5rem, 4vw, 3.5rem);
    padding-bottom: clamp(2rem, 5vw, 4rem);
  }
  .hero-kicker {
    color: var(--ink-soft);
  }
  .hero-title {
    display: flex;
    flex-direction: column;
    font-size: clamp(4.6rem, 0.6rem + 20vw, 25rem);
    line-height: 0.8;
    margin-left: -0.03em;
    position: relative;
    z-index: 1;
  }
  .ht {
    white-space: nowrap;
    font-stretch: 58%;
  }
  .ht-2 {
    color: var(--pink);
  }
  .hero-art {
    position: relative;
    z-index: 2;
  }
  .hero-frame {
    rotate: 2deg;
    transition: rotate 0.5s var(--pop);
  }
  .hero-frame:hover {
    rotate: 0deg;
  }
  .hero-frame .slide {
    position: absolute;
    inset: 0;
  }
  .hero-frame .slide :global(picture),
  .hero-frame .slide :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .is-slideshow .slide:not(:first-child) {
    opacity: 0;
  }
  @media (prefers-reduced-motion: no-preference) {
    .is-slideshow .slide {
      animation: hero-fade var(--dur) linear infinite both;
      animation-delay: calc(var(--i) * var(--dur) / var(--n) - 1.5s);
    }
    .ht,
    .hero-art,
    .hero-bottom {
      animation: hero-in 0.9s var(--ease) both;
    }
    .ht-2 {
      animation-delay: 0.08s;
    }
    .hero-art {
      animation-delay: 0.18s;
    }
    .hero-bottom {
      animation-delay: 0.3s;
    }
  }
  @keyframes hero-in {
    from {
      opacity: 0;
      translate: 0 2rem;
    }
  }

  .sticker {
    position: absolute;
    width: clamp(6.5rem, 4rem + 9vw, 12rem);
    aspect-ratio: 1;
    top: calc(clamp(6.5rem, 4rem + 9vw, 12rem) * -0.45);
    left: calc(clamp(6.5rem, 4rem + 9vw, 12rem) * -0.3);
    z-index: 3;
    filter: drop-shadow(0 8px 18px rgb(0 0 0 / 0.22));
  }
  .sticker circle {
    fill: var(--pink);
  }
  .sticker-text {
    font-family: var(--font-display);
    font-weight: 900;
    font-stretch: 80%;
    font-size: 19px;
    fill: var(--ink);
  }
  .sticker-mid {
    font-family: var(--font-display);
    font-weight: 900;
    font-stretch: 60%;
    font-size: 52px;
    fill: var(--ink);
  }

  /* Mobil: Foto unter dem Namen, Sticker rechts oben am Foto */
  @media (max-width: 899px) {
    .hero-art {
      margin-top: 1.75rem;
    }
    .sticker {
      left: auto;
      right: -0.4rem;
      top: calc(clamp(6.5rem, 4rem + 9vw, 12rem) * -0.55);
    }
  }
  .hero-placard {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-top: 1.1rem;
    font-size: var(--fs-sm);
  }

  .hero-bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.25rem 2rem;
  }
  .hero-claim {
    font-size: clamp(1.35rem, 1rem + 1.4vw, 2.4rem);
    font-weight: 600;
    line-height: 1.12;
    letter-spacing: -0.015em;
    max-width: 20ch;
  }
  .hero-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  @media (min-width: 900px) {
    .hero {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      grid-template-rows: auto auto auto;
      min-height: calc(100svh - var(--header-h));
      align-content: center;
      column-gap: var(--gap);
    }
    .hero-kicker {
      grid-column: 1 / -1;
      grid-row: 1;
    }
    .hero-title {
      grid-column: 1 / -1;
      grid-row: 2;
      align-self: center;
    }
    .hero-art {
      grid-column: 8 / -1;
      grid-row: 2 / 4;
      align-self: end;
      margin-bottom: clamp(-4rem, -3vw, -1rem);
    }
    .hero-bottom {
      grid-column: 1 / 7;
      grid-row: 3;
      align-self: end;
    }
  }

  /* Name zieht sich beim Scrollen in die Breite, das Bild hebt schneller ab */
  @supports (animation-timeline: scroll()) {
    @media (prefers-reduced-motion: no-preference) {
      .ht {
        animation-name: hero-in, ht-stretch;
        animation-duration: 0.9s, auto;
        animation-timing-function: var(--ease), linear;
        animation-fill-mode: both, both;
        animation-timeline: auto, scroll(root);
        animation-range: normal, 0 70svh;
      }
      .hero-art {
        animation-name: hero-in, art-lift;
        animation-duration: 0.9s, auto;
        animation-timing-function: var(--ease), linear;
        animation-fill-mode: both, both;
        animation-timeline: auto, scroll(root);
        animation-range: normal, 0 100svh;
      }
    }
  }
  @keyframes ht-stretch {
    to {
      font-stretch: 100%;
    }
  }
  @keyframes art-lift {
    to {
      transform: translate3d(0, -14vh, 0) rotate(-4deg);
    }
  }

  /* ---------- Statement ---------- */
  .statement .words {
    max-width: 16ch;
  }
  .statement-note {
    margin-top: clamp(1.5rem, 3vw, 2.5rem);
    max-width: 44ch;
    margin-left: auto;
  }

  /* ---------- Abschnittsköpfe ---------- */
  .sec-head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem 2rem;
    margin-bottom: clamp(3rem, 8vw, 7rem);
  }
  .sec-title {
    display: flex;
    flex-direction: column;
    --stretch-from: 50%;
    --stretch-to: 84%;
  }
  .selected {
    padding-top: var(--section);
  }

  /* ---------- Film-Raum ---------- */
  .film-room {
    margin-top: var(--section);
  }
  .film-room .sec-head :global(.btn) {
    border-color: var(--wall);
  }
  .film-list {
    list-style: none;
    padding: 0;
    border-top: 2.5px solid currentColor;
  }
  .film-row {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 0.4rem 1.5rem;
    align-items: baseline;
    padding-block: clamp(1rem, 2.5vw, 1.75rem);
    border-bottom: 2.5px solid currentColor;
    text-decoration: none;
    transition: padding 0.35s var(--pop);
  }
  .film-row .arrow {
    font-size: 1.6rem;
    grid-row: 1;
    grid-column: 2;
  }
  @media (min-width: 760px) {
    .film-row {
      grid-template-columns: 1.4fr 0.8fr 0.8fr auto;
    }
    .film-row .arrow {
      grid-row: auto;
      grid-column: auto;
    }
  }
  .film-row:hover {
    padding-left: 1rem;
    color: var(--lime);
  }

  /* ---------- Über mich ---------- */
  .about {
    display: grid;
    gap: clamp(2rem, 5vw, 5rem);
    align-items: center;
  }
  @media (min-width: 900px) {
    .about {
      grid-template-columns: 5fr 7fr;
    }
  }
  .about :global(.about-img) {
    width: 100%;
    max-width: 34rem;
    rotate: -2deg;
  }
  .about-text {
    display: grid;
    gap: 1.5rem;
    justify-items: start;
  }
  .about-lead {
    font-size: clamp(1.6rem, 1.1rem + 2vw, 3.2rem);
    font-weight: 650;
    line-height: 1.08;
    letter-spacing: -0.02em;
    max-width: 22ch;
  }

  /* ---------- Kontakt-Raum ---------- */
  .cta {
    padding-block: clamp(4rem, 9vw, 9rem);
    overflow: hidden;
  }
  .cta-title {
    display: flex;
    flex-direction: column;
    font-size: clamp(4rem, 0.6rem + 15vw, 19rem);
    line-height: 0.8;
    --stretch-from: 50%;
    --stretch-to: 96%;
  }
  .cta-row {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-end;
    gap: 1.5rem 3rem;
    margin-top: clamp(1.5rem, 4vw, 3rem);
  }
  .cta-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
</style>
