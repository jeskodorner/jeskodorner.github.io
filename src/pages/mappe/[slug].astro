---
/**
 * Mappe: eine ruhige Übersicht zu einem Album aus dem Portfolio – „← Zurück“, Titel, Monat, eine Auswahl der Fotos
 * in gleich hohen, randvollen Reihen wie auf der Galerie-Seite (jedes Foto im Originalformat),
 * fast kein Text, unten „Ganzes Album ansehen →“. Erreichbar über „Mappe ansehen →“ auf der Startseite und über die
 * Fotos im Portfolio.
 * Welche Fotos: src/lib/mappe.ts (Liste `mappe:` im Album oder automatisch bis zu 8). Ein Klick auf ein Foto öffnet
 * die Großansicht direkt hier – nur mit den Fotos der Mappe und eigener Zählung („2 von 4“).
 * Mappe und Album sind zwei getrennte Orte (Jesko, 22.11.2026): Die einzige Verbindung ist „Ganzes Album ansehen“
 * unten. Vorher blätterte die Großansicht durchs ganze Album, und ohne JavaScript führte ein Foto ins Album – jetzt
 * öffnet es dann nur das große Bild.
 * Gibt es einen eigenen Film zum Album (Feld `galerie` in src/content/films/…, z. B. Dollgow), läuft er über den
 * Fotos groß in Schleife (seit 22.11.2026).
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Picture from '../../components/Picture.astro';
import JustifyNow from '../../components/JustifyNow.astro';
import Icon from '../../components/Icon.astro';
import LoopVideo from '../../components/LoopVideo.astro';
import { filmForGallery } from '../../lib/films';
import { getMappen, mappeImages } from '../../lib/mappe';
import type { Gallery, GalleryImage } from '../../lib/galleries';
import { photoData } from '../../lib/lightbox-data';
import { cardImage } from '../../lib/og';
import { tidyTitle } from '../../lib/text';
import { cardSizes } from '../../lib/sizes';
import { useTranslations, formatMonth } from '../../i18n';

export async function getStaticPaths() {
  const mappen = await getMappen();
  return mappen.map(({ gallery, lead }) => ({ params: { slug: gallery.slug }, props: { gallery, lead } }));
}

interface Props {
  gallery: Gallery;
  lead: GalleryImage;
}

const { gallery: g, lead } = Astro.props;
const t = useTranslations();
const images = mappeImages(g, lead);
// Unter dem Titel nur das Datum, wie auf der Albumseite (bis 20.11.2026 auch der Ort)
const meta = formatMonth(g.date);
// Lightbox-Daten nur der Fotos dieser Mappe (unsichtbar), in ihrer Reihenfolge und eigener Zählung
const items = await Promise.all(images.map((img) => photoData(g, img)));
const og = cardImage(`album/${g.slug}`, g.cover.alt);
// Gibt es einen eigenen Film zum Album (Feld `galerie` im Film), läuft er oben groß in Schleife, darunter die Fotos
const film = await filmForGallery(g);
---

<BaseLayout title={g.title} description={g.description} image={og}>
  <section class="container container--wide head">
    {/* Zurück dorthin, wo man herkam (Startseite oder Portfolio); ohne Vorgeschichte zur Startseite */}
    <a class="back btn btn--small" href="/" data-back>
      <Icon name="arrow-left" /> {t.back}
    </a>
    <h1 class="display display-1 display-compact">{tidyTitle(g.title)}</h1>
    <p class="label muted">{meta}</p>
  </section>

  {
    film?.data.video && film.data.still && (
      <div class="container container--wide film-top">
        <LoopVideo
          file={film.data.video}
          poster={film.data.still}
          alt={`Film „${film.data.title}“, ohne Ton, läuft in Schleife`}
          class="mappe-video"
          pausable={false}
        />
      </div>
    )
  }

  {/* Fotos in gleich hohen, randvollen Reihen wie auf der Galerie-Seite (seit 22.11.2026; vorher gleich große Felder
      mit Abzügen und Schatten) – verteilt von justify-layout.js, schon beim Aufbau der Seite (JustifyNow) */}
  <div class="container container--wide">
    <ol class:list={['mappe', { 'mappe--few': images.length <= 3 }]} role="list" data-justify>
      {
        images.map((img, i) => {
          const r = img.src.width / img.src.height;
          return (
            <li class="sheet" style={`--r:${r.toFixed(4)}`}>
              <a class="sheet-link reveal" href={items[i]!.set.largest.url} data-open-album={g.slug} data-photo={i + 1}>
                <Picture
                  src={img.src}
                  alt={img.alt}
                  sizes={cardSizes(r)}
                  color={img.color}
                  lqip={img.lqip}
                  loading={i < 4 ? 'eager' : 'lazy'}
                  fetchpriority={i === 0 ? 'high' : undefined}
                  maxWidth={1200}
                  class="sheet-img"
                />
              </a>
            </li>
          );
        })
      }
    </ol>
    <JustifyNow />
  </div>

  <ul class="album-src" hidden data-album-src={g.slug} data-count={images.length} data-title={g.title}>
    {
      items.map((it) => (
        <li>
          <a class="ph" href={it.set.largest.url} {...it.attrs}>
            {g.title}
          </a>
        </li>
      ))
    }
  </ul>

  {/* Ende der Mappe: der Weg ins ganze Album */}
  <div class="container container--wide end">
    <a class="btn btn--solid" href={g.url}>
      {t.mappe.toAlbum} <Icon name="arrow-right" class="arrow" />
    </a>
  </div>
</BaseLayout>

<script>
  import { initAlbumLinks } from '../../scripts/open-album';
  import { initBackLinks } from '../../scripts/back-link';
  import { initJustify } from '../../scripts/justify';
  initAlbumLinks();
  // „Zurück“: kam man von dieser Website (Startseite, Portfolio), geht es genau dorthin zurück – samt Stelle auf der Seite
  initBackLinks();
  // Reihen neu verteilen, wenn sich die Breite ändert (Fenster, Drehen des Handys)
  initJustify();
</script>

<style>
  /* Kopf kompakt wie auf der Albumseite: Fotos sollen beim Öffnen sofort zu sehen sein (vorher Titel in voller
     Größe und der übliche große Abstand oben, am Laptop sah man fast nur die Überschrift) */
  .head {
    padding-top: clamp(1rem, 2.5vw, 2rem);
    padding-bottom: clamp(1.25rem, 2.5vw, 2rem);
  }
  .back {
    margin-bottom: clamp(1rem, 2.5vw, 1.75rem);
  }
  .head > .label {
    margin-top: 0.5rem;
  }
  /* Film zum Album (z. B. Dollgow): oben über die volle Breite, genau so breit wie die Fotoreihen darunter (seit
     22.11.2026 – vorher nie höher als der Bildschirm und dadurch schmaler als die Reihen). Ohne Knopf zum Anhalten,
     es läuft einfach wie ein GIF. Abstand zu den Fotos wie zwischen zwei Fotoreihen. */
  .film-top {
    padding-bottom: var(--mappe-gap);
  }
  .film-top :global(.mappe-video) {
    width: 100%;
  }
  /* Fotos wie auf der Galerie-Seite: gleich hohe Reihen, die die Breite füllen, jedes Foto im Originalformat, ohne
     Schatten. Reihenhöhe und schmalstes Foto wie dort (--row, --min-w); zwischen den Fotos überall derselbe schmale
     Abstand (dort ist er nach unten größer, weil Titel unter den Fotos stehen). Ohne JavaScript verteilt CSS
     (flex-grow), dann ist nur die letzte Reihe nicht gestreckt. Bis 22.11.2026: gleich große Felder in Spalten, jedes
     Foto als Abzug mit Schatten darin. */
  .container {
    --mappe-gap: clamp(0.45rem, 0.8vw, 0.8rem);
  }
  .mappe {
    --row: clamp(118px, 45px + 19vw, 340px);
    --min-w: clamp(150px, 40vw, 200px);
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--mappe-gap);
  }
  /* Nur zwei oder drei Fotos (z. B. Spanien): am Handy größer – höhere Zielreihe, so steht ein Querformat allein in
     voller Breite (seit 22.11.2026, Jeskos Wunsch) */
  @media (max-width: 699.98px) {
    .mappe--few {
      --row: 60vw;
    }
  }
  .mappe::after {
    content: '';
    flex-grow: 1000000;
  }
  .sheet {
    flex-grow: calc(var(--r) * 100);
    flex-basis: calc(var(--r) * var(--row));
    min-width: 0;
  }
  .sheet-link {
    display: block;
    overflow: hidden;
    background: var(--wall-3);
    cursor: zoom-in;
    outline-offset: 4px;
  }
  .sheet-link :global(.sheet-img) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: var(--r);
    transition: transform 0.9s var(--ease);
  }
  @media (hover: hover) {
    .sheet-link:hover :global(.sheet-img) {
      transform: scale(var(--hover-zoom));
    }
  }
  /* Ende: Knopf unter dem letzten Foto (Laptop linksbündig, Handy in voller Breite). Bis 20.11.2026 stand darunter,
     wie viele Bilder das Album hat. */
  .end {
    display: grid;
    justify-items: start;
    gap: 0.9rem;
    padding-top: clamp(2.5rem, 5vw, 4.5rem);
  }
  @media (max-width: 899.98px) {
    .end {
      justify-items: center;
      text-align: center;
    }
  }
  /* Handy: Knopf in voller Breite wie am Ende von Portfolio und Über mich (Klasse btn-row) */
  @media (max-width: 599.98px) {
    .end {
      justify-items: stretch;
    }
  }
</style>
