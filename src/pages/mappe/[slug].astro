---
/**
 * Mappe: eine ruhige Übersicht zu einem Album aus dem Portfolio, wie eine aufgeschlagene Fotomappe – „← Zurück“,
 * Titel, Monat, eine Auswahl der Fotos als Abzüge nebeneinander (jedes ganz, mit Schatten, in gleich großen Feldern),
 * fast kein Text, unten „Ganzes Album ansehen →“. Erreichbar über „Mappe ansehen →“ auf der Startseite und über die
 * Fotos im Portfolio.
 * Welche Fotos: src/lib/mappe.ts (Liste `mappe:` im Album oder automatisch bis zu 8). Ein Klick auf ein Foto öffnet
 * die Lightbox mit dem ganzen Album ab diesem Foto, direkt hier (wie im Portfolio).
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Picture from '../../components/Picture.astro';
import Icon from '../../components/Icon.astro';
import { getMappen, mappeImages } from '../../lib/mappe';
import type { Gallery, GalleryImage } from '../../lib/galleries';
import { photoData } from '../../lib/lightbox-data';
import { cardImage } from '../../lib/og';
import { tidyTitle } from '../../lib/text';
import { useTranslations, formatMonth } from '../../i18n';

export async function getStaticPaths() {
  const mappen = await getMappen();
  return mappen.map(({ gallery, lead }) => ({ params: { slug: gallery.slug }, props: { gallery, lead } }));
}

interface Props {
  gallery: Gallery;
  lead: GalleryImage;
}

const { gallery: g, lead } = Astro.props;
const t = useTranslations();
const images = mappeImages(g, lead);
const meta = [formatMonth(g.date), g.location].filter(Boolean).join(' · ');
// Lightbox-Daten des ganzen Albums (unsichtbar): ein Klick auf ein Foto blättert durchs ganze Album
const items = await Promise.all(g.images.map((img) => photoData(g, img)));
const og = cardImage(`album/${g.slug}`, g.cover.alt);
---

<BaseLayout title={g.title} description={g.description} image={og}>
  <section class="container container--wide head">
    {/* Zurück dorthin, wo man herkam (Startseite oder Portfolio); ohne Vorgeschichte zur Startseite */}
    <a class="back btn btn--small" href="/" data-back>
      <Icon name="arrow-left" /> {t.mappe.back}
    </a>
    <h1 class="display display-1">{tidyTitle(g.title)}</h1>
    <p class="label muted">{meta}</p>
  </section>

  <ol class="container container--wide mappe" role="list">
    {
      images.map((img, i) => {
        const r = img.src.width / img.src.height;
        return (
          <li class="sheet" style={`--r:${r.toFixed(4)}`}>
            <a class="sheet-link reveal" href={img.hashUrl} data-open-album={g.slug} data-photo={img.index}>
              <Picture
                src={img.src}
                alt={img.alt}
                sizes="(min-width: 1000px) 21vw, (min-width: 600px) 28vw, 42vw"
                color={img.color}
                lqip={img.lqip}
                loading={i < 4 ? 'eager' : 'lazy'}
                fetchpriority={i === 0 ? 'high' : undefined}
                class="sheet-img"
              />
            </a>
          </li>
        );
      })
    }
  </ol>

  <ul class="album-src" hidden data-album-src={g.slug} data-count={g.images.length} data-title={g.title}>
    {
      items.map((it) => (
        <li>
          <a class="ph" href={it.set.largest.url} {...it.attrs}>
            {g.title}
          </a>
        </li>
      ))
    }
  </ul>

  {/* Ende der Mappe: der Weg ins ganze Album */}
  <div class="container container--wide end">
    <a class="btn btn--solid" href={g.url}>
      {t.mappe.toAlbum} <Icon name="arrow-right" class="arrow" />
    </a>
    <p class="label muted">{t.mappe.inAlbum(g.images.length)}</p>
  </div>
</BaseLayout>

<script>
  import { initAlbumLinks } from '../../scripts/open-album';
  initAlbumLinks();
  // „Zurück“: kam man von dieser Website (Startseite, Portfolio), geht es genau dorthin zurück – samt Stelle auf der Seite
  for (const a of document.querySelectorAll<HTMLAnchorElement>('[data-back]')) {
    a.addEventListener('click', (e) => {
      const ref = document.referrer ? new URL(document.referrer) : null;
      if (ref && ref.origin === location.origin && ref.pathname !== location.pathname && history.length > 1) {
        e.preventDefault();
        history.back();
      }
    });
  }
</script>

<style>
  .head {
    padding-bottom: clamp(2.5rem, 6vw, 5rem);
  }
  .back {
    margin-bottom: clamp(1.25rem, 3vw, 2rem);
  }
  /* Übersicht wie eine aufgeschlagene Mappe: gleich große Felder (5:4) in Reihen – Laptop 4, Tablet 3, Handy 2.
     In jedem Feld liegt ein Abzug ganz (unbeschnitten), so groß wie das Feld es zulässt, mittig, mit Schatten.
     Viel Luft zwischen den Abzügen. */
  .mappe {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(2.5rem, 5vw, 4.5rem) clamp(1.75rem, 4vw, 3.5rem);
    margin: 0 auto;
    padding-block: 0;
  }
  @media (max-width: 999.98px) {
    .mappe {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  @media (max-width: 599.98px) {
    .mappe {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 2rem 1.25rem;
    }
  }
  .sheet {
    aspect-ratio: 5 / 4;
    container-type: size;
    display: grid;
    place-items: center;
  }
  .sheet-link {
    display: block;
    /* Querformat füllt die Breite, Hochformat die Höhe des Felds */
    width: min(100cqw, 100cqh * var(--r));
    overflow: hidden;
    box-shadow: var(--hang-shadow);
    cursor: zoom-in;
    outline-offset: 4px;
  }
  .sheet-link :global(.sheet-img) {
    display: block;
    width: 100%;
    height: auto;
    transition: transform 0.9s var(--ease);
  }
  @media (hover: hover) {
    .sheet-link:hover :global(.sheet-img) {
      transform: scale(var(--hover-zoom));
    }
  }
  /* Ende: Knopf unter dem letzten Foto (Laptop linksbündig, Handy mittig), darunter wie viele Bilder das Album hat */
  .end {
    display: grid;
    justify-items: start;
    gap: 0.9rem;
    padding-top: var(--section);
  }
  @media (max-width: 899.98px) {
    .end {
      justify-items: center;
      text-align: center;
    }
  }
  /* Handy: Knopf in voller Breite wie am Ende von Portfolio und Über mich (Klasse btn-row) */
  @media (max-width: 599.98px) {
    .end {
      justify-items: stretch;
    }
  }
</style>
