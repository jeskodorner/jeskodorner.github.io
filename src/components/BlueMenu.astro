---
/**
 * Das blaue Menü: oben groß der Name, darunter die Menüpunkte (etwas kleiner), unten Instagram,
 * Impressum und Datenschutz. Zwei Einsätze:
 *   - als Startseite (pages/index.astro): der Name ist die Hauptüberschrift
 *   - als Menü (Header.astro, auf allen Geräten): mit Schließen-Knopf genau dort, wo der Menüknopf sitzt,
 *     der Name führt zur Startseite
 * Handy (unter 700 px): alles mittig. Ab 700 px: alles linksbündig.
 * Slot „aside“ (Startseite: Bildfeld, BlendLoop.astro): am Handy groß und mittig im freien Platz unter dem Menü,
 * ab 700 px rechts neben den Menüpunkten, ab der Bildschirmmitte, mittig zur Höhe des Menüs.
 * Übergang: Name, Menüpunkte und Fußzeile tragen feste view-transition-Namen. Beim Wechsel Menü → Startseite
 * gleiten sie an ihren neuen Platz; von der Startseite auf eine Unterseite gleitet der Name ins Logo oben links.
 */
import { site } from '../config/site';
import { useTranslations } from '../i18n';
import { navLinks, isCurrent } from '../lib/nav';
import Icon from './Icon.astro';

export interface Props {
  /** true = Menü (mit Schließen-Knopf), false = Startseite */
  overlay?: boolean;
}

const { overlay = false } = Astro.props;
const t = useTranslations();
const links = await navLinks();
const path = Astro.url.pathname;
const hasAside = Astro.slots.has('aside');
---

<div class:list={['bm', 'container', { 'bm--overlay': overlay }]}>
  {
    overlay && (
      <div class="bm-top">
        <button class="bm-close" type="button" popovertarget="site-menu" popovertargetaction="hide" aria-label={t.nav.close}>
          <Icon name="close" size={30} />
        </button>
      </div>
    )
  }
  {
    overlay ? (
      <a class="bm-name display" href="/">
        {site.name}
      </a>
    ) : (
      <h1 class="bm-name display">{site.name}</h1>
    )
  }
  <div class="bm-body">
    <nav aria-label={t.nav.label}>
      <ul class="bm-list" role="list">
      {
        links.map((l) => (
          <li>
            <a class="display" href={l.href} aria-current={isCurrent(path, l.match) ? 'page' : undefined}>
              {l.label}
            </a>
          </li>
        ))
      }
      </ul>
    </nav>
    {
      hasAside && (
        <div class="bm-aside">
          <slot name="aside" />
        </div>
      )
    }
  </div>
  <p class="bm-foot label">
    <a href={site.instagram.url} rel="me noopener" target="_blank">@{site.instagram.handle}</a>
    <a href="/impressum/">{t.footer.imprint}</a>
    <a href="/datenschutz/">{t.footer.privacy}</a>
  </p>
</div>

<style>
  /* Blaue Fläche über den ganzen Bildschirm; Inhalt von oben nach unten: Name, Menü, Fußzeile */
  .bm {
    container-type: inline-size;
    display: flex;
    flex-direction: column;
    min-height: 100%;
    padding-block: clamp(1.25rem, 4vw, 2.5rem) max(1.5rem, env(safe-area-inset-bottom));
    color: var(--on-blue);
  }
  /* Im Menü: oben eine Leiste so hoch wie der Header, der Schließen-Knopf sitzt an der Stelle des Menüknopfs */
  .bm--overlay {
    padding-top: 0;
  }
  .bm-top {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    height: var(--header-h);
    margin-bottom: clamp(0.25rem, 2vw, 1rem);
  }
  .bm-close {
    display: inline-grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border: 0;
    border-radius: 50%;
    background: var(--wall);
    color: var(--ink);
    cursor: pointer;
  }
  /* Name: eine Zeile, so breit wie der Platz (aber nicht riesig) */
  .bm-name {
    view-transition-name: jd-name;
    display: block;
    font-size: min(11rem, 100cqi / 5.4);
    line-height: 0.9;
    padding-top: 0.08em;
    white-space: nowrap;
    text-decoration: none;
    color: inherit;
  }
  /* Menüpunkte: deutlich kleiner als der Name, mit Luft dazwischen */
  /* Menüpunkte, dazu optional das Bildfeld (Slot „aside“). Handy: Bildfeld mittig im freien Platz darunter. */
  .bm-body {
    flex: 1;
    display: flex;
    flex-direction: column;
    margin-top: clamp(2.5rem, 9vh, 6rem);
  }
  .bm-aside {
    --blend-w: min(60vw, 17rem, 40vh);
    flex: 1;
    display: grid;
    place-items: center;
    padding-top: 2rem;
  }
  /* Handy: alles mittig (Name, Menüpunkte, Fußzeile) – auf der Startseite und im Menü gleich */
  @media (max-width: 699.98px) {
    .bm {
      text-align: center;
    }
    .bm-list {
      justify-items: center;
    }
    .bm-foot {
      justify-content: center;
    }
  }
  /* Ab 700 px: zwei Spalten, Bildfeld in der rechten, mittig zur Höhe des Menüs */
  @media (min-width: 700px) {
    .bm-body {
      flex: none;
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      align-items: start;
      column-gap: var(--gutter);
    }
    .bm-aside {
      --blend-w: min(30vw, 36rem, 60vh);
      align-self: center;
      place-items: center start;
      padding-top: 0;
    }
  }
  .bm-list {
    view-transition-name: jd-menu;
    list-style: none;
    padding: 0;
    display: grid;
    gap: clamp(0.35rem, 1.2vh, 0.9rem);
  }
  .bm-list a {
    font-size: clamp(2.3rem, 10.5vw, 4.75rem);
    line-height: 0.95;
    text-decoration: none;
    color: inherit;
  }
  .bm-list a:hover,
  .bm-list a[aria-current='page'] {
    color: var(--lime);
  }
  .bm-foot {
    view-transition-name: jd-menu-foot;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    margin-top: auto;
    padding-top: 2.5rem;
  }
  .bm-foot a {
    color: inherit;
  }
  .bm-foot a:hover {
    color: var(--lime);
  }
  .bm a:focus-visible,
  .bm-close:focus-visible {
    outline: 3px solid var(--lime);
    outline-offset: 4px;
  }
</style>
