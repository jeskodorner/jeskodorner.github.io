---
/**
 * Das blaue Menü: oben groß der Name, darunter die Menüpunkte (etwas kleiner), unten Instagram,
 * Impressum und Datenschutz. Zwei Einsätze:
 *   - als Startseite (pages/index.astro): der Name ist die Hauptüberschrift
 *   - als Menü (Header.astro, auf allen Geräten): mit Schließen-Knopf genau dort, wo der Menüknopf sitzt,
 *     der Name führt zur Startseite
 * Handy (unter 700 px): der Name steht mittig, die Menüpunkte linksbündig an seiner linken Kante, die Fußzeile mittig.
 * Ab 700 px: alles linksbündig.
 * Slot „aside“ (Startseite: Bildfeld, BlendLoop.astro): am Handy randlos über die ganze Breite, beginnt hinter
 * „Kontakt“ (4:3, auf niedrigen Bildschirmen etwas flacher, aber immer randlos). Dort ist „Kontakt“ ein Fenster:
 * oben weiß, auf dem Foto zeigen die Buchstaben das Foto in seinen echten (positiven) Farben,
 * ab 700 px rechts neben den Menüpunkten: oben und unten bündig mit der Schrift, rechtsbündig am Seitenrand (gleicher
 * Abstand zum Bildschirmrand wie der Name links), damit die Seite nicht nach links kippt.
 * Der Name ist rosa hinterlegt mit schwarzer Schrift (wie markierter Text) – das einzige große Rosa auf der Seite.
 * Übergang: Name, Menüpunkte und Fußzeile tragen feste view-transition-Namen. Beim Wechsel Menü → Startseite
 * gleiten sie an ihren neuen Platz; von der Startseite auf eine Unterseite gleitet der Name ins Logo oben links.
 */
import { site } from '../config/site';
import { useTranslations } from '../i18n';
import { navLinks, isCurrent } from '../lib/nav';
import Icon from './Icon.astro';

export interface Props {
  /** true = Menü (mit Schließen-Knopf), false = Startseite */
  overlay?: boolean;
}

const { overlay = false } = Astro.props;
const t = useTranslations();
const links = await navLinks();
const path = Astro.url.pathname;
const hasAside = Astro.slots.has('aside');
---

<div class:list={['bm', 'container', { 'bm--overlay': overlay, 'bm--aside': hasAside }]}>
  {
    overlay && (
      <div class="bm-top">
        <button class="bm-close" type="button" popovertarget="site-menu" popovertargetaction="hide" aria-label={t.nav.close}>
          <Icon name="close" size={30} />
        </button>
      </div>
    )
  }
  {
    overlay ? (
      <a class="bm-name display" href="/">
        {site.name}
      </a>
    ) : (
      <h1 class="bm-name display">{site.name}</h1>
    )
  }
  <div class="bm-body">
    <nav aria-label={t.nav.label}>
      <ul class="bm-list" role="list">
      {
        links.map((l) => (
          <li>
            <a class="display" href={l.href} aria-current={isCurrent(path, l.match) ? 'page' : undefined}>
              {l.label}
            </a>
          </li>
        ))
      }
      </ul>
    </nav>
    {
      hasAside && (
        <div class="bm-aside">
          <slot name="aside" />
        </div>
      )
    }
  </div>
  <p class="bm-foot label">
    <a href={site.instagram.url} rel="me noopener" target="_blank">@{site.instagram.handle}</a>
    <a href="/impressum/">{t.footer.imprint}</a>
    <a href="/datenschutz/">{t.footer.privacy}</a>
  </p>
</div>

<script>
  /* Startseite am Handy: „Kontakt“ als Fenster ins Foto. Die untere Hälfte des Worts ist durchsichtig; genau
     darunter liegt im Bildfeld eine Kopie des Worts, die die Farben umkehrt (Modus „Differenz“ mit Weiß). Da das
     Foto invertiert ist, zeigen die Buchstaben es so wieder positiv. Die Kopie muss im Bildfeld liegen, weil sich
     das Menü wegen der Seitenübergänge nicht mit dem Foto mischen kann. Ohne JavaScript bleibt „Kontakt“ zweifarbig. */
  function initWindow(bm: HTMLElement) {
    const link = bm.querySelector<HTMLElement>('.bm-list li:last-child a');
    const box = bm.querySelector<HTMLElement>('.bm-aside [data-blend]');
    if (!link || !box) return;
    const word = document.createElement('span');
    word.className = 'bm-window display';
    word.textContent = link.textContent?.trim() ?? '';
    box.append(word);
    // deckungsgleich über das echte Wort legen (auch nach Drehen, Größenänderung, Laden der Schrift)
    const place = () => {
      const a = link.getBoundingClientRect();
      const b = box.getBoundingClientRect();
      word.style.translate = `${a.left - b.left}px ${a.top - b.top}px`;
    };
    place();
    new ResizeObserver(place).observe(bm);
    document.fonts?.ready.then(place);
    bm.classList.add('has-window');
  }
  for (const bm of document.querySelectorAll<HTMLElement>('.bm--aside')) initWindow(bm);
</script>

<style>
  /* Blaue Fläche über den ganzen Bildschirm; Inhalt von oben nach unten: Name, Menü, Fußzeile */
  .bm {
    /* Schriftgröße der Menüpunkte */
    --bm-item: clamp(2.3rem, 10.5vw, 4.75rem);
    container-type: inline-size;
    display: flex;
    flex-direction: column;
    min-height: 100%;
    padding-block: clamp(1.25rem, 4vw, 2.5rem) max(1.5rem, env(safe-area-inset-bottom));
    color: var(--on-menu);
  }
  /* Im Menü: oben eine Leiste so hoch wie der Header, der Schließen-Knopf sitzt an der Stelle des Menüknopfs */
  .bm--overlay {
    padding-top: 0;
  }
  .bm-top {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    height: var(--header-h);
    margin-bottom: clamp(0.25rem, 2vw, 1rem);
  }
  .bm-close {
    display: inline-grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border: 0;
    border-radius: 50%;
    background: var(--wall);
    color: var(--ink);
    cursor: pointer;
  }
  /* Name: eine Zeile, so breit wie der Platz (aber nicht riesig). Rosa Fläche genau so breit wie die Schrift, schwarze
     Schrift – wie markierter Text. Die Fläche ist 0,98 Schrifthöhen hoch, oben 0,125 und unten 0,175 Rand um die
     Großbuchstaben. */
  .bm-name {
    view-transition-name: jd-name;
    display: block;
    width: fit-content;
    font-size: min(11rem, 100cqi / 5.4);
    line-height: 0.9;
    padding-top: 0.08em;
    white-space: nowrap;
    text-decoration: none;
    background: var(--pink);
    color: var(--ink);
  }
  /* Menüpunkte: deutlich kleiner als der Name, mit Luft dazwischen */
  /* Menüpunkte, dazu optional das Bildfeld (Slot „aside“). Handy: Bildfeld mittig im freien Platz darunter. */
  .bm-body {
    flex: 1;
    display: flex;
    flex-direction: column;
    margin-top: clamp(2.5rem, 9vh, 6rem);
  }
  .bm-aside {
    display: grid;
  }
  .bm-aside :global(.bm-window) {
    display: none;
  }
  /* Handy – auf der Startseite und im Menü gleich: Raster mit drei Spalten. Die mittlere ist genau so breit wie der
     Name, so steht er mittig und die Menüpunkte beginnen an seiner linken Kante. Die Reihe nach dem Menü füllt den
     restlichen Platz (Startseite: Bildfeld), die Fußzeile steht mittig ganz unten. */
  @media (max-width: 699.98px) {
    .bm {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
      grid-template-rows: auto auto 1fr auto;
    }
    .bm > * {
      grid-column: 1 / -1;
    }
    .bm .bm-name {
      grid-column: 2;
    }
    .bm-body {
      display: contents;
    }
    .bm-body > nav {
      grid-column: 2;
      margin-top: clamp(2.5rem, 9vh, 6rem);
      position: relative;
      z-index: 1; /* über dem Bildfeld */
    }
    .bm-aside {
      grid-column: 1 / -1;
      /* randlos über die ganze Breite und halb hinter „Kontakt“. Maße in Schrifthöhen der Menüpunkte (--bm-item):
         die Mitte der Buchstaben liegt 0,54 über dem Zeilenende. Das Foto beginnt 0,2 darüber und ist nach einem
         kurzen weichen Übergang (0,4) ab 0,2 darunter voll da. */
      margin-inline: calc(-1 * var(--gutter));
      margin-top: calc(-0.74 * var(--bm-item));
      padding-top: 0;
      place-items: start center;
      container-type: size;
      /* Immer über die ganze Breite. 4:3, nur wenn die Höhe dafür nicht reicht, etwas flacher (Fotos werden
         dann oben und unten etwas mehr beschnitten) – so scrollt die Startseite nicht */
      --blend-w: 100cqw;
      --blend-h: min(75cqw, 100cqh);
      /* oben und unten weich auslaufen (oben liegt „Kontakt“ im ausgeblendeten Bereich und bleibt lesbar) */
      --blend-mask: linear-gradient(
        to bottom,
        transparent 0,
        #000 calc(0.4 * var(--bm-item)),
        #000 75%,
        transparent 100%
      );
    }
    /* „Kontakt“ halb auf dem hellen Foto: oben weiß, wo das Foto beginnt in der Hintergrundfarbe – mit weichem
       Übergang passend zum Rand des Fotos (Mitte der Buchstaben: 0,41 unter der Zeilenoberkante) */
    .bm--aside .bm-list li:last-child a {
      color: transparent;
      background-image: linear-gradient(to bottom, var(--on-menu) 0.34em, var(--menu-bg) 0.5em);
      -webkit-background-clip: text;
      background-clip: text;
    }
    /* Mit JavaScript: unten durchsichtig, dort scheint die Kopie im Bildfeld durch (Foto positiv, siehe Skript) */
    .bm--aside.has-window .bm-list li:last-child a {
      background-image: linear-gradient(to bottom, var(--on-menu) 0.34em, transparent 0.5em);
    }
    .bm-aside :global(.bm-window) {
      display: block;
      position: absolute;
      top: 0;
      left: 0;
      z-index: 1;
      font-size: var(--bm-item);
      line-height: 0.95;
      padding-inline: 0.06em;
      white-space: nowrap;
      color: #fff;
      mix-blend-mode: difference;
      pointer-events: none;
    }
    .bm--aside .bm-list li:last-child a:hover {
      background-image: none;
      background-color: var(--pink);
      -webkit-background-clip: border-box;
      background-clip: border-box;
      color: var(--ink);
    }
    .bm-foot {
      justify-content: center;
      padding-top: 1.25rem;
    }
  }
  /* Ab 700 px: links die Menüpunkte (so breit wie der längste), rechts der Platz bis zum Seitenrand.
     Das Bildfeld reicht genau von der Oberkante der Buchstaben von „Portfolio“ bis zur Unterkante von „Kontakt“
     (gemessen: Buchstaben beginnen 0,07 und enden 0,2 Schrifthöhen innerhalb ihrer Zeile) und steht rechtsbündig
     am Seitenrand – so weit vom rechten Bildschirmrand wie der Name vom linken. Ist der Platz zu schmal, wird es
     kleiner und hält mindestens 3rem Abstand zum Menütext. */
  @media (min-width: 700px) {
    .bm-body {
      flex: none;
      display: grid;
      grid-template-columns: auto minmax(0, 1fr);
      column-gap: 0;
    }
    .bm-aside {
      padding-block: calc(0.07 * var(--bm-item)) calc(0.2 * var(--bm-item));
      container-type: size;
      place-items: center end;
      --blend-w: min(100cqw - 3rem, 133.33cqh);
    }
  }
  .bm-list {
    view-transition-name: jd-menu;
    list-style: none;
    padding: 0;
    display: grid;
    gap: clamp(0.35rem, 1.2vh, 0.9rem);
  }
  /* Menüpunkte als Blöcke: jede Zeile ist genau 0,95 Schrifthöhen hoch, so lässt sich das Bildfeld exakt an der
     Schrift ausrichten (Handy: Fotokante hinter „Kontakt“, Laptop: Ober-/Unterkante der Buchstaben) */
  .bm-list a {
    display: block;
    width: fit-content;
    font-size: var(--bm-item);
    line-height: 0.95;
    text-decoration: none;
    color: inherit;
  }
  /* Aktiver bzw. überfahrener Punkt: rosa Feld mit schwarzer Schrift (Rosa als Schriftfarbe wäre auf dem Blaugrau
     kaum lesbar). Das Feld steht links und rechts ein klein wenig über, die Schrift bleibt an ihrem Platz. */
  .bm-list a {
    padding-inline: 0.06em;
    margin-inline: -0.06em;
    transition:
      background-color 0.2s,
      color 0.2s;
  }
  .bm-list a:hover,
  .bm-list a[aria-current='page'] {
    background-color: var(--pink);
    color: var(--ink);
  }
  .bm-foot {
    view-transition-name: jd-menu-foot;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 0.6rem;
    margin-top: auto;
    padding-top: 2.5rem;
  }
  /* Kleine Links schlicht weiß, beim Überfahren rosa hinterlegt wie die Menüpunkte */
  .bm-foot a {
    color: inherit;
  }
  .bm-foot a:hover {
    background: var(--pink);
    color: var(--ink);
  }
  .bm a:focus-visible,
  .bm-close:focus-visible {
    outline: 3px solid var(--on-menu);
    outline-offset: 4px;
  }
</style>
