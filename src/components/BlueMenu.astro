---
/**
 * Das Menü (blau mit weißer Schrift, Farben in tokens.css): oben groß der Name, darunter die Menüpunkte (etwas kleiner), unten Instagram,
 * Impressum und Datenschutz. Zwei Einsätze:
 *   - als Startseite (pages/index.astro): der Name ist die Hauptüberschrift
 *   - als Menü (Header.astro, auf allen Geräten): mit Schließen-Knopf genau dort, wo der Menüknopf sitzt,
 *     der Name führt zur Startseite
 * Handy (unter 700 px): der Name steht mittig, die Menüpunkte linksbündig an seiner linken Kante, die Fußzeile mittig.
 * Ab 700 px: alles linksbündig.
 * Slot „aside“ (Startseite: Bildfeld, BlendLoop.astro): am Handy ganz oben, randlos mit harten Kanten oben, links und
 * rechts, unten läuft es weich in den Namen aus (4:3, auf niedrigen Bildschirmen etwas flacher). Ab 700 px füllt
 * es den ganzen Bildschirm; die Schrift hebt sich mit einem Schatten ab, der sich dem Foto anpasst (Skript unten).
 * Fenster (Handy): Die obere Hälfte des Namens liegt im Foto und zeigt es in umgekehrten Farben (Negativ).
 * Farben: Name und Menüpunkte in der Schriftfarbe des Menüs (weiß auf Blau), aktueller Menüpunkt unterstrichen;
 *   beim Überfahren rosa Feld.
 * Übergang: Name, Menüpunkte und Fußzeile tragen feste view-transition-Namen. Beim Wechsel Menü → Startseite
 * gleiten sie an ihren neuen Platz; von der Startseite auf eine Unterseite gleitet der Name ins Logo oben links.
 */
import { site } from '../config/site';
import { useTranslations } from '../i18n';
import { navLinks, isCurrent } from '../lib/nav';
import Icon from './Icon.astro';

export interface Props {
  /** true = Menü (mit Schließen-Knopf), false = Startseite */
  overlay?: boolean;
}

const { overlay = false } = Astro.props;
const t = useTranslations();
const links = await navLinks();
const path = Astro.url.pathname;
const hasAside = Astro.slots.has('aside');

/* Optischer Ausgleich einzelner Buchstabenpaare im Namen (Großbuchstaben in Instrument Serif), in em: zusätzlicher
   Abstand nach dem ersten Buchstaben des Paars. „S–K“ und „D–O–R“ standen zu luftig, „R–N“ berührten sich fast. */
const KERN: Record<string, number> = { SK: -0.025, DO: -0.03, OR: -0.035, RN: 0.015 };
const nameParts = [...site.name].map((ch, i, all) => ({
  ch,
  kern: KERN[(ch + (all[i + 1] ?? '')).toUpperCase()],
}));
---

<div class:list={['bm', 'container', { 'bm--overlay': overlay, 'bm--aside': hasAside }]}>
  {
    overlay && (
      <div class="bm-top">
        <button class="bm-close" type="button" popovertarget="site-menu" popovertargetaction="hide" aria-label={t.nav.close}>
          <Icon name="close" size={30} />
        </button>
      </div>
    )
  }
  {
    overlay ? (
      <a class="bm-name display" href="/">
        {nameParts.map((p) => (p.kern ? <span style={`letter-spacing:calc(-0.01em + ${p.kern}em)`}>{p.ch}</span> : p.ch))}
      </a>
    ) : (
      <h1 class="bm-name display">
        {nameParts.map((p) => (p.kern ? <span style={`letter-spacing:calc(-0.01em + ${p.kern}em)`}>{p.ch}</span> : p.ch))}
      </h1>
    )
  }
  <div class="bm-body">
    <nav aria-label={t.nav.label}>
      <ul class="bm-list" role="list">
      {
        links.map((l) => (
          <li>
            <a class="display" href={l.href} aria-current={isCurrent(path, l.match) ? 'page' : undefined}>
              {l.label}
            </a>
          </li>
        ))
      }
      </ul>
    </nav>
    {
      hasAside && (
        <div class="bm-aside">
          <slot name="aside" />
        </div>
      )
    }
  </div>
  <p class="bm-foot label">
    <a href={site.instagram.url} rel="me noopener" target="_blank">@{site.instagram.handle}</a>
    <a href="/impressum/">{t.footer.imprint}</a>
    <a href="/datenschutz/">{t.footer.privacy}</a>
  </p>
</div>

<script>
  /* Wörter als Fenster ins Foto: Wo ein Wort auf dem Foto liegt, ist es durchsichtig; genau darunter liegt im
     Bildfeld eine Kopie des Worts, die die Farben umkehrt (Weiß im Modus „Differenz“): Die Buchstaben zeigen das
     Foto als Negativ und bleiben so auf dem Foto lesbar. Die Kopie muss im Bildfeld liegen, weil sich Name und Menü wegen der
     Seitenübergänge nicht mit dem Foto mischen können. Ohne JavaScript bleiben die Wörter einfach einfarbig.
       Handy: der Name – die obere Hälfte liegt im Foto (CSS: Verlauf von oben nach unten). Am Laptop (Foto über den
       ganzen Bildschirm) wird die Kopie nicht gezeigt. */
  type Prop =
    | 'fontSize'
    | 'lineHeight'
    | 'letterSpacing'
    | 'paddingTop'
    | 'paddingBottom'
    | 'paddingLeft'
    | 'paddingRight'
    | 'textTransform'
    | 'webkitTextStrokeWidth';
  const COPY: Prop[] = [
    'fontSize',
    'lineHeight',
    'letterSpacing',
    'paddingTop',
    'paddingBottom',
    'paddingLeft',
    'paddingRight',
    'textTransform',
    'webkitTextStrokeWidth',
  ];

  /** Legt die Kopie an und gibt zurück, wie sie neu ausgerichtet wird */
  function addWindow(bm: HTMLElement, source: HTMLElement | null, kind: string, flag: string) {
    const box = bm.querySelector<HTMLElement>('.bm-aside [data-blend]');
    if (!source || !box) return null;
    const word = document.createElement('span');
    word.className = `bm-window bm-window--${kind} display`;
    word.innerHTML = source.innerHTML; // samt Ausgleich einzelner Buchstabenpaare (Spans)
    box.append(word);
    // deckungsgleich über das echte Wort legen (auch nach Drehen, Größenänderung, Laden der Schrift)
    const place = () => {
      const cs = getComputedStyle(source);
      for (const p of COPY) word.style[p] = cs[p];
      const a = source.getBoundingClientRect();
      const b = box.getBoundingClientRect();
      word.style.translate = `${a.left - b.left}px ${a.top - b.top}px`;
    };
    bm.classList.add(flag);
    return place;
  }

  /* Laptop: Das Foto füllt den Bildschirm, die weiße Schrift hebt sich mit einem weichen Schatten ab, der sich dem
     Foto dahinter anpasst. Bei jedem Fotowechsel wird das sichtbare Bild (die beiden Fotos im Modus „Aufhellen“)
     klein nachgezeichnet und für jedes Wort die Fläche dahinter gemessen: Helligkeit → Stärke des Schattens (auf
     hellen Stellen kräftig, auf dunklen kaum), Farbe → ein dunkler Ton derselben Farbe. Gesetzt wird --sh je Wort;
     der Schatten blendet dann im Takt der Fotos über (CSS). */
  const desk = matchMedia('(min-width: 700px)');
  const clamp = (v: number, lo: number, hi: number) => Math.min(hi, Math.max(lo, v));

  function initShadows(bm: HTMLElement) {
    const box = bm.querySelector<HTMLElement>('[data-blend]');
    const canvas = document.createElement('canvas');
    const ctx = canvas.getContext('2d', { willReadFrequently: true });
    if (!box || !ctx) return null;
    const words = [...bm.querySelectorAll<HTMLElement>('.bm-name, .bm-list a')];

    // ein Foto so zeichnen wie im Bildfeld: object-fit: cover mit object-position (Bildschwerpunkt)
    const draw = (img: HTMLImageElement, w: number, h: number) => {
      const iw = img.naturalWidth;
      const ih = img.naturalHeight;
      if (!img.complete || !iw || !ih) return;
      const scale = Math.max(w / iw, h / ih);
      const [fx = 50, fy = 50] = (img.style.objectPosition || '50% 50%').split(' ').map((v) => parseFloat(v));
      const dw = iw * scale;
      const dh = ih * scale;
      ctx.drawImage(img, ((w - dw) * fx) / 100, ((h - dh) * fy) / 100, dw, dh);
    };

    const sample = () => {
      if (!desk.matches) {
        for (const el of words) el.style.removeProperty('--sh');
        return;
      }
      const b = box.getBoundingClientRect();
      if (!b.width || !b.height) return;
      const W = 96;
      const H = Math.max(1, Math.round((W * b.height) / b.width));
      canvas.width = W;
      canvas.height = H;
      ctx.globalCompositeOperation = 'source-over';
      ctx.fillStyle = '#000';
      ctx.fillRect(0, 0, W, H);
      ctx.globalCompositeOperation = 'lighten';
      let imgs = box.querySelectorAll<HTMLImageElement>('.blend-layer.is-on img');
      if (!imgs.length) imgs = box.querySelectorAll<HTMLImageElement>('.blend-layer:nth-child(-n + 2) img');
      for (const img of imgs) draw(img, W, H);
      let data: Uint8ClampedArray;
      try {
        data = ctx.getImageData(0, 0, W, H).data;
      } catch {
        return; // Bild (noch) nicht lesbar – dann bleibt der neutrale Schatten aus dem CSS
      }
      for (const el of words) {
        const r = el.getBoundingClientRect();
        const x0 = clamp(Math.floor(((r.left - b.left) / b.width) * W), 0, W - 1);
        const x1 = clamp(Math.ceil(((r.right - b.left) / b.width) * W), x0 + 1, W);
        const y0 = clamp(Math.floor(((r.top - b.top) / b.height) * H), 0, H - 1);
        const y1 = clamp(Math.ceil(((r.bottom - b.top) / b.height) * H), y0 + 1, H);
        let R = 0;
        let G = 0;
        let B = 0;
        let n = 0;
        for (let y = y0; y < y1; y++) {
          for (let x = x0; x < x1; x++) {
            const i = (y * W + x) * 4;
            R += data[i]!;
            G += data[i + 1]!;
            B += data[i + 2]!;
            n++;
          }
        }
        R /= n;
        G /= n;
        B /= n;
        const light = (0.2126 * R + 0.7152 * G + 0.0722 * B) / 255;
        const alpha = clamp((light - 0.15) * 1.2, 0.12, 0.85);
        const k = 0.22; // dunkler Ton derselben Farbe
        el.style.setProperty('--sh', `rgb(${Math.round(R * k)} ${Math.round(G * k)} ${Math.round(B * k)} / ${alpha.toFixed(2)})`);
      }
    };

    // neu messen, sobald ein Foto dazukommt oder verschwindet und sobald Fotos geladen sind
    new MutationObserver(sample).observe(box, { subtree: true, attributes: true, attributeFilter: ['class'] });
    for (const img of box.querySelectorAll('img')) img.addEventListener('load', sample);
    return sample;
  }

  for (const bm of document.querySelectorAll<HTMLElement>('.bm--aside')) {
    const place = addWindow(bm, bm.querySelector('.bm-name'), 'name', 'has-name-window');
    const shade = initShadows(bm);
    // neu ausrichten bzw. messen nach Drehen, Größenänderung, geladener Schrift
    const update = () => {
      place?.();
      shade?.();
    };
    update();
    new ResizeObserver(update).observe(bm);
    document.fonts?.ready.then(update);
    // Beim Wechsel auf eine Unterseite gleitet der Name ins Logo – dafür ganz blau (die Kopie gleitet nicht mit)
    addEventListener('pageswap', () => bm.classList.remove('has-name-window'));
  }
</script>

<style>
  /* Farbfläche über den ganzen Bildschirm; Inhalt von oben nach unten: Name, Menü, Fußzeile */
  .bm {
    /* Schriftgröße der Menüpunkte */
    --bm-item: clamp(2.3rem, 10.5vw, 4.75rem);
    /* Farbe und Schriftgröße des Namens (auch fürs Foto am Handy gebraucht) */
    --name-color: var(--on-menu);
    /* „JESKO DORNER“ ist in Instrument Serif 5,22 Schrifthöhen breit → / 5.9 füllt knapp 90 % der Breite */
    --name-fs: min(11rem, 100cqi / 5.9);
    /* oberer Seitenrand (Laptop: auch der Abstand des Fotos nach oben) */
    --bm-pad: clamp(1.25rem, 4vw, 2.5rem);
    container-type: inline-size;
    display: flex;
    flex-direction: column;
    min-height: 100%;
    /* unterer Seitenrand (Laptop: auch der Abstand im blauen Streifen über der Fußzeile) */
    --foot-pad: max(1.5rem, env(safe-area-inset-bottom));
    padding-block: var(--bm-pad) var(--foot-pad);
    color: var(--on-menu);
  }
  /* Im Menü: oben eine Leiste so hoch wie der Header, der Schließen-Knopf sitzt an der Stelle des Menüknopfs */
  .bm--overlay {
    padding-top: 0;
  }
  .bm-top {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    height: var(--header-h);
    margin-bottom: clamp(0.25rem, 2vw, 1rem);
  }
  /* Schließen-Knopf wie der Menüknopf auf den Unterseiten: korallenroter Kreis (auf Weiß sichtbar) */
  .bm-close {
    display: inline-grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border: 0;
    border-radius: 50%;
    background: var(--pink);
    color: var(--ink);
    cursor: pointer;
    transition:
      background-color 0.2s,
      color 0.2s;
  }
  .bm-close:hover {
    background: var(--ink);
    color: var(--pink);
  }
  /* Name: eine Zeile, so breit wie der Platz (aber nicht riesig), in --name-color (Schriftfarbe des Menüs). Im Menü ist er ein Link zur Startseite
     und bekommt beim Überfahren dasselbe rosa Feld wie die Menüpunkte. */
  .bm-name {
    view-transition-name: jd-name;
    display: block;
    width: fit-content;
    font-size: var(--name-fs);
    line-height: 0.9;
    white-space: nowrap;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--name-color);
    /* etwas fetter als die Schrift selbst (sie hat nur eine Stärke): feine Kontur in Schriftfarbe */
    -webkit-text-stroke: 0.022em currentColor;
    /* Platz für den Bogen des „J“, der unter die Zeile und links über den Rand ragt (sonst schneidet ihn der
       Foto-Effekt am Handy ab) – ohne das Layout zu ändern */
    padding: 0.08em 0.12em 0.15em;
    margin: 0 -0.12em -0.15em;
    transition:
      background-color 0.2s,
      color 0.2s;
  }
  a.bm-name:hover {
    background: var(--pink);
    color: var(--ink);
  }
  /* Menüpunkte: deutlich kleiner als der Name, mit Luft dazwischen */
  /* Menüpunkte, dazu optional das Bildfeld (Slot „aside“). Handy: Bildfeld mittig im freien Platz darunter. */
  .bm-body {
    flex: 1;
    display: flex;
    flex-direction: column;
    margin-top: clamp(2.5rem, 9vh, 6rem);
  }
  .bm-aside {
    display: grid;
  }
  /* Kopien für die Fenster (siehe Skript): weiß im Modus „Differenz“, sichtbar nur, wo das Wort auf dem Foto liegt */
  .bm-aside :global(.bm-window) {
    display: block;
    position: absolute;
    top: 0;
    left: 0;
    z-index: 1;
    margin: 0;
    white-space: nowrap;
    color: #fff;
    mix-blend-mode: difference;
    pointer-events: none;
  }
  /* Handy – auf der Startseite und im Menü gleich: Raster mit drei Spalten. Die mittlere ist genau so breit wie der
     Name, so steht er mittig und die Menüpunkte beginnen an seiner linken Kante. Reihen: Foto (Startseite) bzw.
     Schließen-Knopf (Menü) · Name · Menüpunkte · Fußzeile (mittig ganz unten).
     Startseite: Das Foto steht ganz oben, randlos mit harten Kanten oben, links und rechts, und läuft unten weich in
     den Namen aus – die obere Hälfte der Buchstaben liegt im Foto und zeigt es als Negativ (Fenster, siehe Skript).
     Maße in Schrifthöhen des Namens (Instrument Serif, gemessen): Großbuchstaben 0,126 bis 0,858 unter seiner
     Oberkante, Mitte 0,492. Das Foto ist bis 0,2 über der Mitte voll da, läuft über 0,4 aus und endet 0,2 unter der
     Mitte (also 0,692 in den Namen). */
  @media (max-width: 699.98px) {
    .bm {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
      grid-template-rows: auto auto 1fr auto;
    }
    .bm > * {
      grid-column: 1 / -1;
    }
    .bm .bm-name {
      grid-column: 2;
      grid-row: 2;
    }
    .bm-body {
      display: contents;
    }
    .bm-body > nav {
      grid-column: 2;
      grid-row: 3;
      margin-top: clamp(2.5rem, 9vh, 6rem);
    }
    .bm-aside {
      grid-column: 1 / -1;
      grid-row: 1;
      margin-inline: calc(-1 * var(--gutter));
      margin-top: calc(-1 * var(--bm-pad)); /* bis an den oberen Bildschirmrand */
      --blend-w: 100%;
      /* 4:3 über die ganze Breite; auf niedrigen Bildschirmen etwas flacher, damit nichts scrollt */
      --blend-h: min(75vw, 45svh);
      --blend-mask: linear-gradient(to bottom, #000 calc(100% - 0.4 * var(--name-fs)), transparent 100%);
    }
    .bm--aside .bm-name {
      margin-top: -0.692em;
      position: relative;
      z-index: 1; /* über dem Foto */
    }
    /* Mit JavaScript: oben (im Foto) durchsichtig, dort scheint die Kopie durch; unten in der Schriftfarbe – der
       Wechsel liegt mitten im weichen Rand des Fotos */
    .bm--aside.has-name-window .bm-name {
      color: transparent;
      background-image: linear-gradient(to bottom, transparent 0.402em, var(--name-color) 0.562em);
      -webkit-background-clip: text;
      background-clip: text;
    }
    .bm-foot {
      justify-content: center;
      padding-top: 1.25rem;
    }
  }
  /* Ab 700 px: Das Foto füllt den ganzen Bildschirm hinter Name und Menü; unten bleibt ein blauer Streifen (bündig
     links, rechts und unten) mit der Fußzeile. Die weiße Schrift hebt sich mit
     einem weichen Schatten ab, der sich dem Foto dahinter anpasst (Farbe und Stärke setzt das Skript je Wort über
     --sh; ohne Skript ein neutraler dunkler Schatten). Die geteilte Fassung (Foto rechts, Kante zwischen R und N)
     liegt im Git-Tag alte-version-laptop-geteilt. */
  @media (min-width: 700px) {
    .bm-body {
      flex: none;
    }
    .bm--aside {
      position: relative;
      isolation: isolate; /* eigene Ebene: Foto (z-index -1) über dem Seitenhintergrund, unter der Schrift */
    }
    .bm-aside {
      position: absolute;
      top: 0;
      /* unten bleibt ein blauer Streifen für die Fußzeile frei: oben und unten gleich viel Luft um die Zeile
         (Zeilenhöhe der kleinen Schrift: 1,3) */
      bottom: calc(2 * var(--foot-pad) + 1.3 * var(--fs-xs));
      left: calc(50% - 50vw); /* bis an die Bildschirmränder, auch wenn der Inhalt schmaler ist */
      width: 100vw;
      z-index: -1;
      --blend-w: 100%;
      --blend-h: 100%;
    }
    .bm-aside :global(.bm-window) {
      display: none;
    }
    /* Schatten als Filter auf das fertig gezeichnete Wort (nicht als text-shadow): Safari und Firefox zeichnen den
       Schatten der Kontur (macht den Namen fetter) sonst über die Buchstaben – sie wirken dann innen grau. */
    .bm--aside .bm-name,
    .bm--aside .bm-list a {
      --sh: rgb(10 12 20 / 0.45);
      filter: drop-shadow(0 0 0.35em var(--sh)) drop-shadow(0 0 0.1em var(--sh));
      transition:
        filter 1.5s var(--ease),
        background-color 0.2s,
        color 0.2s;
    }
    .bm--aside .bm-list a:hover {
      filter: none;
    }
  }
  .bm-list {
    view-transition-name: jd-menu;
    list-style: none;
    padding: 0;
    display: grid;
    gap: clamp(0.35rem, 1.2vh, 0.9rem);
  }
  /* Menüpunkte als Blöcke: jede Zeile ist genau 0,95 Schrifthöhen hoch, so lässt sich das Bildfeld exakt an der
     Schrift ausrichten (Handy: Fotokante hinter „Kontakt“, Laptop: Ober-/Unterkante der Buchstaben) */
  .bm-list a {
    display: block;
    width: fit-content;
    font-size: var(--bm-item);
    line-height: 0.95;
    text-transform: uppercase;
    font-style: italic;
    text-decoration: none;
    color: inherit;
  }
  /* „Portfolio“ hebt sich ab: als einziger Punkt gerade, die anderen kursiv */
  .bm-list a[href='/portfolio/'] {
    font-style: normal;
  }
  /* Aktueller Punkt (im Menü auf Unterseiten): unterstrichen. Überfahren: rosa Feld mit schwarzer Schrift. Das Feld steht
     links und rechts ein klein wenig über, die Schrift bleibt an ihrem Platz. */
  .bm-list a {
    padding-inline: 0.06em;
    margin-inline: -0.06em;
    transition:
      background-color 0.2s,
      color 0.2s;
  }
  .bm-list a[aria-current='page'] {
    text-decoration: underline;
    text-decoration-thickness: 0.07em;
    text-underline-offset: 0.1em;
  }
  .bm-list a:hover {
    background-color: var(--pink);
    color: var(--ink);
  }
  .bm-foot {
    view-transition-name: jd-menu-foot;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 0.6rem;
    margin-top: auto;
    padding-top: 2.5rem;
  }
  /* Kleine Links in der Schriftfarbe, beim Überfahren rosa hinterlegt wie die Menüpunkte */
  .bm-foot a {
    color: inherit;
  }
  .bm-foot a:hover {
    background: var(--pink);
    color: var(--ink);
    text-decoration-color: currentColor; /* nicht das Orange der weißen Seiten */
  }
  .bm a:focus-visible,
  .bm-close:focus-visible {
    outline: 3px solid var(--on-menu);
    outline-offset: 4px;
  }
</style>
