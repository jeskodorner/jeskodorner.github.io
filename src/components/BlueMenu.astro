---
/**
 * Das Menü (früher blau, jetzt weiß mit schwarzer Schrift): oben groß der Name, darunter die Menüpunkte (etwas kleiner), unten Instagram,
 * Impressum und Datenschutz. Zwei Einsätze:
 *   - als Startseite (pages/index.astro): der Name ist die Hauptüberschrift
 *   - als Menü (Header.astro, auf allen Geräten): mit Schließen-Knopf genau dort, wo der Menüknopf sitzt,
 *     der Name führt zur Startseite
 * Handy (unter 700 px): der Name steht mittig, die Menüpunkte linksbündig an seiner linken Kante, die Fußzeile mittig.
 * Ab 700 px: alles linksbündig.
 * Slot „aside“ (Startseite: Bildfeld, BlendLoop.astro): am Handy randlos über die ganze Breite, beginnt hinter
 * „Kontakt“ (4:3, auf niedrigen Bildschirmen etwas flacher, aber immer randlos). Ab 700 px rechts innerhalb der
 * Seitenränder, der Name ragt hinein.
 * Fenster: Wo ein Wort auf dem Foto liegt, zeigen seine Buchstaben das Foto in umgekehrten Farben (Negativ) – am Handy
 * die untere Hälfte von „Kontakt“, am Laptop der Teil des Namens, der ins Foto ragt (Skript unten).
 * Farben: Name und Menüpunkte schwarz, aktueller Menüpunkt blau; beim Überfahren rosa Feld.
 * Übergang: Name, Menüpunkte und Fußzeile tragen feste view-transition-Namen. Beim Wechsel Menü → Startseite
 * gleiten sie an ihren neuen Platz; von der Startseite auf eine Unterseite gleitet der Name ins Logo oben links.
 */
import { site } from '../config/site';
import { useTranslations } from '../i18n';
import { navLinks, isCurrent } from '../lib/nav';
import Icon from './Icon.astro';

export interface Props {
  /** true = Menü (mit Schließen-Knopf), false = Startseite */
  overlay?: boolean;
}

const { overlay = false } = Astro.props;
const t = useTranslations();
const links = await navLinks();
const path = Astro.url.pathname;
const hasAside = Astro.slots.has('aside');
---

<div class:list={['bm', 'container', { 'bm--overlay': overlay, 'bm--aside': hasAside }]}>
  {
    overlay && (
      <div class="bm-top">
        <button class="bm-close" type="button" popovertarget="site-menu" popovertargetaction="hide" aria-label={t.nav.close}>
          <Icon name="close" size={30} />
        </button>
      </div>
    )
  }
  {
    overlay ? (
      <a class="bm-name display" href="/">
        {site.name}
      </a>
    ) : (
      <h1 class="bm-name display">{site.name}</h1>
    )
  }
  <div class="bm-body">
    <nav aria-label={t.nav.label}>
      <ul class="bm-list" role="list">
      {
        links.map((l) => (
          <li>
            <a class="display" href={l.href} aria-current={isCurrent(path, l.match) ? 'page' : undefined}>
              {l.label}
            </a>
          </li>
        ))
      }
      </ul>
    </nav>
    {
      hasAside && (
        <div class="bm-aside">
          <slot name="aside" />
        </div>
      )
    }
  </div>
  <p class="bm-foot label">
    <a href={site.instagram.url} rel="me noopener" target="_blank">@{site.instagram.handle}</a>
    <a href="/impressum/">{t.footer.imprint}</a>
    <a href="/datenschutz/">{t.footer.privacy}</a>
  </p>
</div>

<script>
  /* Wörter als Fenster ins Foto: Wo ein Wort auf dem Foto liegt, ist es durchsichtig; genau darunter liegt im
     Bildfeld eine Kopie des Worts, die die Farben umkehrt (Weiß im Modus „Differenz“): Die Buchstaben zeigen das
     Foto als Negativ und bleiben so auf dem Foto lesbar. Die Kopie muss im Bildfeld liegen, weil sich Name und Menü wegen der
     Seitenübergänge nicht mit dem Foto mischen können. Ohne JavaScript bleiben die Wörter einfach einfarbig.
       Handy:  „Kontakt“ – die untere Hälfte liegt auf dem Foto (CSS: Verlauf von oben nach unten)
       Laptop: der Name – der rechte Teil ragt ins Foto (CSS: Schnitt bei --split, dem linken Fotorand) */
  type Prop = 'fontSize' | 'lineHeight' | 'letterSpacing' | 'paddingTop' | 'paddingLeft' | 'paddingRight';
  const COPY: Prop[] = ['fontSize', 'lineHeight', 'letterSpacing', 'paddingTop', 'paddingLeft', 'paddingRight'];

  /** Legt die Kopie an und gibt zurück, wie sie neu ausgerichtet wird */
  function addWindow(bm: HTMLElement, source: HTMLElement | null, kind: string, flag: string) {
    const box = bm.querySelector<HTMLElement>('.bm-aside [data-blend]');
    if (!source || !box) return null;
    const word = document.createElement('span');
    word.className = `bm-window bm-window--${kind} display`;
    word.textContent = source.textContent?.trim() ?? '';
    box.append(word);
    // deckungsgleich über das echte Wort legen (auch nach Drehen, Größenänderung, Laden der Schrift)
    const place = () => {
      const cs = getComputedStyle(source);
      for (const p of COPY) word.style[p] = cs[p];
      const a = source.getBoundingClientRect();
      const b = box.getBoundingClientRect();
      word.style.translate = `${a.left - b.left}px ${a.top - b.top}px`;
      source.style.setProperty('--split', `${(b.left - a.left).toFixed(1)}px`);
    };
    bm.classList.add(flag);
    return place;
  }

  /* Laptop: Lage des Fotos. Die Fotokante (Mitte des kurzen Übergangs) läuft immer genau zwischen R und N von
     „Dorner“ – „DOR“ bleibt blau, „NER“ liegt im Foto (die beiden Buchstaben stoßen in dieser Schrift aneinander,
     der Übergang verteilt sich gleichmäßig auf beide Kanten). Unten endet das Foto auf der Grundlinie von „Kontakt“.
     Setzt --photo-w (Breite) und --photo-b (Abstand unten); ohne JavaScript: Bildschirmmitte bzw. Fußzeile. */
  const desk = matchMedia('(min-width: 700px)');
  const baseline = (el: HTMLElement) => {
    const probe = document.createElement('span');
    probe.style.cssText = 'display:inline-block;width:0;height:0;vertical-align:baseline';
    el.append(probe);
    const y = probe.getBoundingClientRect().top;
    probe.remove();
    return y;
  };
  function layoutPhoto(bm: HTMLElement) {
    const aside = bm.querySelector<HTMLElement>('.bm-aside');
    const name = bm.querySelector<HTMLElement>('.bm-name');
    const last = bm.querySelector<HTMLElement>('.bm-list li:last-child a');
    if (!aside || !name) return;
    aside.style.removeProperty('--photo-w');
    aside.style.removeProperty('--photo-b');
    if (!desk.matches) return;
    // unten: Grundlinie von „Kontakt“
    if (last) aside.style.setProperty('--photo-b', `${(bm.getBoundingClientRect().bottom - baseline(last)).toFixed(1)}px`);
    // links: Grenze zwischen R und N
    const node = [...name.childNodes].find((n) => n.nodeType === Node.TEXT_NODE && n.textContent?.trim());
    const i = node?.textContent?.toLowerCase().lastIndexOf('rn') ?? -1;
    if (!node || i < 0) return;
    const range = document.createRange();
    range.setStart(node, i + 1);
    range.setEnd(node, i + 2);
    const edge = range.getBoundingClientRect().left;
    // Breite des Übergangs (CSS --fade) messen; die Kante ist seine Mitte
    const probe = document.createElement('div');
    probe.style.cssText = 'position:absolute;visibility:hidden;width:var(--fade)';
    bm.append(probe);
    const fade = probe.getBoundingClientRect().width;
    probe.remove();
    const right = aside.getBoundingClientRect().right;
    aside.style.setProperty('--photo-w', `${(right - edge + fade / 2).toFixed(1)}px`);
  }

  for (const bm of document.querySelectorAll<HTMLElement>('.bm--aside')) {
    const placers = [
      addWindow(bm, bm.querySelector('.bm-list li:last-child a'), 'kontakt', 'has-window'),
      addWindow(bm, bm.querySelector('.bm-name'), 'name', 'has-name-window'),
    ];
    // erst die Fotokante ausrichten, dann die Kopien darauf legen (auch nach Drehen, Größenänderung, Schrift geladen)
    const update = () => {
      layoutPhoto(bm);
      for (const place of placers) place?.();
    };
    update();
    new ResizeObserver(update).observe(bm);
    document.fonts?.ready.then(update);
    // Beim Wechsel auf eine Unterseite gleitet der Name ins Logo – dafür ganz blau (die Kopie gleitet nicht mit)
    addEventListener('pageswap', () => bm.classList.remove('has-name-window'));
  }
</script>

<style>
  /* Weiße Fläche über den ganzen Bildschirm; Inhalt von oben nach unten: Name, Menü, Fußzeile */
  .bm {
    /* Schriftgröße der Menüpunkte */
    --bm-item: clamp(2.3rem, 10.5vw, 4.75rem);
    /* Farbe des Namens (vorher Blau: var(--accent)) */
    --name-color: var(--on-menu);
    /* oberer Seitenrand (Laptop: auch der Abstand des Fotos nach oben) */
    --bm-pad: clamp(1.25rem, 4vw, 2.5rem);
    container-type: inline-size;
    display: flex;
    flex-direction: column;
    min-height: 100%;
    padding-block: var(--bm-pad) max(1.5rem, env(safe-area-inset-bottom));
    color: var(--on-menu);
  }
  /* Im Menü: oben eine Leiste so hoch wie der Header, der Schließen-Knopf sitzt an der Stelle des Menüknopfs */
  .bm--overlay {
    padding-top: 0;
  }
  .bm-top {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    height: var(--header-h);
    margin-bottom: clamp(0.25rem, 2vw, 1rem);
  }
  /* Schließen-Knopf wie der Menüknopf auf den Unterseiten: korallenroter Kreis (auf Weiß sichtbar) */
  .bm-close {
    display: inline-grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border: 0;
    border-radius: 50%;
    background: var(--pink);
    color: var(--ink);
    cursor: pointer;
    transition:
      background-color 0.2s,
      color 0.2s;
  }
  .bm-close:hover {
    background: var(--ink);
    color: var(--pink);
  }
  /* Name: eine Zeile, so breit wie der Platz (aber nicht riesig), in --name-color (schwarz). Im Menü ist er ein Link zur Startseite
     und bekommt beim Überfahren dasselbe rosa Feld wie die Menüpunkte. */
  .bm-name {
    view-transition-name: jd-name;
    display: block;
    width: fit-content;
    font-size: min(11rem, 100cqi / 5.4);
    line-height: 0.9;
    padding-top: 0.08em;
    white-space: nowrap;
    text-decoration: none;
    color: var(--name-color);
    transition:
      background-color 0.2s,
      color 0.2s;
  }
  a.bm-name:hover {
    background: var(--pink);
    color: var(--ink);
  }
  /* Menüpunkte: deutlich kleiner als der Name, mit Luft dazwischen */
  /* Menüpunkte, dazu optional das Bildfeld (Slot „aside“). Handy: Bildfeld mittig im freien Platz darunter. */
  .bm-body {
    flex: 1;
    display: flex;
    flex-direction: column;
    margin-top: clamp(2.5rem, 9vh, 6rem);
  }
  .bm-aside {
    display: grid;
  }
  /* Kopien für die Fenster (siehe Skript): weiß im Modus „Differenz“, sichtbar nur, wo das Wort auf dem Foto liegt */
  .bm-aside :global(.bm-window) {
    display: none;
    position: absolute;
    top: 0;
    left: 0;
    z-index: 1;
    margin: 0;
    white-space: nowrap;
    color: #fff;
    mix-blend-mode: difference;
    pointer-events: none;
  }
  /* Handy – auf der Startseite und im Menü gleich: Raster mit drei Spalten. Die mittlere ist genau so breit wie der
     Name, so steht er mittig und die Menüpunkte beginnen an seiner linken Kante. Die Reihe nach dem Menü füllt den
     restlichen Platz (Startseite: Bildfeld), die Fußzeile steht mittig ganz unten. */
  @media (max-width: 699.98px) {
    .bm {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
      grid-template-rows: auto auto 1fr auto;
    }
    .bm > * {
      grid-column: 1 / -1;
    }
    .bm .bm-name {
      grid-column: 2;
    }
    .bm-body {
      display: contents;
    }
    .bm-body > nav {
      grid-column: 2;
      margin-top: clamp(2.5rem, 9vh, 6rem);
      position: relative;
      z-index: 1; /* über dem Bildfeld */
    }
    .bm-aside {
      grid-column: 1 / -1;
      /* randlos über die ganze Breite und halb hinter „Kontakt“. Maße in Schrifthöhen der Menüpunkte (--bm-item):
         die Mitte der Buchstaben liegt 0,54 über dem Zeilenende. Das Foto beginnt 0,2 darüber und ist nach einem
         kurzen weichen Übergang (0,4) ab 0,2 darunter voll da. */
      margin-inline: calc(-1 * var(--gutter));
      margin-top: calc(-0.74 * var(--bm-item));
      padding-top: 0;
      place-items: start center;
      container-type: size;
      /* Immer über die ganze Breite. 4:3, nur wenn die Höhe dafür nicht reicht, etwas flacher (Fotos werden
         dann oben und unten etwas mehr beschnitten) – so scrollt die Startseite nicht */
      --blend-w: 100cqw;
      --blend-h: min(75cqw, 100cqh);
      /* oben und unten weich auslaufen (oben liegt „Kontakt“ im ausgeblendeten Bereich und bleibt lesbar) */
      --blend-mask: linear-gradient(
        to bottom,
        transparent 0,
        #000 calc(0.4 * var(--bm-item)),
        #000 75%,
        transparent 100%
      );
    }
    /* „Kontakt“ halb auf dem hellen Foto: oben weiß, wo das Foto beginnt in der Hintergrundfarbe – mit weichem
       Übergang passend zum Rand des Fotos (Mitte der Buchstaben: 0,41 unter der Zeilenoberkante) */
    .bm--aside .bm-list li:last-child a {
      color: transparent;
      background-image: linear-gradient(to bottom, var(--on-menu) 0.34em, var(--menu-bg) 0.5em);
      -webkit-background-clip: text;
      background-clip: text;
    }
    /* Mit JavaScript: unten durchsichtig, dort scheint die Kopie im Bildfeld durch (Foto positiv, siehe Skript) */
    .bm--aside.has-window .bm-list li:last-child a {
      background-image: linear-gradient(to bottom, var(--on-menu) 0.34em, transparent 0.5em);
    }
    .bm-aside :global(.bm-window--kontakt) {
      display: block;
    }
    .bm--aside .bm-list li:last-child a:hover {
      background-image: none;
      background-color: var(--pink);
      -webkit-background-clip: border-box;
      background-clip: border-box;
      color: var(--ink);
    }
    .bm-foot {
      justify-content: center;
      padding-top: 1.25rem;
    }
  }
  /* Ab 700 px: geteilt – links auf Weiß Name, Menü und Fußzeile, rechts das Foto, innerhalb der Seitenränder (oben
     so weit vom Rand wie der Name, rechts so weit wie der Text links), bis zur Grundlinie von „Kontakt“. Die linke Kante läuft zwischen R und N des Namens („DOR“ blau, „NER“
     im Foto, Skript) und hat einen ganz kurzen Übergang (--fade). Wo der Name im Foto liegt, zeigen seine Buchstaben
     das Foto positiv (Fenster), mit demselben kurzen Übergang. */
  @media (min-width: 700px) {
    .bm-body {
      flex: none;
    }
    .bm--aside {
      position: relative;
      --fade: clamp(0.75rem, 1.5vw, 1.5rem);
    }
    .bm-aside {
      position: absolute;
      top: var(--bm-pad);
      /* --photo-b (Skript): Grundlinie von „Kontakt“. Ohne Skript: Grundlinie der Fußzeile (unterer Seitenabstand
         + 0,376 Schrifthöhen, gemessen) */
      bottom: var(--photo-b, calc(max(1.5rem, env(safe-area-inset-bottom)) + 0.376 * var(--fs-xs)));
      right: var(--gutter); /* rechter Seitenrand, gleich weit wie der Text links */
      width: var(--photo-w, 50vw); /* --photo-w (Skript): Kante zwischen R und N des Namens */
      --blend-w: 100%;
      --blend-h: 100%;
      --blend-mask: linear-gradient(to right, transparent 0, #000 var(--fade));
    }
    .bm--aside .bm-name {
      position: relative;
      z-index: 1; /* über dem Foto */
    }
    .bm-aside :global(.bm-window--name) {
      display: block;
    }
    /* Mit JavaScript: links vom Fotorand blau, auf dem Foto durchsichtig (dort scheint die Kopie durch); dazwischen
       derselbe kurze Übergang wie am Fotorand, so blenden Blau und Foto ineinander */
    .bm--aside.has-name-window .bm-name {
      color: transparent;
      background-image: linear-gradient(
        to right,
        var(--name-color) var(--split, 100%),
        transparent calc(var(--split, 100%) + var(--fade))
      );
      -webkit-background-clip: text;
      background-clip: text;
    }
  }
  .bm-list {
    view-transition-name: jd-menu;
    list-style: none;
    padding: 0;
    display: grid;
    gap: clamp(0.35rem, 1.2vh, 0.9rem);
  }
  /* Menüpunkte als Blöcke: jede Zeile ist genau 0,95 Schrifthöhen hoch, so lässt sich das Bildfeld exakt an der
     Schrift ausrichten (Handy: Fotokante hinter „Kontakt“, Laptop: Ober-/Unterkante der Buchstaben) */
  .bm-list a {
    display: block;
    width: fit-content;
    font-size: var(--bm-item);
    line-height: 0.95;
    text-decoration: none;
    color: inherit;
  }
  /* Aktueller Punkt (im Menü auf Unterseiten): blau. Überfahren: rosa Feld mit schwarzer Schrift. Das Feld steht
     links und rechts ein klein wenig über, die Schrift bleibt an ihrem Platz. */
  .bm-list a {
    padding-inline: 0.06em;
    margin-inline: -0.06em;
    transition:
      background-color 0.2s,
      color 0.2s;
  }
  .bm-list a[aria-current='page'] {
    color: var(--accent);
  }
  .bm-list a:hover {
    background-color: var(--pink);
    color: var(--ink);
  }
  .bm-foot {
    view-transition-name: jd-menu-foot;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 0.6rem;
    margin-top: auto;
    padding-top: 2.5rem;
  }
  /* Kleine Links schlicht schwarz, beim Überfahren rosa hinterlegt wie die Menüpunkte */
  .bm-foot a {
    color: inherit;
  }
  .bm-foot a:hover {
    background: var(--pink);
    color: var(--ink);
    text-decoration-color: currentColor; /* nicht das Orange der weißen Seiten */
  }
  .bm a:focus-visible,
  .bm-close:focus-visible {
    outline: 3px solid var(--on-menu);
    outline-offset: 4px;
  }
</style>
