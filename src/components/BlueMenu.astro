---
/**
 * Das Menü (blau mit weißer Schrift, Farben in tokens.css): oben groß der Name, darunter die Menüpunkte (etwas kleiner), unten Instagram
 * (auf der Startseite und im Menü gleich). Zwei Einsätze:
 *   - als Startseite (pages/index.astro): der Name ist die Hauptüberschrift
 *   - als Menü (Header.astro, auf allen Geräten): mit Schließen-Knopf genau dort, wo der Menüknopf sitzt,
 *     der Name führt zur Startseite
 * Menü – Handy (unter 700 px): der Name steht mittig, die Menüpunkte linksbündig an seiner linken Kante, die Fußzeile
 * mittig. Ab 700 px: alles linksbündig.
 * Startseite (Slot „aside“ mit der Fotofläche HomeSlides.astro) – Richtung „Bild neben Name“: Schrift steht nie auf
 * dem Foto. Ab 1000 px zwei Spalten: links Name, Menü und Instagram auf Blau, rechts ein scharfes Foto
 * mit Bildunterschrift. Darunter (Handy, Tablet hochkant): Foto ganz oben randlos mit harten Kanten, darunter
 * Bildunterschrift, Name, Menü, Instagram. Das Menü ist hier etwa halb so groß wie der Name.
 * Frühere Fassungen in Git-Tags: alte-version-startseite-ueberblendung (Doppelbelichtung, Schrift auf dem Foto mit
 * Schatten), alte-version-laptop-geteilt.
 * Farben: Name und Menüpunkte in der Schriftfarbe des Menüs (weiß auf Blau), aktueller Menüpunkt unterstrichen;
 *   beim Überfahren rosa Feld.
 * Übergang: Name (Wort für Wort: jd-name-1 „JESKO“, jd-name-2 „DORNER“), Menüpunkte und Fußzeile tragen feste
 * view-transition-Namen. Wortweise, damit jedes Wort unverzerrt gleitet – auch vom zweizeiligen Namen am Handy in
 * das einzeilige Logo. Beim Wechsel Menü → Startseite
 * gleiten sie an ihren neuen Platz; von der Startseite auf eine Unterseite gleitet der Name ins Logo oben links.
 */
import { site } from '../config/site';
import { useTranslations } from '../i18n';
import { navLinks, isCurrent } from '../lib/nav';
import Icon from './Icon.astro';

export interface Props {
  /** true = Menü (mit Schließen-Knopf), false = Startseite */
  overlay?: boolean;
}

const { overlay = false } = Astro.props;
const t = useTranslations();
const links = await navLinks();
const path = Astro.url.pathname;
const hasAside = Astro.slots.has('aside');

/* Optischer Ausgleich einzelner Buchstabenpaare im Namen (Großbuchstaben in Instrument Serif), in em: zusätzlicher
   Abstand nach dem ersten Buchstaben des Paars. „S–K“ und „D–O–R“ standen zu luftig, „R–N“ berührten sich fast. */
// Für Climate Crisis nicht nötig. Werte für Instrument Serif: { SK: -0.025, DO: -0.03, OR: -0.035, RN: 0.015 }
const KERN: Record<string, number> = {};
/* Der Name Wort für Wort (am Handy steht jedes Wort in einer eigenen Zeile), darin Zeichen mit Ausgleich */
const nameWords = site.name.split(' ').map((word) =>
  [...word].map((ch, i, all) => ({ ch, kern: KERN[(ch + (all[i + 1] ?? '')).toUpperCase()] })),
);
---

<div class:list={['bm', 'container', { 'bm--overlay': overlay, 'bm--aside': hasAside }]}>
  {
    overlay && (
      <div class="bm-top">
        <button class="bm-close" type="button" popovertarget="site-menu" popovertargetaction="hide" aria-label={t.nav.close}>
          <Icon name="close" size={28} />
        </button>
      </div>
    )
  }
  {
    overlay ? (
      <a class="bm-name display" href="/">
        {nameWords.map((w, i) => (
          <>
            {i > 0 && ' '}
            <span class={`bm-w bm-w--${i + 1}`}>
              {w.map((p) => (p.kern ? <span style={`letter-spacing:calc(-0.01em + ${p.kern}em)`}>{p.ch}</span> : p.ch))}
            </span>
          </>
        ))}
      </a>
    ) : (
      <h1 class="bm-name display">
        {nameWords.map((w, i) => (
          <>
            {i > 0 && ' '}
            <span class={`bm-w bm-w--${i + 1}`}>
              {w.map((p) => (p.kern ? <span style={`letter-spacing:calc(-0.01em + ${p.kern}em)`}>{p.ch}</span> : p.ch))}
            </span>
          </>
        ))}
      </h1>
    )
  }
  <div class="bm-body">
    <nav aria-label={t.nav.label}>
      <ul class="bm-list" role="list">
      {
        links.map((l) => (
          <li>
            <a class="display tap" href={l.href} aria-current={isCurrent(path, l.match) ? 'page' : undefined}>
              {l.label}
            </a>
          </li>
        ))
      }
      </ul>
    </nav>
    {
      hasAside && (
        <div class="bm-aside">
          <slot name="aside" />
        </div>
      )
    }
  </div>
  {/* Unten nur Instagram – auf der Startseite und im Menü gleich. Impressum und Datenschutz stehen in der Fußzeile
       jeder Unterseite (das Menü öffnet sich nur auf Unterseiten). */}
  <p class="bm-foot">
    <a class="bm-insta tap" href={site.instagram.url} rel="me noopener" target="_blank">
      <Icon name="instagram" size="0.9em" /> {site.instagram.handle.toLowerCase()}
    </a>
  </p>
</div>


<style>
  /* Farbfläche über den ganzen Bildschirm; Inhalt von oben nach unten: Name, Menü, Fußzeile */
  .bm {
    /* Schriftgröße der Menüpunkte */
    --bm-item: clamp(2.3rem, 10.5vw, 4.75rem);
    /* Farbe und Schriftgröße des Namens (auch fürs Foto am Handy gebraucht) */
    --name-color: var(--on-menu);
    /* „JESKO DORNER“ ist in Climate Crisis 11,02 Schrifthöhen breit → / 12.4 füllt knapp 90 % der Breite
       (Instrument Serif war 5,22 breit: min(11rem, 100cqi / 5.9)) */
    --name-fs: min(6.5rem, 100cqi / 12.4);
    /* oberer Seitenrand (Laptop: auch der Abstand des Fotos nach oben) */
    --bm-pad: clamp(1.25rem, 4vw, 2.5rem);
    container-type: inline-size;
    display: flex;
    flex-direction: column;
    min-height: 100%;
    /* unterer Seitenrand (Laptop: auch der Abstand im blauen Streifen über der Fußzeile) */
    --foot-pad: max(1.5rem, env(safe-area-inset-bottom));
    padding-block: var(--bm-pad) var(--foot-pad);
    color: var(--on-menu);
  }
  /* Im Menü: oben eine Leiste so hoch wie der Header, der Schließen-Knopf sitzt an der Stelle des Menüknopfs */
  .bm--overlay {
    padding-top: 0;
  }
  .bm-top {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    height: var(--header-h);
    margin-bottom: clamp(0.25rem, 2vw, 1rem);
  }
  /* Schließen-Knopf wie der Menüknopf auf den Unterseiten: korallenroter Kreis (auf Weiß sichtbar) */
  .bm-close {
    display: inline-grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border: 0;
    border-radius: 50%;
    background: var(--pink);
    color: var(--ink);
    cursor: pointer;
    transition:
      background-color 0.2s,
      color 0.2s,
      scale 0.15s var(--ease);
  }
  .bm-close:active {
    scale: 0.94;
  }
  .bm-close:hover {
    background: var(--ink);
    color: var(--pink);
  }
  /* Name: eine Zeile, so breit wie der Platz (aber nicht riesig), in --name-color (Schriftfarbe des Menüs). Im Menü ist er ein Link zur Startseite
     und bekommt beim Überfahren dasselbe rosa Feld wie die Menüpunkte. */
  .bm-name {
    display: block;
    width: fit-content;
    font-size: var(--name-fs);
    line-height: 0.9;
    white-space: nowrap;
    font-family: var(--font-name);
    font-weight: 400;
    letter-spacing: 0;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--name-color);
    /* etwas Luft rundum (rosa Feld beim Überfahren im Menü, Bogen des „J“ in Instrument Serif) – ohne das Layout
       zu ändern */
    padding: 0.08em 0.12em 0.15em;
    margin: 0 -0.12em -0.15em;
    transition:
      background-color 0.2s,
      color 0.2s;
  }
  a.bm-name:hover {
    background: var(--pink);
    color: var(--ink);
  }
  /* Jedes Wort ein eigener Kasten, genau so groß wie das Wort (wie im Logo der Kopfzeile, Header.astro): Beim
     Seitenwechsel gleitet jedes Wort für sich an seinen Platz im Logo und wird dabei nur gleichmäßig kleiner. */
  .bm-name :global(.bm-w) {
    display: inline-block;
  }
  .bm-name :global(.bm-w--1) {
    view-transition-name: jd-name-1;
  }
  .bm-name :global(.bm-w--2) {
    view-transition-name: jd-name-2;
  }
  /* Menüpunkte: deutlich kleiner als der Name, mit Luft dazwischen */
  /* Menüpunkte, dazu optional das Bildfeld (Slot „aside“). Handy: Bildfeld mittig im freien Platz darunter. */
  .bm-body {
    flex: 1;
    display: flex;
    flex-direction: column;
    margin-top: clamp(2.5rem, 9vh, 6rem);
  }
  .bm-aside {
    display: grid;
  }
  /* Handy – Menü und Startseite: Raster mit drei Spalten. Die mittlere ist genau so breit wie der Name, so steht er
     mittig und die Menüpunkte beginnen an seiner linken Kante. Reihen: Foto (Startseite) bzw. Schließen-Knopf
     (Menü) · Name · (frei) · Menüpunkte · Fußzeile (mittig ganz unten). Die Startseite
     nutzt dasselbe Raster bis 999 px (Regeln weiter unten). */
  @media (max-width: 699.98px) {
    .bm {
      /* Name zweizeilig („JESKO“ / „DORNER“): „DORNER“ ist 6,15 Schrifthöhen breit → / 6.9 füllt knapp 90 % */
      --name-fs: min(6.5rem, 100cqi / 6.9);
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
      /* Foto bzw. Schließen-Knopf · Name · (frei, früher „Fotografie“) · Menüpunkte · Fußzeile */
      grid-template-rows: auto auto auto 1fr auto;
    }
    .bm .bm-foot {
      grid-row: 5;
    }
    .bm > * {
      grid-column: 1 / -1;
    }
    .bm .bm-name {
      grid-column: 2;
      grid-row: 2;
    }
    /* jedes Wort in einer eigenen Zeile (Kasten so breit wie das Wort, nicht wie die Zeile) */
    .bm-name :global(.bm-w) {
      display: block;
      width: fit-content;
    }
    .bm-body {
      display: contents;
    }
    /* Menü mittig zwischen Name und Fußzeile: gleich viel Luft zwischen den sichtbaren Buchstaben von „DORNER“,
       den Menüpunkten und „Impressum“. Die Mindestabstände gleichen aus, dass die Schriften unterschiedlich weit in
       ihren Zeilen sitzen. */
    .bm-body > nav {
      grid-column: 2;
      grid-row: 4;
      align-self: center;
      /* um 0,07 Schrifthöhen nach unten geschoben: „KONTAKT“ sitzt höher in seiner Zeile als „DORNER“ */
      margin-block: calc(1.5rem + 0.07 * var(--bm-item)) calc(1.5rem - 0.07 * var(--bm-item));
    }
    /* .bm davor: sonst gewinnt die allgemeine Regel (padding-top 2,5rem), die weiter unten steht */
    .bm .bm-foot {
      justify-content: center;
      padding-top: 0;
    }
  }
  @media (min-width: 700px) {
    .bm-body {
      flex: none;
    }
  }

  /* ---------- Startseite „Bild neben Name“ – und das Menü genauso, nur ohne Foto ---------- */
  /* Das Menü (Overlay) übernimmt Aufbau und Größen der Startseite: Name und Menüpunkte stehen an derselben Stelle und
     sind gleich groß, statt des Fotos ist dort Blau. So wirkt das Öffnen des Menüs wie die Startseite.
     Handy und Tablet hochkant (bis 999 px): dasselbe Raster wie das Menü am Handy. Foto (Menü: Leiste mit dem
     Schließen-Knopf) ganz oben, randlos mit harten Kanten, darunter seine Bildunterschrift; dann Name, Menü (mittig
     im freien Platz) und Instagram. */
  @media (max-width: 999.98px) {
    :is(.bm--aside, .bm--overlay) {
      --name-fs: min(6.5rem, 100cqi / 6.9);
      /* Menü etwa halb bis zwei Drittel so groß wie der Name: klare Rangfolge */
      --bm-item: clamp(2rem, 8.6vw, 3.4rem);
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
      grid-template-rows: auto auto auto 1fr auto;
    }
    :is(.bm--aside, .bm--overlay) > * {
      grid-column: 1 / -1;
    }
    :is(.bm--aside, .bm--overlay) .bm-name {
      grid-column: 2;
      grid-row: 2;
      margin-top: clamp(1.75rem, 5svh, 3rem);
    }
    :is(.bm--aside, .bm--overlay) .bm-name :global(.bm-w) {
      display: block;
      width: fit-content;
    }
    :is(.bm--aside, .bm--overlay) .bm-body {
      display: contents;
    }
    :is(.bm--aside, .bm--overlay) .bm-body > nav {
      grid-column: 2;
      grid-row: 4;
      align-self: center;
      margin-block: calc(1.5rem + 0.07 * var(--bm-item)) calc(1.5rem - 0.07 * var(--bm-item));
    }
    /* kleinere Menüpunkte: Abstand so, dass jede Zeile mindestens 44 px Tippfläche hat (Zeile 0,95 Schrifthöhen) */
    :is(.bm--aside, .bm--overlay) .bm-list {
      gap: max(clamp(0.35rem, 1.2vh, 0.9rem), 2.75rem - 0.95 * var(--bm-item));
    }
    .bm--aside .bm-aside {
      grid-column: 1 / -1;
      grid-row: 1;
      margin-inline: calc(-1 * var(--gutter));
      margin-top: calc(-1 * var(--bm-pad)); /* bis an den oberen Bildschirmrand */
    }
    /* Foto 4:3 über die ganze Breite, auf niedrigen Bildschirmen flacher (nichts soll scrollen) */
    .bm--aside .bm-aside :global(.hs) {
      height: auto;
      gap: 0.75rem;
    }
    .bm--aside .bm-aside :global(.hs-frame) {
      height: min(75vw, 34svh);
    }
    .bm--aside .bm-aside :global(.hs-cap) {
      padding-inline: var(--gutter);
    }
    /* Menü: oben die Leiste mit dem Schließen-Knopf (an der Stelle des Menüknopfs), der Name direkt darunter */
    .bm--overlay .bm-top {
      grid-row: 1;
    }
    :is(.bm--aside, .bm--overlay) .bm-foot {
      grid-row: 5;
      justify-content: center;
      padding-top: 0;
    }
  }
  /* Niedrige Handys (z. B. iPhone SE): etwas enger, damit die Startseite ohne Scrollen auf einen Bildschirm passt */
  @media (max-width: 999.98px) and (max-height: 700px) {
    :is(.bm--aside, .bm--overlay) {
      --bm-item: clamp(1.8rem, 8vw, 3.4rem);
    }
    :is(.bm--aside, .bm--overlay) .bm-name {
      margin-top: 1.25rem;
    }
    .bm--aside .bm-aside :global(.hs-frame) {
      height: min(75vw, 28svh);
    }
    :is(.bm--aside, .bm--overlay) .bm-body > nav {
      margin-block: calc(0.9rem + 0.07 * var(--bm-item)) calc(1.4rem - 0.07 * var(--bm-item));
    }
  }
  @media (max-width: 999.98px) {
    .bm--overlay .bm-name {
      margin-top: 0;
    }
  }
  /* Laptop (ab 1000 px): zwei Spalten. Links (5/12) Name zweizeilig, unten Menü und Instagram;
     rechts (7/12) das Foto über die ganze Höhe mit Bildunterschrift (Menü: Blau). Genau ein Bildschirm hoch. */
  @media (min-width: 1000px) {
    :is(.bm--aside, .bm--overlay) {
      --col-gap: clamp(2.5rem, 4vw, 4.5rem);
      /* „DORNER“ ist 6,15 Schrifthöhen breit → / 6.4 füllt die linke Spalte fast ganz */
      --name-fs: min(7.5rem, (100cqi - var(--col-gap)) * 5 / 12 / 6.4);
      --bm-item: calc(var(--name-fs) * 0.54);
      display: grid;
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      grid-template-rows: auto auto 1fr auto auto;
      column-gap: var(--col-gap);
      height: 100dvh;
      min-height: 0;
    }
    :is(.bm--aside, .bm--overlay) .bm-name {
      grid-column: 1;
      grid-row: 1;
    }
    :is(.bm--aside, .bm--overlay) .bm-name :global(.bm-w) {
      display: block;
      width: fit-content;
    }
    :is(.bm--aside, .bm--overlay) .bm-body {
      display: contents;
    }
    :is(.bm--aside, .bm--overlay) .bm-body > nav {
      grid-column: 1;
      grid-row: 4;
    }
    /* Unter der letzten Zeile („KONTAKT“) liegen 0,128 Schrifthöhen Luft bis zum Zeilenende (gemessen) – um genau so
       viel ragt das Menü nach unten, damit die Grundlinie von „KONTAKT“ auf der Unterkante des Fotos liegt */
    :is(.bm--aside, .bm--overlay) .bm-body > nav {
      margin-bottom: calc(-0.128 * var(--bm-item));
    }
    /* Foto mit Bildunterschrift rechts neben Name und Menü: Die untere Zeile der Bildunterschrift („Monat · Mappe
       ansehen →“) endet auf derselben Grundlinie wie „KONTAKT“; das Foto steht darüber. Unter beiden nur Instagram.
       Unter der Zeile „Monat · …“ liegen 0,33 ihrer Schrifthöhen bis zur Unterkante – um so viel ragt der Block nach
       unten (gemessen). */
    .bm--aside .bm-aside {
      display: contents;
    }
    .bm--aside .bm-aside :global(.hs) {
      grid-column: 2;
      grid-row: 1 / 5;
      height: auto;
      min-height: 0;
      margin-bottom: calc(-0.33 * var(--fs-xs));
    }
    /* Menü: oben derselbe Abstand wie auf der Startseite; der Schließen-Knopf liegt darüber an der Stelle des
       Menüknopfs, ohne den Namen nach unten zu schieben */
    .bm--overlay {
      position: relative;
      padding-top: var(--bm-pad);
    }
    /* so breit wie die Kopfzeile (container--wide, bis 2400 px), damit der Knopf auch auf sehr breiten Bildschirmen
       genau auf dem Menüknopf liegt – das Menü selbst ist schmaler (container, bis 1760 px) */
    .bm--overlay .bm-top {
      position: absolute;
      top: 0;
      left: 50%;
      translate: -50% 0;
      width: 100vw;
      max-width: 2400px;
      margin: 0;
      padding-inline: var(--gutter);
    }
    /* Instagram und die untere Zeile der Bildunterschrift stehen auf derselben Grundlinie */
    :is(.bm--aside, .bm--overlay) .bm-foot {
      grid-column: 1;
      grid-row: 5;
      align-self: last baseline;
      padding-top: clamp(1.25rem, 3vh, 2rem);
    }
  }
  .bm-list {
    view-transition-name: jd-menu;
    list-style: none;
    padding: 0;
    display: grid;
    gap: clamp(0.35rem, 1.2vh, 0.9rem);
  }
  /* Menüpunkte als Blöcke: jede Zeile ist genau 0,95 Schrifthöhen hoch, so lässt sich das Bildfeld exakt an der
     Schrift ausrichten (Handy: Fotokante hinter „Kontakt“, Laptop: Ober-/Unterkante der Buchstaben) */
  .bm-list a {
    display: block;
    width: fit-content;
    font-size: var(--bm-item);
    line-height: 0.95;
    text-transform: uppercase;
    font-style: italic;
    /* Bodoni Moda: optische Größe einer Lesegröße statt der Plakatgröße – die Haarstriche bleiben kräftig genug,
       um auf dem Foto und auf Ultramarin stehen zu bleiben */
    font-variation-settings: 'opsz' 24;
    text-decoration: none;
    color: inherit;
  }
  /* „Portfolio“ hebt sich ab: als einziger Punkt gerade, die anderen kursiv */
  .bm-list a[href='/portfolio/'] {
    font-style: normal;
  }
  /* Aktueller Punkt (im Menü auf Unterseiten): unterstrichen. Überfahren: rosa Feld mit schwarzer Schrift. Das Feld steht
     links und rechts ein klein wenig über, die Schrift bleibt an ihrem Platz. */
  .bm-list a {
    padding-inline: 0.06em;
    margin-inline: -0.06em;
    transition:
      background-color 0.2s,
      color 0.2s;
  }
  .bm-list a[aria-current='page'] {
    text-decoration: underline;
    text-decoration-thickness: 0.07em;
    text-underline-offset: 0.1em;
  }
  .bm-list a:hover {
    background-color: var(--pink);
    color: var(--ink);
  }
  .bm-foot {
    view-transition-name: jd-menu-foot;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 0.6rem;
    margin-top: auto;
    padding-top: 2.5rem;
  }
  /* Instagram wie in der Fußzeile jeder Seite: Symbol + „jeskodorner“, aber klein – etwa so groß wie
     „Mappe ansehen →“ unter dem Foto; beim Überfahren rosa hinterlegt wie die Menüpunkte */
  .bm-foot a {
    color: inherit;
  }
  .bm-insta {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    font-size: 0.875rem;
    font-weight: 650;
    line-height: 1.3;
    text-decoration: none;
  }
  .bm-foot a:hover {
    background: var(--pink);
    color: var(--ink);
    text-decoration-color: currentColor;
  }
  .bm a:focus-visible,
  .bm-close:focus-visible {
    outline: 3px solid var(--on-menu);
    outline-offset: 4px;
  }
</style>
