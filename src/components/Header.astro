---
import { site } from '../config/site';
import { useTranslations } from '../i18n';
import { navLinks, isCurrent as current } from '../lib/nav';
import Icon from './Icon.astro';
import BlueMenu from './BlueMenu.astro';

const t = useTranslations();
const path = Astro.url.pathname;
const links = await navLinks();
const isCurrent = (match: string[]) => current(path, match);
---

<header class="site-header">
  <div class="bar container container--wide">
    <a class="logo" href="/" aria-label={`${site.name} – ${t.nav.home}`}>
      <span class="logo-text">Jesko Dorner</span>
    </a>

    <nav class="nav-desktop" aria-label={t.nav.label}>
      <ul>
        {
          links.map((l) => (
            <li>
              <a href={l.href} aria-current={isCurrent(l.match) ? 'page' : undefined}>
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <button class="menu-btn" type="button" popovertarget="site-menu" aria-label={t.nav.menu}>
      <Icon name="menu" size={28} />
    </button>
  </div>

  <div id="site-menu" class="menu c-blue" popover>
    <BlueMenu overlay />
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    height: var(--header-h);
    display: flex;
    align-items: center;
    background: rgb(255 255 255 / 0.9);
    backdrop-filter: blur(14px) saturate(1.4);
    -webkit-backdrop-filter: blur(14px) saturate(1.4);
    view-transition-name: site-header;
  }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
  }
  .logo {
    display: inline-flex;
    align-items: baseline;
    text-decoration: none;
    white-space: nowrap;
    font-family: var(--font-display);
    font-weight: 900;
    font-stretch: 75%;
    text-transform: uppercase;
    font-size: clamp(1.6rem, 1.3rem + 1.07vw, 2.25rem);
    line-height: 1;
    letter-spacing: -0.01em;
  }
  .logo:hover {
    color: var(--ink);
  }
  /* Übergang: der große Name der Startseite gleitet ins Logo (und zurück). Bei offenem Handy-Menü trägt der
     Name im Menü diesen Übergangsnamen – dann hier keiner, sonst gäbe es ihn doppelt. */
  .logo-text {
    view-transition-name: jd-name;
  }
  :global(html:has(#site-menu:popover-open)) .logo-text {
    view-transition-name: none;
  }
  .nav-desktop {
    display: none;
    margin-left: auto;
  }
  .nav-desktop ul {
    display: flex;
    gap: 0.35rem;
    list-style: none;
    padding: 0;
  }
  .nav-desktop a {
    display: inline-block;
    padding: 0.45rem 0.95rem;
    border-radius: 999px;
    font-size: var(--fs-sm);
    font-weight: 750;
    font-stretch: 85%;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    text-decoration: none;
    transition:
      background-color 0.2s,
      color 0.2s;
  }
  .nav-desktop a:hover {
    background: var(--lime);
    color: var(--ink);
  }
  .nav-desktop a[aria-current='page'] {
    background: var(--ink);
    color: var(--wall);
  }

  .menu-btn {
    display: inline-grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border: 0;
    border-radius: 50%;
    background: var(--lime);
    color: var(--ink);
  }

  @media (min-width: 820px) {
    .nav-desktop {
      display: block;
    }
    .menu-btn {
      display: none;
    }
  }

  /* Mobiles Menü als Popover (funktioniert ohne JavaScript), Inhalt: BlueMenu.astro.
     So hoch wie der größte Bildschirmbereich (lvh): kein Streifen der Seite darunter, auch wenn die
     Adressleiste im Handy-Browser eingeklappt ist. Dahinter lässt sich nicht scrollen. */
  .menu {
    position: fixed;
    inset: 0 0 auto;
    width: 100%;
    height: 100vh;
    height: 100lvh;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    overflow-y: auto;
    overscroll-behavior: contain;
    background: var(--c);
    color: var(--on-c);
  }
  .menu > :global(.bm) {
    min-height: 100dvh;
  }
  :global(html:has(#site-menu:popover-open)) {
    overflow: hidden;
  }
  @media (prefers-reduced-motion: no-preference) {
    .menu:popover-open {
      animation: menu-in 0.45s var(--ease);
    }
  }
  @keyframes menu-in {
    from {
      clip-path: circle(0% at calc(100% - 2.5rem) 2rem);
    }
    to {
      clip-path: circle(150% at calc(100% - 2.5rem) 2rem);
    }
  }
  /* Fallback für Browser ohne Popover-API: Links immer sichtbar */
  @supports not selector(:popover-open) {
    .nav-desktop {
      display: block;
    }
    .nav-desktop ul {
      flex-wrap: wrap;
    }
    .menu-btn,
    .menu {
      display: none;
    }
  }

  /* Kompakter Header beim Scrollen */
  @supports (animation-timeline: scroll()) {
    @media (prefers-reduced-motion: no-preference) {
      .site-header {
        animation-name: header-compact;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: scroll(root);
        animation-range: 0 200px;
      }
    }
  }
  @keyframes header-compact {
    to {
      height: calc(var(--header-h) - 1rem);
      box-shadow: 0 1px 0 var(--line);
    }
  }
</style>
