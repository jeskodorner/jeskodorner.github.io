---
import { getCollection } from 'astro:content';
import { site } from '../config/site';
import { useTranslations } from '../i18n';
import Icon from './Icon.astro';

const t = useTranslations();
const hasFilms = (await getCollection('films')).length > 0;
const path = Astro.url.pathname;

const links = [
  { href: '/galerien/', label: t.nav.galleries, match: ['/galerien/', '/g/'] },
  ...(hasFilms ? [{ href: '/film/', label: t.nav.film, match: ['/film/'] }] : []),
  { href: '/ueber-mich/', label: t.nav.about, match: ['/ueber-mich/'] },
  { href: '/kontakt/', label: t.nav.contact, match: ['/kontakt/'] },
];
const isCurrent = (match: string[]) => match.some((m) => path.startsWith(m));
---

<header class="site-header">
  <div class="bar container container--wide">
    <a class="logo" href="/" aria-label={`${site.name} – ${t.nav.home}`}>
      <span class="logo-dot" aria-hidden="true"></span>
      <span class="logo-text">Jesko Dorner</span>
    </a>

    <nav class="nav-desktop" aria-label={t.nav.label}>
      <ul>
        {
          links.map((l) => (
            <li>
              <a href={l.href} aria-current={isCurrent(l.match) ? 'page' : undefined}>
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <button class="menu-btn" type="button" popovertarget="site-menu" aria-label={t.nav.menu}>
      <Icon name="menu" size={28} />
    </button>
  </div>

  <div id="site-menu" class="menu c-blue" popover>
    <div class="menu-inner container">
      <div class="menu-top">
        <span class="label">{t.nav.menu}</span>
        <button class="menu-close" type="button" popovertarget="site-menu" popovertargetaction="hide" aria-label={t.nav.close}>
          <Icon name="close" size={30} />
        </button>
      </div>
      <nav aria-label={t.nav.label}>
        <ul>
          <li><a class="display" href="/" aria-current={path === '/' ? 'page' : undefined}>{t.nav.home}</a></li>
          {
            links.map((l) => (
              <li>
                <a class="display" href={l.href} aria-current={isCurrent(l.match) ? 'page' : undefined}>
                  {l.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
      <p class="menu-foot label">
        <a href={site.instagram.url} rel="me noopener" target="_blank">@{site.instagram.handle}</a>
      </p>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    height: var(--header-h);
    display: flex;
    align-items: center;
    background: rgb(255 255 255 / 0.9);
    backdrop-filter: blur(14px) saturate(1.4);
    -webkit-backdrop-filter: blur(14px) saturate(1.4);
    view-transition-name: site-header;
  }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
  }
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    text-decoration: none;
    white-space: nowrap;
    font-family: var(--font-display);
    font-weight: 900;
    font-stretch: 75%;
    text-transform: uppercase;
    font-size: clamp(1.35rem, 1.1rem + 0.9vw, 1.9rem);
    line-height: 1;
    letter-spacing: -0.01em;
  }
  .logo:hover {
    color: var(--ink);
  }
  .logo-dot {
    width: 0.8em;
    height: 0.8em;
    border-radius: 50%;
    background: var(--pink);
    transition:
      background-color 0.3s,
      scale 0.4s var(--pop);
  }
  .logo:hover .logo-dot {
    background: var(--lime);
    scale: 1.35;
  }

  .nav-desktop {
    display: none;
    margin-left: auto;
  }
  .nav-desktop ul {
    display: flex;
    gap: 0.35rem;
    list-style: none;
    padding: 0;
  }
  .nav-desktop a {
    display: inline-block;
    padding: 0.45rem 0.95rem;
    border-radius: 999px;
    font-size: var(--fs-sm);
    font-weight: 750;
    font-stretch: 85%;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    text-decoration: none;
    transition:
      background-color 0.2s,
      color 0.2s,
      rotate 0.3s var(--pop);
  }
  .nav-desktop a:hover {
    background: var(--lime);
    color: var(--ink);
    rotate: -3deg;
  }
  .nav-desktop a[aria-current='page'] {
    background: var(--ink);
    color: var(--wall);
  }

  .menu-btn,
  .menu-close {
    display: inline-grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border: 0;
    border-radius: 50%;
    background: var(--lime);
    color: var(--ink);
  }
  .menu-close {
    background: var(--wall);
  }

  @media (min-width: 820px) {
    .nav-desktop {
      display: block;
    }
    .menu-btn {
      display: none;
    }
  }

  /* Mobiles Menü als Popover (funktioniert ohne JavaScript) */
  .menu {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: var(--c);
    color: var(--on-c);
  }
  .menu-inner {
    min-height: 100%;
    display: flex;
    flex-direction: column;
    padding-block: 1rem 2rem;
  }
  .menu-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    height: calc(var(--header-h) - 0.5rem);
  }
  .menu ul {
    list-style: none;
    padding: 0;
    margin-top: 5vh;
    display: grid;
    gap: 0.2rem;
  }
  .menu ul a {
    font-size: clamp(3.5rem, 17vw, 6.5rem);
    text-decoration: none;
  }
  .menu ul a:hover,
  .menu ul a[aria-current='page'] {
    color: var(--lime);
  }
  .menu-foot {
    margin-top: auto;
  }
  @media (prefers-reduced-motion: no-preference) {
    .menu:popover-open {
      animation: menu-in 0.45s var(--ease);
    }
  }
  @keyframes menu-in {
    from {
      clip-path: circle(0% at calc(100% - 2.5rem) 2rem);
    }
    to {
      clip-path: circle(150% at calc(100% - 2.5rem) 2rem);
    }
  }
  /* Fallback für Browser ohne Popover-API: Links immer sichtbar */
  @supports not selector(:popover-open) {
    .nav-desktop {
      display: block;
    }
    .nav-desktop ul {
      flex-wrap: wrap;
    }
    .menu-btn,
    .menu {
      display: none;
    }
  }

  /* Kompakter Header beim Scrollen */
  @supports (animation-timeline: scroll()) {
    @media (prefers-reduced-motion: no-preference) {
      .site-header {
        animation-name: header-compact;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: scroll(root);
        animation-range: 0 200px;
      }
    }
  }
  @keyframes header-compact {
    to {
      height: calc(var(--header-h) - 1rem);
      box-shadow: 0 1px 0 var(--line);
    }
  }
</style>
