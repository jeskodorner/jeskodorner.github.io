---
/** Gemeinsame Vorlage für öffentliche (/galerien/…) und unlisted (/g/…) Galerien. */
import { render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import GalleryGrid from './GalleryGrid.astro';
import ShareBox from './ShareBox.astro';
import DownloadBox from './DownloadBox.astro';
import AlbumRequest from './AlbumRequest.astro';
import Icon from './Icon.astro';
import Picture from './Picture.astro';
import NeighbourNav from './NeighbourNav.astro';
import { getNeighbours, type Gallery } from '../lib/galleries';
import { responsive } from '../lib/images';
import { cardImage } from '../lib/og';
import { useTranslations, formatMonth } from '../i18n';
import { site } from '../config/site';
import { tidyTitle } from '../lib/text';

export interface Props {
  gallery: Gallery;
}

const { gallery } = Astro.props;
const t = useTranslations();
const { prev, next } = await getNeighbours(gallery);
const og = cardImage(`album/${gallery.slug}`, gallery.cover.alt);
const absUrl = new URL(gallery.url, Astro.site ?? site.url).href;
const hasBody = Boolean(gallery.entry.body?.trim());
const { Content } = hasBody ? await render(gallery.entry) : { Content: null };
// Ausschnitt des Fotos im Band oben: `focus` aus index.md, sonst bei Hochformaten das obere Drittel (dort sind meist
// die Gesichter – mittig schnitt das breite Band sie oft ab), bei Querformaten die Mitte
const coverFocus =
  gallery.entry.data.images.find((i) => i.file === gallery.cover.file)?.focus ??
  (gallery.cover.src.height > gallery.cover.src.width ? '50% 22%' : '50% 50%');
// Dichte des grauen Filters nach der Helligkeit des Fotos (mittlere Farbe aus meta.json): dunkle Nachtfotos (Dollgow)
// bekommen weniger Filter, sonst wären sie fast schwarz; helle Fotos mehr, damit die helle Schrift lesbar bleibt
const luminance = (hex?: string) => {
  const m = /^#([0-9a-f]{6})$/i.exec(hex ?? '');
  if (!m) return undefined;
  const [r, g, b] = [0, 2, 4].map((i) => parseInt(m[1]!.slice(i, i + 2), 16) / 255).map((x) => (x <= 0.03928 ? x / 12.92 : ((x + 0.055) / 1.055) ** 2.4));
  return 0.2126 * r! + 0.7152 * g! + 0.0722 * b!;
};
const lum = luminance(gallery.cover.color);
const bandAlpha = lum === undefined ? 0.8 : Math.min(0.8, Math.max(0.45, lum * 5));

// Strukturierte Daten nur für öffentliche Galerien
const jsonLd = gallery.isUnlisted
  ? undefined
  : {
      '@context': 'https://schema.org',
      '@type': 'ImageGallery',
      name: gallery.title,
      description: gallery.description,
      url: absUrl,
      dateCreated: gallery.date.toISOString().slice(0, 10),
      ...(gallery.location ? { locationCreated: { '@type': 'Place', name: gallery.location } } : {}),
      author: { '@type': 'Person', name: site.name, url: site.url },
      image: await Promise.all(
        gallery.images.map(async (img) => {
          const set = await responsive(img.src);
          const v = set.webpVariants.find((x) => x.width >= 1200) ?? set.largest;
          return {
            '@type': 'ImageObject',
            contentUrl: new URL(v.url, site.url).href,
            url: new URL(img.hashUrl, site.url).href,
            name: img.caption ?? img.alt,
            description: img.alt,
            creator: { '@type': 'Person', name: site.name },
            creditText: site.name,
            copyrightNotice: `© ${site.name}`,
            acquireLicensePage: new URL('/kontakt/', site.url).href,
          };
        }),
      ),
    };
---

<BaseLayout
  title={gallery.title}
  description={gallery.description}
  image={og}
  noindex={gallery.isUnlisted}
  noReferrer={gallery.isUnlisted}
  jsonLd={jsonLd}
>
  <article class={`c-${gallery.color}`}>
    {/* Band oben mit dem Vorschaubild der Galerie als Hintergrund, darüber ein grauer Filter, darauf Zurück, Datum,
        Titel und Beschreibung in heller Schrift (seit 22.11.2026; vorher ein Band in June Bud nur mit Text, Git-Tag
        alte-version-album-band). Das Foto ist nur Hintergrund (aria-hidden), im Album steht es noch einmal. */}
    <header class="g-band g-band--photo" style={`--band-a:${bandAlpha.toFixed(2)}`}>
      <div class="g-band-bg" aria-hidden="true">
        <Picture
          src={gallery.cover.src}
          alt=""
          sizes="100vw"
          color={gallery.cover.color}
          lqip={gallery.cover.lqip}
          loading="eager"
          fetchpriority="high"
          class="g-band-img"
          style={`object-position:${coverFocus}`}
        />
      </div>
      <div class="container container--wide g-band-inner">
        {
          !gallery.isUnlisted && (
            /* „Zurück“ dorthin, wo man herkam; ohne Vorgeschichte an die Stelle dieses Albums in der Übersicht
               (src/scripts/back-link.ts) */
            <a class="back btn btn--small" href={`/galerien/#album-${gallery.slug}`} data-back>
              <Icon name="arrow-left" /> {t.back}
            </a>
          )
        }
        <div class="g-text">
          {/* Nur das Datum (bis 20.11.2026 auch Anzahl der Fotos und Ort; der Ort steht weiter unsichtbar für
              Suchmaschinen in den Strukturdaten oben) */}
          <p class="label meta-row">
            <span>{formatMonth(gallery.date)}</span>
          </p>
          <h1 class="display display-1 display-compact title" style={`view-transition-name: gt-${gallery.slug}`}>{tidyTitle(gallery.title)}</h1>
          <p class="band-lead">{gallery.description}</p>
        </div>
      </div>
    </header>

    {
      (Content || (!gallery.albumRequest && gallery.download) || gallery.isUnlisted) && (
        <div class="g-head container container--wide">
          <div class="intro rise">
            {
              Content && (
                <div class="text prose body">
                  <Content />
                </div>
              )
            }
            {/* Kundengalerie mit Download: bleibt oben, danach suchen Kunden zuerst */}
            {!gallery.albumRequest && gallery.download && <div class="side"><DownloadBox {...gallery.download} /></div>}
          </div>

          {
            gallery.isUnlisted && (
              <p class="private">
                <Icon name="lock" /> {t.galleries.unlisted}
              </p>
            )
          }
        </div>
      )
    }

    <section
      class="grid-wrap"
      aria-label={t.galleries.images(gallery.images.length)}
    >
      <GalleryGrid gallery={gallery} />
    </section>

    {/* Unter den Fotos, bewusst ruhig: ganzes Album anfordern und teilen */}
    <footer class="g-foot container container--wide">
      {gallery.albumRequest && <AlbumRequest title={gallery.title} url={gallery.download?.url} note={gallery.download?.note} />}
      <ShareBox url={absUrl} title={gallery.title} template={gallery.shareText} compact />
    </footer>
  </article>

  <NeighbourNav
    label="Weitere Galerien"
    prevLabel={t.galleries.prev}
    nextLabel={t.galleries.next}
    prev={prev && { url: prev.url, title: prev.title, img: { src: prev.cover.src, color: prev.cover.color, lqip: prev.cover.lqip } }}
    next={next && { url: next.url, title: next.title, img: { src: next.cover.src, color: next.cover.color, lqip: next.cover.lqip } }}
  />
</BaseLayout>

<script>
  import { initBackLinks } from '../scripts/back-link';
  initBackLinks();
</script>

<style>
  /* Band mit Foto (seit 22.11.2026): das Vorschaubild füllt das Band (beschnitten, Ausschnitt nach `focus`), darüber
     ein grauer Filter (--band-filter), damit die helle Schrift darauf immer lesbar ist. Oben „Zurück“, unten Datum,
     Titel und Beschreibung. Etwas höher als das alte Textband, damit vom Foto etwas zu sehen ist – die Fotos des
     Albums beginnen trotzdem auf dem ersten Bildschirm. */
  .g-band {
    /* Grauer Filter: nach unten dichter, wo Titel und Beschreibung stehen – auch helle, unruhige Fotos (Schulstreik)
       bleiben so lesbar. Wie dicht, hängt von der Helligkeit des Fotos ab (--band-a, oben berechnet, 0,45–0,8) */
    --band-a: 0.8;
    --band-filter: linear-gradient(
      rgb(38 36 34 / calc(var(--band-a) * 0.55)),
      rgb(38 36 34 / calc(var(--band-a) * 0.8)) 45%,
      rgb(38 36 34 / var(--band-a))
    );
    /* Fokusrahmen auf dem dunklen Foto hell statt blau */
    --accent: var(--wall);
    position: relative;
    isolation: isolate;
    overflow: hidden;
    color: var(--wall);
    background: var(--ink-soft);
  }
  .g-band-bg {
    position: absolute;
    inset: 0;
    z-index: -1;
  }
  .g-band-bg :global(picture),
  .g-band-bg :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .g-band-bg::after {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--band-filter);
  }
  .g-band-inner {
    display: grid;
    grid-template-rows: auto 1fr;
    gap: clamp(1.5rem, 4vw, 3rem);
    min-height: clamp(17rem, 46svh, 30rem);
    padding-block: clamp(1rem, 2.5vw, 2rem) clamp(1.5rem, 3.5vw, 2.75rem);
  }
  .back {
    justify-self: start;
  }
  /* Leichter Schatten hinter der Schrift: auch auf unruhigen, stellenweise hellen Fotos (Schulstreik) lesbar */
  .g-text {
    align-self: end;
    text-shadow: 0 1px 14px rgb(0 0 0 / 0.35);
  }
  /* Titel: kleiner als auf den Hauptseiten (Klasse display-compact, global.css), hell auf dem Foto */
  .title {
    margin-top: 0.5rem;
    color: var(--wall);
  }
  /* Auf dem Foto: Titel hell, Beschreibung und Datum etwas zurückgenommen (statt Grau, das auf dem Foto nicht lesbar
     wäre) */
  .band-lead {
    max-width: 60ch;
    margin-top: clamp(0.75rem, 1.5vw, 1.25rem);
    font-size: var(--fs-base);
    line-height: 1.5;
    color: rgb(239 231 211 / 0.88);
  }
  .g-band .meta-row {
    color: rgb(239 231 211 / 0.88);
  }
  .g-head {
    padding-top: clamp(1.25rem, 2.5vw, 2rem);
    padding-bottom: clamp(0.5rem, 1.5vw, 1rem);
  }
  .intro {
    display: grid;
    gap: 2rem;
  }
  .text {
    max-width: 52ch;
  }
  .side {
    display: grid;
    gap: 1.5rem;
    align-content: start;
  }
  @media (min-width: 960px) {
    .intro:has(.side) {
      grid-template-columns: 1.15fr 1fr;
      gap: clamp(2rem, 6vw, 7rem);
    }
  }
  /* Zeile unter den Fotos: links Album anfordern, rechts Teilen */
  .g-foot {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1.75rem 3rem;
    margin-top: clamp(2.5rem, 5vw, 4.5rem);
  }
  .g-foot::before {
    content: '';
    flex-basis: 100%;
    height: 1px;
    background: var(--line);
  }
  /* Teilen steht rechts, wenn beides nebeneinander passt; untereinander (Handy) bleibt alles an der linken Kante */
  @media (min-width: 760px) {
    .g-foot > :global(.share) {
      margin-left: auto;
    }
  }
  .grid-wrap {
    padding-top: clamp(1rem, 2.5vw, 2rem);
  }
  .private {
    display: flex;
    gap: 0.6em;
    align-items: baseline;
    margin-top: 2rem;
    padding: 0.9rem 1.1rem;
    /* Hinweis mit Rand statt blauer Fläche (weniger Blau, wie der Hinweis auf Impressum/Datenschutz) */
    border: 2px solid var(--ink);
    color: var(--ink);
    border-radius: var(--radius);
    font-size: var(--fs-sm);
    font-weight: 600;
  }
  .private :global(svg) {
    flex: none;
    translate: 0 0.15em;
  }
</style>
