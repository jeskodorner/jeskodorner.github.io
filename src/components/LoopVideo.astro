---
/**
 * Eigenes Video ohne Ton in Schleife – wie ein bewegtes Foto („quasi als GIF“, seit 22.11.2026 für den Dollgow-Film).
 * Kein YouTube, nichts von fremden Diensten.
 * - Lädt erst, wenn es auf dem Bildschirm ist, und läuft nur dort (außerhalb angehalten: spart Akku).
 * - Bei „Bewegung reduzieren“ oder im Datensparmodus läuft es nicht von selbst: Standbild mit Abspielknopf.
 * - Ein kleiner Knopf unten rechts hält an und spielt weiter (bei Mausbedienung nur beim Überfahren sichtbar, angehalten
 *   immer). Ein Klick aufs Video tut dasselbe. Mit `pausable={false}` (Mappen im Portfolio, Jeskos Wunsch vom
 *   22.11.2026) gibt es weder Knopf noch Anhalten per Klick – dann läuft es einfach, wie ein GIF.
 * - Ohne JavaScript: normale Videosteuerung des Browsers.
 * Das Standbild (`poster`) steht da, bis das Video läuft – in der Übersicht und bei langsamer Verbindung.
 */
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';
import Icon from './Icon.astro';
import { videoInfo } from '../lib/video';

export interface Props {
  /** Dateiname in public/videos/ */
  file: string;
  poster: ImageMetadata;
  /** Beschreibung des Videos (für Screenreader) */
  alt: string;
  /** Anhalten erlauben (Knopf und Klick aufs Video). Standard: ja */
  pausable?: boolean;
  class?: string;
}

const { file, poster, alt, pausable = true, class: className } = Astro.props;
const v = videoInfo(file);
const posterImg = await getImage({ src: poster, width: Math.min(1920, poster.width), format: 'webp', quality: 80 });
---

<figure
  class:list={['loop', className, { 'loop--pausable': pausable }]}
  style={`--ratio:${(v.width / v.height).toFixed(4)}`}
  data-loop
>
  <video
    class="loop-video"
    src={v.src}
    poster={posterImg.src}
    width={v.width}
    height={v.height}
    muted
    loop
    playsinline
    preload="none"
    controls
    disablepictureinpicture
    aria-label={alt}
  >
  </video>
  {
    pausable && (
      <button class="loop-toggle" type="button" aria-label="Video anhalten" data-loop-toggle hidden>
        <Icon name="pause" class="i-pause" />
        <Icon name="play" class="i-play" />
      </button>
    )
  }
</figure>

<script>
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const saveData = (navigator as Navigator & { connection?: { saveData?: boolean } }).connection?.saveData === true;

  document.querySelectorAll<HTMLElement>('[data-loop]').forEach((fig) => {
    const video = fig.querySelector('video');
    const btn = fig.querySelector<HTMLButtonElement>('[data-loop-toggle]');
    if (!video) return;
    // Mit JavaScript: keine Browser-Steuerung, nur der eigene kleine Knopf (falls Anhalten erlaubt ist)
    video.controls = false;
    if (btn) btn.hidden = false;
    // Angehalten durch den Knopf (oder von Anfang an bei „Bewegung reduzieren“ / Datensparmodus)
    let held = reduce || saveData;
    let visible = false;

    const sync = () => {
      const paused = video.paused;
      fig.classList.toggle('is-paused', paused);
      btn?.setAttribute('aria-label', paused ? 'Video abspielen' : 'Video anhalten');
    };
    const update = () => {
      if (visible && !held) {
        video.preload = 'auto';
        video.play().catch(() => {
          // Browser lässt es nicht von selbst laufen (z. B. Stromsparmodus): Standbild mit Abspielknopf
          held = true;
          sync();
        });
      } else if (!video.paused) {
        video.pause();
      }
    };
    const toggle = () => {
      held = !video.paused;
      if (!held) visible = true;
      update();
    };

    new IntersectionObserver(
      ([entry]) => {
        visible = Boolean(entry?.isIntersecting);
        update();
      },
      { threshold: 0.1 },
    ).observe(video);
    if (btn) {
      btn.addEventListener('click', toggle);
      video.addEventListener('click', toggle);
    }
    video.addEventListener('play', sync);
    video.addEventListener('pause', sync);
    sync();
  });
</script>

<style>
  .loop {
    position: relative;
    margin: 0;
    background: var(--wall-2);
  }
  .loop-video {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: var(--ratio);
    object-fit: cover;
  }
  .loop--pausable .loop-video {
    cursor: pointer;
  }
  /* Kleiner runder Knopf unten rechts: helle Fläche, blaues Zeichen; beim Überfahren orange wie überall */
  .loop-toggle {
    position: absolute;
    right: clamp(0.5rem, 2%, 1rem);
    bottom: clamp(0.5rem, 2%, 1rem);
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    padding: 0;
    border: 0;
    border-radius: 0;
    background: rgb(239 231 211 / 0.85);
    color: var(--ink);
    font-size: 1.1rem;
    cursor: pointer;
    transition:
      opacity 0.25s,
      background-color 0.2s,
      color 0.2s;
  }
  .loop-toggle:hover {
    background: var(--hover);
    color: var(--on-hover);
  }
  .loop-toggle[hidden] {
    display: none;
  }
  .loop-toggle :global(.i-play),
  .loop.is-paused .loop-toggle :global(.i-pause) {
    display: none;
  }
  .loop.is-paused .loop-toggle :global(.i-play) {
    display: block;
  }
  /* Angehalten: größerer Knopf in der Mitte, damit klar ist, dass es ein Video ist */
  .loop.is-paused .loop-toggle {
    right: 50%;
    bottom: 50%;
    translate: 50% 50%;
    width: 4rem;
    height: 4rem;
    font-size: 1.6rem;
    background: var(--hover);
    color: var(--on-hover);
  }
  .loop.is-paused .loop-toggle:hover {
    background: var(--ink);
    color: var(--wall);
  }
  /* Mausbedienung: der Knopf zum Anhalten erscheint erst beim Überfahren (sonst wirkt es wie ein Foto) */
  @media (hover: hover) {
    .loop:not(:hover, :focus-within, .is-paused) .loop-toggle {
      opacity: 0;
    }
  }
</style>
