---
/**
 * Optionales Kontaktformular über einen externen Dienst (z. B. Formspree).
 * GitHub Pages kann selbst keine Formulare verarbeiten.
 * Wird nur angezeigt, wenn in src/config/site.ts ein Endpoint eingetragen ist.
 * Ohne JavaScript: normales POST an den Dienst. Mit JavaScript: Versand ohne Seitenwechsel.
 */
import { site } from '../config/site';
import { useTranslations } from '../i18n';

const t = useTranslations().contact.form;
const endpoint = site.contactForm.endpoint;
---

{
  endpoint && (
    <form class="form" action={endpoint} method="POST" data-contact-form>
      <h2 class="label muted">{t.title}</h2>
      <label>
        <span>{t.name}</span>
        <input name="name" type="text" autocomplete="name" required maxlength="120" />
      </label>
      <label>
        <span>{t.email}</span>
        <input name="email" type="email" autocomplete="email" required maxlength="200" />
      </label>
      <label>
        <span>{t.message}</span>
        <textarea name="message" rows="6" required maxlength="5000" />
      </label>
      {/* Honeypot gegen Spam-Bots – für Menschen unsichtbar */}
      <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" class="hp" aria-hidden="true" />
      <p class="privacy" set:html={t.privacy('/datenschutz/#kontaktformular')} />
      <button class="btn btn--solid" type="submit">
        {t.send}
      </button>
      <p class="status" role="status" aria-live="polite" data-status />
    </form>
  )
}

<script>
  import { de } from '../i18n/de';
  document.querySelectorAll<HTMLFormElement>('[data-contact-form]').forEach((form) => {
    const status = form.querySelector<HTMLElement>('[data-status]')!;
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      button.disabled = true;
      status.textContent = de.contact.form.sending;
      try {
        const res = await fetch(form.action, {
          method: 'POST',
          body: new FormData(form),
          headers: { Accept: 'application/json' },
        });
        if (!res.ok) throw new Error(String(res.status));
        form.reset();
        status.textContent = de.contact.form.success;
      } catch {
        status.textContent = de.contact.form.error;
      } finally {
        button.disabled = false;
      }
    });
  });
</script>

<style>
  .form {
    display: grid;
    gap: 1.1rem;
    max-width: 38rem;
  }
  label {
    display: grid;
    gap: 0.35rem;
    font-weight: 650;
    font-size: var(--fs-sm);
  }
  input,
  textarea {
    width: 100%;
    padding: 0.8rem 0.9rem;
    border: 1.5px solid var(--line-strong);
    border-radius: var(--radius);
    background: var(--paper);
    font-weight: 400;
    font-size: var(--fs-base);
  }
  input:focus-visible,
  textarea:focus-visible {
    outline-offset: 0;
  }
  .hp {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    opacity: 0;
  }
  .privacy {
    font-size: var(--fs-sm);
    color: var(--ink-soft);
  }
  .form .btn {
    justify-self: start;
  }
  .status:empty {
    display: none;
  }
</style>
