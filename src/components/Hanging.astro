---
/**
 * „Hängung“ (Seite „Portfolio“): Jedes Foto hängt unbeschnitten in seinem Originalformat an der
 * weißen Wand, mit viel Platz daneben und einem schlichten Schild (Name und Angaben, kein Link).
 * Ein Klick aufs Foto öffnet die Lightbox mit dem ganzen Album ab diesem Foto – direkt hier, ohne die
 * Albumseite (Daten und Skript: pages/portfolio.astro). Ohne JavaScript führt der Link ins Album.
 *   Fotos linksbündig. Das Schild steht immer mittig zum Foto: Desktop rechts daneben auf halber Bildhöhe,
 *   Handy darunter, waagrecht mittig unter dem Foto.
 *   Größe: deutlich kleiner als der Bildschirm (Hochformate höchstens gut halb so hoch, Querformate höchstens
 *   knapp die halbe Breite), damit jedes Foto mit Luft für sich steht.
 * Schild: Hat das Foto einen eigenen Namen (Showroom), steht er als Titel da und darunter der Album-Name.
 *         Sonst ist der Album-Name der Titel.
 */
import type { WorkItem } from '../lib/showroom';
import Picture from './Picture.astro';

export interface Props {
  items: WorkItem[];
}

const { items } = Astro.props;
---

<ol class="hanging" role="list">
  {
    items.map((it) => {
      const r = it.image.src.width / it.image.src.height;
      return (
        <li class:list={['work', { 'work--portrait': r < 1 }]} style={`--r:${r.toFixed(4)}`}>
          <a
            class="work-media reveal"
            href={it.photoHref}
            data-open-album={it.gallery.slug}
            data-photo={it.image.index}
          >
            <Picture
              src={it.image.src}
              alt={it.image.alt}
              sizes={r < 1.2 ? '(min-width: 900px) 32vw, 90vw' : '(min-width: 900px) 46vw, 92vw'}
              color={it.image.color}
              lqip={it.image.lqip}
              class="work-img"
            />
          </a>
          <div class="work-label">
            <p class="work-title">{it.name ?? it.album}</p>
            {(it.name || it.meta) && <p class="work-meta">{[it.name && it.album, it.meta].filter(Boolean).join(' · ')}</p>}
          </div>
        </li>
      );
    })
  }
</ol>

<style>
  .hanging {
    list-style: none;
    padding: 0;
    display: grid;
    gap: clamp(3rem, 2rem + 5vw, 7rem);
    /* Höchstens gut halb so hoch wie der Bildschirm */
    --work-h: max(16rem, calc((100svh - var(--header-h)) * 0.6));
  }
  .work {
    display: grid;
    gap: 1.5rem;
  }
  .work-media {
    display: block;
    justify-self: start;
    width: min(100%, calc(var(--work-h) * var(--r)));
  }
  .work-media {
    cursor: zoom-in;
    outline-offset: 4px;
  }
  .work :global(.work-img) {
    display: block;
    width: 100%;
    height: auto;
    box-shadow: var(--hang-shadow);
  }

  /* ---------- Schild: mittig unter dem Foto (so breit wie das Foto) ---------- */
  .work-label {
    display: grid;
    gap: 0.25rem;
    justify-items: center;
    text-align: center;
    width: min(100%, calc(var(--work-h) * var(--r)));
  }
  /* Titel auf dem Schild in der Titelschrift (Instrument Serif), wie die Überschriften */
  .work-title {
    font-family: var(--font-display);
    font-weight: 400;
    font-synthesis-weight: none;
    font-size: clamp(1.4rem, 1.15rem + 0.8vw, 2rem);
    line-height: 1.05;
    letter-spacing: -0.01em;
  }
  .work-meta {
    font-size: var(--fs-xs);
    color: var(--ink-soft);
    font-variant-numeric: tabular-nums;
  }

  /* ---------- Desktop: Foto links, Schild rechts daneben auf halber Bildhöhe ---------- */
  @media (min-width: 900px) {
    .work {
      display: flex;
      align-items: center;
      gap: clamp(2.5rem, 5vw, 5.5rem);
    }
    .work-media {
      flex: none;
      /* Breite aus dem Seitenverhältnis: nie höher als --work-h, nie breiter als 46 % */
      width: min(46vw, calc(var(--work-h) * var(--r)));
    }
    .work-label {
      flex: 0 1 20rem;
      width: auto;
      justify-items: start;
      text-align: left;
    }
  }
</style>
