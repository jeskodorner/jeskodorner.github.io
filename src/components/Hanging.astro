---
/**
 * „Hängung“ (Seite „Portfolio“): Jedes Foto hängt unbeschnitten in seinem Originalformat an der
 * weißen Wand, mit viel Platz daneben und einem schlichten Schild (Name und Angaben).
 * Ein Klick aufs Foto oder aufs Schild öffnet die Mappe des Albums (pages/mappe/[slug].astro): eine ruhige Übersicht
 * mit einer Auswahl der Fotos, von dort geht es ins ganze Album – dieselbe Mappe wie von der Startseite. Beim
 * Überfahren von Foto oder Schild wird das Foto leicht größer und der Titel orange unterstrichen, wie in der
 * Galerie-Übersicht (seit 21.11.2026; vorher blieb das Schild ruhig).
 *   Desktop: Fotos linksbündig, das Schild rechts daneben auf halber Bildhöhe.
 *   Handy: alles mittig – jedes Foto steht in der Mitte, das Schild mittig darunter.
 *   Größe: deutlich kleiner als der Bildschirm (Hochformate höchstens gut halb so hoch, Querformate höchstens
 *   knapp die halbe Breite), damit jedes Foto mit Luft für sich steht.
 * Schild: Hat das Foto einen eigenen Namen (Showroom), steht er als Titel da und darunter der Album-Name.
 *         Sonst ist der Album-Name der Titel.
 */
import type { WorkItem } from '../lib/showroom';
import Picture from './Picture.astro';
import { tidyTitle } from '../lib/text';
import { mappeUrl } from '../lib/mappe';
import { workSizes } from '../lib/sizes';

export interface Props {
  items: WorkItem[];
}

const { items } = Astro.props;
---

<ol class="hanging" role="list">
  {
    items.map((it, i) => {
      const r = it.image.src.width / it.image.src.height;
      return (
        <li class:list={['work', { 'work--portrait': r < 1 }]} id={`werk-${i + 1}`} style={`--r:${r.toFixed(4)}`}>
          <a class="work-media reveal" href={mappeUrl(it.gallery)}>
            <Picture
              src={it.image.src}
              alt={it.image.alt}
              sizes={workSizes(r)}
              color={it.image.color}
              lqip={it.image.lqip}
              loading={i === 0 ? 'eager' : 'lazy'}
              fetchpriority={i === 0 ? 'high' : undefined}
              class="work-img"
            />
          </a>
          {/* Das Schild führt ebenfalls zur Mappe */}
          <a class="work-label" href={mappeUrl(it.gallery)}>
            <span class="work-title">{tidyTitle(it.name ?? it.album)}</span>
            {(it.name || it.meta) && <span class="label work-meta">{[it.name && it.album, it.meta].filter(Boolean).join(' · ')}</span>}
          </a>
        </li>
      );
    })
  }
</ol>

<style>
  .hanging {
    list-style: none;
    padding: 0;
    display: grid;
    gap: clamp(3rem, 2rem + 5vw, 7rem);
    /* Höchstens gut halb so hoch wie der Bildschirm */
    --work-h: max(16rem, calc((100svh - var(--header-h)) * 0.6));
  }
  /* Handy: Foto und Schild mittig */
  .work {
    /* Sprungziel von der Startseite (#werk-<n>): nicht unter der Kopfleiste verstecken */
    scroll-margin-top: calc(var(--header-h) + 1.5rem);
    display: grid;
    justify-items: center;
    gap: 1.5rem;
  }
  .work-media {
    display: block;
    width: min(100%, calc(var(--work-h) * var(--r)));
  }
  /* Rahmen mit dem Schatten an der Wand; beim Überfahren wird das Foto darin leicht größer (wie in den Alben) */
  .work-media {
    outline-offset: 4px;
    overflow: hidden;
    box-shadow: var(--hang-shadow);
  }
  .work :global(.work-img) {
    display: block;
    width: 100%;
    height: auto;
    transition: transform 0.9s var(--ease);
  }
  /* Überfahren von Foto oder Schild: Foto leicht größer, Titel orange unterstrichen – wie in der Galerie-Übersicht */
  @media (hover: hover) {
    .work-media:hover :global(.work-img),
    .work:has(.work-label:hover) :global(.work-img) {
      transform: scale(var(--hover-zoom));
    }
    .work-label:hover .work-title,
    .work:has(.work-media:hover) .work-title {
      text-decoration: underline;
      text-decoration-color: var(--hover-line);
      text-decoration-thickness: 0.1em;
      text-underline-offset: 0.12em;
    }
  }

  /* ---------- Schild: mittig unter dem Foto (so breit wie das Foto) ---------- */
  .work-label {
    color: inherit;
    text-decoration: none;
    display: grid;
    gap: 0.25rem;
    justify-items: center;
    text-align: center;
    width: min(100%, calc(var(--work-h) * var(--r)));
  }
  /* Titel auf dem Schild in der Titelschrift (Melodrama), wie die Überschriften */
  .work-title {
    font-family: var(--font-display);
    font-weight: var(--display-wght);
    font-synthesis-weight: none;
    font-size: clamp(1.4rem, 1.15rem + 0.8vw, 2rem);
    line-height: 1.05;
    letter-spacing: -0.01em;
    text-wrap: balance;
  }
  /* Datum als kleines Etikett wie in der Galerie-Übersicht (vorher normale Schrift mit Bildanzahl) */
  .work-meta {
    color: var(--ink-soft);
    font-size: clamp(0.72rem, 0.66rem + 0.25vw, var(--fs-xs));
  }

  /* ---------- Desktop: Foto links, Schild rechts daneben auf halber Bildhöhe ----------
     Seit 23.11.2026 an einer gemeinsamen Achse: Die Fotos stehen rechtsbündig in einer festen linken Spalte, die
     Schilder beginnen alle an derselben Linie rechts davon. Vorher stand jedes Schild direkt neben seinem Foto – bei
     unterschiedlich breiten Fotos begannen die Titel an vier verschiedenen Stellen, und schmale Schilder (20rem)
     brachen oft unnötig um. */
  @media (min-width: 900px) {
    .work {
      grid-template-columns: 46vw minmax(0, 1fr);
      align-items: center;
      justify-items: start;
      column-gap: clamp(2.5rem, 5vw, 5.5rem);
    }
    .work-media {
      justify-self: end;
      /* Breite aus dem Seitenverhältnis: nie höher als --work-h, nie breiter als die Spalte */
      width: min(46vw, calc(var(--work-h) * var(--r)));
    }
    .work-label {
      width: auto;
      max-width: 26ch;
      justify-items: start;
      text-align: left;
    }
  }
</style>
