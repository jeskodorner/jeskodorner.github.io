---
/**
 * „Hängung“ (Seite „Portfolio“): Jedes Foto hängt unbeschnitten in seinem Originalformat an der
 * weißen Wand, mit viel Platz daneben und einem kleinen Schild mit Verweis auf sein Album.
 * Ein Klick aufs Foto öffnet die Lightbox mit dem ganzen Album ab diesem Foto – direkt hier, ohne die
 * Albumseite (Daten und Skript: pages/portfolio.astro). Ohne JavaScript führt der Link ins Album.
 *   Alles linksbündig. Desktop: Foto links, Schild rechts daneben. Handy: Schild darunter.
 *   Größe: deutlich kleiner als der Bildschirm (Hochformate höchstens gut halb so hoch, Querformate höchstens
 *   knapp die halbe Breite), damit jedes Foto mit Luft für sich steht.
 * Schild: Hat das Foto einen eigenen Namen (Showroom), steht er als Titel da und darunter „Aus dem Album …“.
 *         Sonst ist der Album-Name der Titel und darunter „Zum Album“.
 */
import type { WorkItem } from '../lib/showroom';
import Picture from './Picture.astro';

export interface Props {
  items: WorkItem[];
}

const { items } = Astro.props;
---

<ol class="hanging" role="list">
  {
    items.map((it) => {
      const r = it.image.src.width / it.image.src.height;
      return (
        <li class:list={['work', { 'work--portrait': r < 1 }]} style={`--r:${r.toFixed(4)}`}>
          <a
            class="work-media reveal"
            href={it.photoHref}
            tabindex="-1"
            data-open-album={it.gallery.slug}
            data-photo={it.image.index}
          >
            <Picture
              src={it.image.src}
              alt={it.image.alt}
              sizes={r < 1.2 ? '(min-width: 900px) 32vw, 90vw' : '(min-width: 900px) 46vw, 92vw'}
              color={it.image.color}
              lqip={it.image.lqip}
              class="work-img"
            />
          </a>
          <div class="work-label">
            <p class="work-title">{it.name ?? it.album}</p>
            {it.meta && <p class="work-meta">{it.meta}</p>}
            <a class="work-link" href={it.href}>
              {it.name ? (
                <>Aus dem Album „{it.album}“</>
              ) : (
                <>
                  Zum Album<span class="visually-hidden"> „{it.album}“</span>
                </>
              )}{' '}
              <span class="arrow" aria-hidden="true">
                →
              </span>
            </a>
          </div>
        </li>
      );
    })
  }
</ol>

<style>
  .hanging {
    list-style: none;
    padding: 0;
    display: grid;
    gap: clamp(3rem, 2rem + 5vw, 7rem);
    /* Höchstens gut halb so hoch wie der Bildschirm */
    --work-h: max(16rem, calc((100svh - var(--header-h)) * 0.6));
  }
  .work {
    display: grid;
    gap: 1rem;
  }
  .work-media {
    display: block;
    justify-self: start;
    width: min(100%, calc(var(--work-h) * var(--r)));
  }
  .work :global(.work-img) {
    display: block;
    width: 100%;
    height: auto;
    box-shadow: var(--hang-shadow);
  }

  /* ---------- Schild ---------- */
  .work-label {
    display: grid;
    gap: 0.25rem;
    justify-items: start;
    max-width: 20rem;
  }
  .work-title {
    font-size: clamp(1.05rem, 0.95rem + 0.4vw, 1.3rem);
    font-weight: 700;
    line-height: 1.25;
  }
  .work-meta {
    font-size: var(--fs-xs);
    color: var(--ink-soft);
    font-variant-numeric: tabular-nums;
  }
  .work-link {
    margin-top: 0.35rem;
    font-size: var(--fs-sm);
    font-weight: 700;
    color: var(--accent);
  }

  /* ---------- Desktop: Foto in voller Höhe, abwechselnd links/rechts, Schild unten daneben ---------- */
  @media (min-width: 900px) {
    .work {
      display: flex;
      align-items: flex-end;
      gap: clamp(1.5rem, 3vw, 3.5rem);
    }
    .work-media {
      flex: none;
      /* Breite aus dem Seitenverhältnis: nie höher als --work-h, nie breiter als 46 % */
      width: min(46vw, calc(var(--work-h) * var(--r)));
    }
    .work-label {
      flex: 0 1 20rem;
      padding-bottom: 0.25rem;
    }
  }
</style>
