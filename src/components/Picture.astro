---
import type { ImageMetadata } from 'astro';
import { responsive } from '../lib/images';

export interface Props {
  src: ImageMetadata;
  alt: string;
  sizes: string;
  /** Dominante Farbe / Blur-Platzhalter aus meta.json */
  color?: string;
  lqip?: string;
  loading?: 'lazy' | 'eager';
  fetchpriority?: 'high' | 'low' | 'auto';
  class?: string;
  pictureClass?: string;
  style?: string;
  /** Nur Varianten bis zu dieser Breite anbieten (kleine Vorschaubilder, z. B. Kacheln) */
  maxWidth?: number;
}

const {
  src,
  alt,
  sizes,
  color = '#d9c9b4',
  lqip,
  loading = 'lazy',
  fetchpriority,
  class: className,
  pictureClass,
  style = '',
  maxWidth,
} = Astro.props;

const set = await responsive(src);
/** srcset auf Breiten ≤ maxWidth kürzen (mindestens die kleinste Variante bleibt) */
const limit = (srcset: string) => {
  if (!maxWidth) return srcset;
  const parts = srcset.split(', ');
  const kept = parts.filter((p) => Number(p.match(/ (\d+)w$/)?.[1] ?? Infinity) <= maxWidth);
  return (kept.length ? kept : parts.slice(0, 1)).join(', ');
};
const bg = `background-color:${color};${lqip ? `background-image:url(${lqip});` : ''}${style}`;
---

<picture class={pictureClass}>
  <source type="image/avif" srcset={limit(set.avif)} sizes={sizes} />
  <img
    class:list={['ph-img', className]}
    src={set.src}
    srcset={limit(set.webp)}
    sizes={sizes}
    width={set.width}
    height={set.height}
    alt={alt}
    loading={loading}
    decoding={loading === 'eager' ? 'sync' : 'async'}
    fetchpriority={fetchpriority}
    style={bg}
  />
</picture>
