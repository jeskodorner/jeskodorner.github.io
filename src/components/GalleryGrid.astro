---
/**
 * Album: alle Fotos klein in gleich hohen Reihen (wie Lightroom), jedes unbeschnitten im Originalformat.
 * Ein Klick öffnet die Lightbox (PhotoSwipe); die URL bekommt #bild-N und ist teilbar.
 * Ohne JavaScript öffnet der Link das Foto selbst in groß.
 * Die Details (Bildunterschrift, Aufnahmedaten) stehen als data-Attribute am Link und erscheinen
 * in der Lightbox im ausklappbaren Feld „Details“.
 */
import type { Gallery } from '../lib/galleries';
import { responsive } from '../lib/images';
import { exifRows } from '../lib/exif';
import { formatDate, useTranslations } from '../i18n';
import Picture from './Picture.astro';

export interface Props {
  gallery: Gallery;
}

const { gallery } = Astro.props;
const t = useTranslations();

const items = await Promise.all(
  gallery.images.map(async (img) => {
    const set = await responsive(img.src);
    const ratio = img.src.width / img.src.height;
    // Gleich hohe Reihen: die Breite wächst mit dem Seitenverhältnis
    const sizes = `(min-width: 700px) ${Math.round(ratio * 270)}px, ${Math.round(Math.min(100, ratio * 36))}vw`;
    // Details für die Lightbox: [Bezeichnung, Wert]
    const details: [string, string][] = [];
    if (gallery.showExif) {
      for (const r of exifRows(img.exif)) details.push([r.label, r.value]);
      const shot = img.exif.date ? new Date(img.exif.date) : undefined;
      if (shot && !Number.isNaN(shot.getTime())) details.push([t.image.date, formatDate(shot)]);
    }
    return { img, set, ratio, sizes, details };
  }),
);
---

<div class="container container--wide">
  <ul
    id="gallery"
    class="tiles"
    role="list"
    data-gallery
    data-justify
    data-count={gallery.images.length}
    data-title={gallery.title}
  >
    {
      items.map((it) => (
        <li class="tile-cell" style={`--r:${it.ratio.toFixed(4)}`}>
          <a
            class="ph tile"
            id={`bild-${it.img.index}`}
            href={it.set.largest.url}
            data-pswp-src={it.set.largest.url}
            data-pswp-width={it.set.largest.width}
            data-pswp-height={it.set.largest.height}
            data-pswp-srcset={it.set.webp}
            data-index={it.img.index}
            data-caption={it.img.caption}
            data-details={it.details.length ? JSON.stringify(it.details) : undefined}
            data-original={it.img.originalUrl}
          >
            <Picture
              src={it.img.src}
              alt={it.img.alt}
              sizes={it.sizes}
              color={it.img.color}
              loading={it.img.index <= 6 ? 'eager' : 'lazy'}
              fetchpriority={it.img.index === 1 ? 'high' : undefined}
              maxWidth={1200}
            />
          </a>
        </li>
      ))
    }
  </ul>
</div>

<script>
  import { initLightbox } from '../scripts/lightbox';
  import { initJustify } from '../scripts/justify';
  initJustify();
  initLightbox();
</script>

<style>
  /* Gleich hohe Reihen, dicht gepackt (wie Lightroom). Jedes Foto bleibt im Originalformat:
     Breite ∝ Seitenverhältnis (flex-grow), die letzte Reihe wird nicht gestreckt (::after).
     scripts/justify.ts verteilt die Reihen genauer, ohne JavaScript übernimmt dieses CSS. */
  .tiles {
    --row: clamp(95px, 55px + 12vw, 230px);
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: clamp(3px, 0.1rem + 0.35vw, 8px);
  }
  .tiles::after {
    content: '';
    flex-grow: 1000000;
  }
  .tile-cell {
    flex-grow: calc(var(--r) * 100);
    flex-basis: calc(var(--r) * var(--row));
    min-width: 0;
  }
  .ph {
    position: relative;
    display: block;
    overflow: hidden;
    background: var(--sand);
    outline-offset: 3px;
  }
  .ph :global(img) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: var(--r);
    transition: transform 0.9s var(--ease);
  }
  @media (hover: hover) {
    .ph:hover :global(img) {
      transform: scale(1.035);
    }
  }
</style>
