---
/**
 * Galerie-Raster. Jedes Bild ist ein normaler Link auf seine Bildseite (funktioniert ohne JS).
 * Mit JS öffnet PhotoSwipe die Lightbox; die URL bekommt #bild-N und ist teilbar.
 */
import type { Gallery } from '../lib/galleries';
import { responsive } from '../lib/images';
import { exifLine } from '../lib/exif';
import Picture from './Picture.astro';

export interface Props {
  gallery: Gallery;
}

const { gallery } = Astro.props;
const layout = gallery.layout;

const items = await Promise.all(
  gallery.images.map(async (img) => {
    const set = await responsive(img.src);
    const ratio = img.src.width / img.src.height;
    const sizes =
      layout === 'masonry'
        ? '(min-width: 2100px) 20vw, (min-width: 1500px) 25vw, (min-width: 900px) 33vw, 50vw'
        : `(min-width: 1700px) ${Math.round(ratio * 440)}px, (min-width: 600px) ${Math.min(100, Math.round(ratio * 26))}vw, ${Math.min(100, Math.round(ratio * 48))}vw`;
    return { img, set, ratio, sizes, exif: gallery.showExif ? exifLine(img.exif) : '' };
  }),
);
---

<div
  id="gallery"
  class:list={['grid', `grid--${layout}`]}
  data-gallery
  data-count={gallery.images.length}
>
  {
    items.map(({ img, set, ratio, sizes, exif }) => (
      <a
        class="ph reveal"
        id={`bild-${img.index}`}
        href={img.pageUrl}
        style={`--r:${ratio.toFixed(4)}`}
        data-pswp-src={set.largest.url}
        data-pswp-width={set.largest.width}
        data-pswp-height={set.largest.height}
        data-pswp-srcset={set.webp}
        data-index={img.index}
        data-caption={img.caption}
        data-exif={exif || undefined}
        data-original={img.originalUrl}
      >
        <Picture src={img.src} alt={img.alt} sizes={sizes} color={img.color} lqip={img.lqip} />
        <span class="num label" aria-hidden="true">
          {String(img.index).padStart(2, '0')}
        </span>
      </a>
    ))
  }
</div>

<script>
  import { initLightbox } from '../scripts/lightbox';
  initLightbox();
</script>

<style>
  .grid {
    --gap-g: clamp(0.4rem, 0.2rem + 0.7vw, 1rem);
  }
  .ph {
    position: relative;
    display: block;
    overflow: hidden;
    background: var(--sand);
    outline-offset: 4px;
  }
  .ph :global(img) {
    width: 100%;
    transition:
      transform 0.9s var(--ease),
      filter 0.6s;
  }
  .num {
    position: absolute;
    left: 0.6rem;
    bottom: 0.5rem;
    padding: 0.2rem 0.45rem;
    color: #fbf6ef;
    background: rgb(var(--scrim) / 0.72);
    opacity: 0;
    transform: translateY(0.4rem);
    transition:
      opacity 0.3s,
      transform 0.4s var(--ease);
  }
  @media (hover: hover) {
    .ph:hover :global(img) {
      transform: scale(1.035);
    }
    .ph:hover .num {
      opacity: 1;
      transform: none;
    }
  }
  .ph:focus-visible .num {
    opacity: 1;
    transform: none;
  }

  /* Masonry: CSS-Spalten, kein JavaScript */
  .grid--masonry {
    columns: 2;
    column-gap: var(--gap-g);
  }
  .grid--masonry .ph {
    break-inside: avoid;
    margin-bottom: var(--gap-g);
  }
  @media (min-width: 900px) {
    .grid--masonry {
      columns: 3;
    }
  }
  @media (min-width: 1500px) {
    .grid--masonry {
      columns: 4;
    }
  }
  @media (min-width: 2100px) {
    .grid--masonry {
      columns: 5;
    }
  }

  /* Justified Rows: reines CSS – flex-grow proportional zum Seitenverhältnis */
  .grid--justified {
    --row: clamp(150px, 6rem + 18vw, 440px);
    display: flex;
    flex-wrap: wrap;
    gap: var(--gap-g);
  }
  .grid--justified::after {
    content: '';
    flex-grow: 1000000;
  }
  .grid--justified .ph {
    flex-grow: calc(var(--r) * 100);
    flex-basis: calc(var(--r) * var(--row));
  }
  .grid--justified .ph :global(img) {
    height: 100%;
    aspect-ratio: var(--r);
    object-fit: cover;
  }
</style>
