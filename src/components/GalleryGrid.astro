---
/**
 * Galerie-Darstellung: „showcase“ (Bühne, jedes Bild groß mit Parallax), „masonry“ oder „justified“.
 * Jedes Bild ist ein normaler Link auf seine Bildseite (funktioniert ohne JS).
 * Mit JS öffnet PhotoSwipe die Lightbox; die URL bekommt #bild-N und ist teilbar.
 */
import type { Gallery } from '../lib/galleries';
import { responsive } from '../lib/images';
import { exifLine } from '../lib/exif';
import Picture from './Picture.astro';
import Showcase, { type StageItem } from './Showcase.astro';

export interface Props {
  gallery: Gallery;
}

const { gallery } = Astro.props;
const layout = gallery.layout;

const items = await Promise.all(
  gallery.images.map(async (img) => {
    const set = await responsive(img.src);
    const ratio = img.src.width / img.src.height;
    const sizes =
      layout === 'masonry'
        ? '(min-width: 2100px) 20vw, (min-width: 1500px) 25vw, (min-width: 900px) 33vw, 50vw'
        : `(min-width: 1700px) ${Math.round(ratio * 440)}px, (min-width: 600px) ${Math.min(100, Math.round(ratio * 26))}vw, ${Math.min(100, Math.round(ratio * 48))}vw`;
    return { img, set, ratio, sizes, exif: gallery.showExif ? exifLine(img.exif) : '' };
  }),
);

/** Lightbox-Daten, gemeinsam für alle Layouts */
const pswpAttrs = (it: (typeof items)[number]) => ({
  id: `bild-${it.img.index}`,
  'data-pswp-src': it.set.largest.url,
  'data-pswp-width': it.set.largest.width,
  'data-pswp-height': it.set.largest.height,
  'data-pswp-srcset': it.set.webp,
  'data-index': it.img.index,
  'data-caption': it.img.caption,
  'data-exif': it.exif || undefined,
  'data-original': it.img.originalUrl,
});

const stageItems: StageItem[] = items.map((it) => ({
  image: it.img,
  href: it.img.pageUrl,
  title: it.img.caption,
  meta: it.exif || undefined,
  attrs: pswpAttrs(it),
}));
---

{
  layout === 'showcase' && (
    <Showcase items={stageItems} lightbox eagerFirst id="gallery" count={gallery.images.length} />
  )
}

{
  layout !== 'showcase' && (
    <div id="gallery" class:list={['grid', `grid--${layout}`]} data-gallery data-count={gallery.images.length} data-layout={layout}>
      {items.map((it) => (
        <a class="ph reveal" href={it.img.pageUrl} style={`--r:${it.ratio.toFixed(4)}`} {...pswpAttrs(it)}>
          <Picture
            src={it.img.src}
            alt={it.img.alt}
            sizes={it.sizes}
            color={it.img.color}
            lqip={it.img.lqip}
            loading={it.img.index <= 3 ? 'eager' : 'lazy'}
            fetchpriority={it.img.index === 1 ? 'high' : undefined}
          />
          <span class="num label" aria-hidden="true">
            {String(it.img.index).padStart(2, '0')}
          </span>
        </a>
      ))}
    </div>
  )
}

<script>
  import { initLightbox } from '../scripts/lightbox';
  initLightbox();
</script>

<style>
  .grid {
    --gap-g: clamp(0.4rem, 0.2rem + 0.7vw, 1rem);
  }
  .ph {
    position: relative;
    display: block;
    overflow: hidden;
    background: var(--sand);
    outline-offset: 4px;
  }
  .ph :global(img) {
    width: 100%;
    transition:
      transform 0.9s var(--ease),
      filter 0.6s;
  }
  .num {
    position: absolute;
    left: 0.6rem;
    bottom: 0.5rem;
    padding: 0.2rem 0.45rem;
    color: #fbf6ef;
    background: rgb(var(--scrim) / 0.72);
    opacity: 0;
    transform: translateY(0.4rem);
    transition:
      opacity 0.3s,
      transform 0.4s var(--ease);
  }
  @media (hover: hover) {
    .ph:hover :global(img) {
      transform: scale(1.035);
    }
    .ph:hover .num {
      opacity: 1;
      transform: none;
    }
  }
  .ph:focus-visible .num {
    opacity: 1;
    transform: none;
  }

  /* Masonry: CSS-Spalten, kein JavaScript */
  .grid--masonry {
    columns: 2;
    column-gap: var(--gap-g);
  }
  .grid--masonry .ph {
    break-inside: avoid;
    margin-bottom: var(--gap-g);
  }
  @media (min-width: 900px) {
    .grid--masonry {
      columns: 3;
    }
  }
  @media (min-width: 1500px) {
    .grid--masonry {
      columns: 4;
    }
  }
  @media (min-width: 2100px) {
    .grid--masonry {
      columns: 5;
    }
  }

  /* Justified Rows: reines CSS – flex-grow proportional zum Seitenverhältnis */
  .grid--justified {
    --row: clamp(150px, 6rem + 18vw, 440px);
    display: flex;
    flex-wrap: wrap;
    gap: var(--gap-g);
  }
  .grid--justified::after {
    content: '';
    flex-grow: 1000000;
  }
  .grid--justified .ph {
    flex-grow: calc(var(--r) * 100);
    flex-basis: calc(var(--r) * var(--row));
  }
  .grid--justified .ph :global(img) {
    height: 100%;
    aspect-ratio: var(--r);
    object-fit: cover;
  }
</style>
