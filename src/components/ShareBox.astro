---
/**
 * Teilen: Link kopieren, Web Share API (v. a. mobil), WhatsApp, E-Mail.
 * Ohne JavaScript bleiben WhatsApp/E-Mail-Links und ein markierbares Linkfeld.
 * compact: schlichte Zeile „Album teilen“ mit kleinen runden Symbolen (unter den Fotos).
 */
import Icon from './Icon.astro';
import { useTranslations } from '../i18n';
import { fillShareText } from '../lib/galleries';

export interface Props {
  url: string;
  title: string;
  template: string;
  /** Schlichte Zeile mit runden Symbolen statt großer Knöpfe */
  compact?: boolean;
}

const { url, title, template, compact = false } = Astro.props;
const t = useTranslations();
const text = fillShareText(template, title, url);
const whatsapp = `https://wa.me/?text=${encodeURIComponent(text)}`;
const mail = `mailto:?subject=${encodeURIComponent(title)}&body=${encodeURIComponent(text)}`;
---

<div class:list={['share', { 'share--compact': compact }]} data-share-box>
  <p class="label muted share-title">{compact ? t.share.album : t.share.title}</p>
  <div class="share-actions">
    <button class="btn btn--small js-only" type="button" data-copy={url} title={compact ? t.share.copy : undefined}>
      <Icon name="link" class="ic-link" /><Icon name="check" class="ic-check" /><span data-copy-label class:list={{ 'visually-hidden': compact }}>{t.share.copy}</span>
    </button>
    <button
      class="btn btn--small"
      type="button"
      data-native-share
      data-url={url}
      data-title={title}
      data-text={text}
      title={compact ? t.share.native : undefined}
      hidden
    >
      <Icon name="share" /><span class:list={{ 'visually-hidden': compact }}>{t.share.native}</span>
    </button>
    <a class="btn btn--small" href={whatsapp} target="_blank" rel="noopener noreferrer" title={compact ? t.share.whatsapp : undefined}>
      <Icon name="whatsapp" /><span class:list={{ 'visually-hidden': compact }}>{t.share.whatsapp}</span>
    </a>
    <a class="btn btn--small" href={mail} title={compact ? t.share.mail : undefined}>
      <Icon name="mail" /><span class:list={{ 'visually-hidden': compact }}>{t.share.mail}</span>
    </a>
  </div>
  <label class="no-js-only share-field">
    <span class="visually-hidden">{t.share.linkLabel}</span>
    <input type="text" readonly value={url} />
  </label>
  <p class:list={['share-status', { 'visually-hidden': !compact }]} role="status" aria-live="polite" data-copy-status></p>
</div>

<script>
  import { de } from '../i18n/de';

  async function copy(text: string) {
    try {
      await navigator.clipboard.writeText(text);
      return true;
    } catch {
      // Fallback für ältere Browser / unsichere Kontexte
      const ta = document.createElement('textarea');
      ta.value = text;
      ta.setAttribute('readonly', '');
      ta.style.position = 'fixed';
      ta.style.opacity = '0';
      document.body.append(ta);
      ta.select();
      let ok = false;
      try {
        ok = document.execCommand('copy');
      } catch {
        ok = false;
      }
      ta.remove();
      return ok;
    }
  }

  document.querySelectorAll<HTMLElement>('[data-share-box]').forEach((box) => {
    const status = box.querySelector<HTMLElement>('[data-copy-status]');
    box.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((btn) => {
      const label = btn.querySelector<HTMLElement>('[data-copy-label]');
      btn.addEventListener('click', async () => {
        const ok = await copy(btn.dataset.copy!);
        const msg = ok ? de.share.copied : de.share.copyFailed;
        if (ok) {
          btn.classList.add('is-copied');
          window.setTimeout(() => btn.classList.remove('is-copied'), 2200);
        }
        if (status) {
          status.textContent = msg;
          window.setTimeout(() => (status.textContent = ''), 2600);
        }
        if (label) {
          label.textContent = ok ? de.share.copied : de.share.copy;
          window.setTimeout(() => (label.textContent = de.share.copy), 2200);
        }
      });
    });
    box.querySelectorAll<HTMLButtonElement>('[data-native-share]').forEach((btn) => {
      if (typeof navigator.share !== 'function') return;
      btn.hidden = false;
      btn.addEventListener('click', () => {
        navigator
          .share({ title: btn.dataset.title, text: btn.dataset.text, url: btn.dataset.url })
          .catch(() => {
            /* abgebrochen */
          });
      });
    });
  });
</script>

<style>
  /* Rückmeldung beim Kopieren: das Kettenglied wird kurz zum Haken, der Knopf füllt sich */
  .btn :global(.ic-check) {
    display: none;
  }
  .btn.is-copied {
    background: var(--ink);
    color: var(--wall);
  }
  .btn.is-copied :global(.ic-link) {
    display: none;
  }
  .btn.is-copied :global(.ic-check) {
    display: block;
    animation: check-in 0.3s var(--pop);
  }
  @keyframes check-in {
    from {
      scale: 0.4;
      opacity: 0;
    }
  }
  .share-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 0.6rem;
  }
  .share-field input {
    width: 100%;
    max-width: 34rem;
    margin-top: 0.6rem;
    padding: 0.6rem 0.8rem;
    border: 1.5px solid var(--line-strong);
    border-radius: var(--radius);
    background: var(--paper);
    font-size: var(--fs-sm);
  }
  /* Schlichte Zeile: „Album teilen“ + runde Symbole */
  .share--compact {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0.9rem;
  }
  .share--compact .share-actions {
    margin-top: 0;
    gap: 0.4rem;
  }
  .share--compact .btn {
    width: 2.5rem;
    min-height: 2.5rem;
    padding: 0;
    border-width: 1.5px;
  }
  .share--compact .btn :global(svg) {
    width: 1.1rem;
    height: 1.1rem;
  }
  .share--compact .share-field {
    flex-basis: 100%;
  }
  .share--compact .share-status {
    flex-basis: 100%;
    font-size: var(--fs-xs);
    font-weight: 700;
    color: var(--accent);
    min-height: 1em;
  }
  .share--compact .share-status:empty {
    display: none;
  }
</style>
