---
import displayFont from '../assets/fonts/melodrama-variable.woff2?url';
import sansFont from '../assets/fonts/libre-franklin-latin-wght-normal.woff2?url';
// Name in der Kopfzeile: sofort laden, sonst steht das Logo beim Seitenwechsel kurz in einer Ersatzschrift
import nameFont from '../assets/fonts/migha-black.otf?url';
import { site } from '../config/site';

export interface Props {
  title?: string;
  description?: string;
  /** Absolute oder root-relative URL des Vorschaubilds */
  image?: { url: string; width: number; height: number; alt?: string };
  /** noindex für Unlisted-Galerien */
  noindex?: boolean;
  /** Referrer unterdrücken (Unlisted: Slug soll nicht an externe Seiten weitergegeben werden) */
  noReferrer?: boolean;
  type?: 'website' | 'article' | 'profile';
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  /** Wichtigstes Bild der Seite (aus preloadImage in lib/images.ts): wird schon im Kopf angekündigt */
  preload?: { srcset: string; sizes: string };
}

const { title, description = site.description, image, noindex = false, noReferrer = false, type = 'website', jsonLd, preload } =
  Astro.props;

// Titel mit Namen: im Browser-Tab und beim Teilen sieht man sofort, von wem der Link ist („Hilda – Setcard · Jesko Dorner“)
const fullTitle = title ? `${title} · ${site.name}` : `${site.name} – ${site.claim.replace(/\.$/, '')}`;
const is404 = Astro.url.pathname.startsWith('/404');
// Kursive Titelschrift ist nur auf der Startseite sofort zu sehen (Menüpunkte, Bildunterschrift) – nur dort vorab laden
const isHome = Astro.url.pathname === '/';
const canonical = new URL(Astro.url.pathname, Astro.site ?? site.url).href;
const imageUrl = image ? new URL(image.url, Astro.site ?? site.url).href : undefined;
const ld = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{fullTitle}</title>
<meta name="description" content={description} />
{!is404 && <link rel="canonical" href={canonical} />}
<meta name="author" content={site.name} />
{noindex ? <meta name="robots" content="noindex, nofollow, noimageindex" /> : <meta name="robots" content="index, follow, max-image-preview:large" />}
{noReferrer && <meta name="referrer" content="no-referrer" />}
<meta name="generator" content={Astro.generator} />

<!-- Browser-Symbol: „J“ in Migha (Bold) auf Dark Blue (SVG), dazu .ico für ältere Browser und ein Symbol für den
     Home-Bildschirm. Neu erzeugen: siehe README („Browser-Symbol“). -->
<link rel="icon" href="/favicon.ico" sizes="32x32" />
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<link rel="sitemap" href="/sitemap-index.xml" />
<meta name="theme-color" content="#efe7d3" />

{/* Wichtigstes Bild zuerst ankündigen: lädt parallel zur Seite statt erst, wenn der Browser beim <img> ankommt */}
{preload && <link rel="preload" as="image" type="image/avif" imagesrcset={preload.srcset} imagesizes={preload.sizes} fetchpriority="high" />}
<link rel="preload" href={displayFont} as="font" type="font/woff2" crossorigin />
<link rel="preload" href={sansFont} as="font" type="font/woff2" crossorigin />
<link rel="preload" href={nameFont} as="font" type="font/otf" crossorigin />

<!-- Open Graph / Twitter -->
<meta property="og:site_name" content={site.name} />
<meta property="og:locale" content={site.ogLocale} />
<meta property="og:type" content={type} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
{!is404 && <meta property="og:url" content={canonical} />}
{
  imageUrl && (
    <>
      <meta property="og:image" content={imageUrl} />
      <meta property="og:image:width" content={String(image!.width)} />
      <meta property="og:image:height" content={String(image!.height)} />
      {image!.alt && <meta property="og:image:alt" content={image!.alt} />}
    </>
  )
}
<meta name="twitter:card" content={imageUrl ? 'summary_large_image' : 'summary'} />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
{imageUrl && <meta name="twitter:image" content={imageUrl} />}

<!-- Markiert, dass JavaScript läuft (für Elemente, die nur mit JS funktionieren) -->
<script is:inline>
  document.documentElement.classList.add('js');
</script>

{ld.map((data) => <script type="application/ld+json" set:html={JSON.stringify(data)} />)}

{
  site.analytics.goatcounter && !noindex && (
    <script
      is:inline
      async
      data-goatcounter={`https://${site.analytics.goatcounter}.goatcounter.com/count`}
      src="https://gc.zgo.at/count.js"
    />
  )
}
