---
import displayFont from '@fontsource-variable/anybody/files/anybody-latin-standard-normal.woff2?url';
import sansFont from '@fontsource-variable/archivo/files/archivo-latin-standard-normal.woff2?url';
import { site } from '../config/site';

export interface Props {
  title?: string;
  description?: string;
  /** Absolute oder root-relative URL des Vorschaubilds */
  image?: { url: string; width: number; height: number; alt?: string };
  /** noindex für Unlisted-Galerien */
  noindex?: boolean;
  /** Referrer unterdrücken (Unlisted: Slug soll nicht an externe Seiten weitergegeben werden) */
  noReferrer?: boolean;
  type?: 'website' | 'article' | 'profile';
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const { title, description = site.description, image, noindex = false, noReferrer = false, type = 'website', jsonLd } =
  Astro.props;

const fullTitle = title ? `${title} – ${site.name}` : `${site.name} – ${site.claim.replace(/\.$/, '')}`;
const is404 = Astro.url.pathname.startsWith('/404');
const canonical = new URL(Astro.url.pathname, Astro.site ?? site.url).href;
const imageUrl = image ? new URL(image.url, Astro.site ?? site.url).href : undefined;
const ld = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{fullTitle}</title>
<meta name="description" content={description} />
{!is404 && <link rel="canonical" href={canonical} />}
<meta name="author" content={site.name} />
{noindex ? <meta name="robots" content="noindex, nofollow, noimageindex" /> : <meta name="robots" content="index, follow, max-image-preview:large" />}
{noReferrer && <meta name="referrer" content="no-referrer" />}
<meta name="generator" content={Astro.generator} />

<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="sitemap" href="/sitemap-index.xml" />
<meta name="theme-color" content="#ffffff" />

<link rel="preload" href={displayFont} as="font" type="font/woff2" crossorigin />
<link rel="preload" href={sansFont} as="font" type="font/woff2" crossorigin />

<!-- Open Graph / Twitter -->
<meta property="og:site_name" content={site.name} />
<meta property="og:locale" content={site.ogLocale} />
<meta property="og:type" content={type} />
<meta property="og:title" content={title ?? site.name} />
<meta property="og:description" content={description} />
{!is404 && <meta property="og:url" content={canonical} />}
{
  imageUrl && (
    <>
      <meta property="og:image" content={imageUrl} />
      <meta property="og:image:width" content={String(image!.width)} />
      <meta property="og:image:height" content={String(image!.height)} />
      {image!.alt && <meta property="og:image:alt" content={image!.alt} />}
    </>
  )
}
<meta name="twitter:card" content={imageUrl ? 'summary_large_image' : 'summary'} />
<meta name="twitter:title" content={title ?? site.name} />
<meta name="twitter:description" content={description} />
{imageUrl && <meta name="twitter:image" content={imageUrl} />}

<!-- Markiert, dass JavaScript läuft (für Elemente, die nur mit JS funktionieren) -->
<script is:inline>
  document.documentElement.classList.add('js');
</script>

{ld.map((data) => <script type="application/ld+json" set:html={JSON.stringify(data)} />)}

{
  site.analytics.goatcounter && !noindex && (
    <script
      is:inline
      async
      data-goatcounter={`https://${site.analytics.goatcounter}.goatcounter.com/count`}
      src="https://gc.zgo.at/count.js"
    />
  )
}
