---
/**
 * Download-Hinweis für die ganze Galerie. Wird nur gerendert, wenn downloadUrl gesetzt ist.
 * Wichtig: Der Link führt zum externen Anbieter. Zugriffsschutz (Passwort/Ablaufdatum)
 * muss dort eingerichtet werden – diese statische Seite kann nichts schützen.
 */
import Icon from './Icon.astro';
import { useTranslations } from '../i18n';

export interface Props {
  url: string;
  size?: string;
  format?: string;
  note?: string;
}

const { url, size, format, note } = Astro.props;
const t = useTranslations();
const details = [size, format].filter(Boolean).join(' · ');
---

<div class="download">
  <a class="btn" href={url} target="_blank" rel="noopener noreferrer">
    <Icon name="download" />
    {t.download.gallery}
    <span class="visually-hidden">{t.download.external}</span>
  </a>
  {details && <p class="label details">{details}</p>}
  {note && <p class="note"><Icon name="lock" size="1em" /> {note}</p>}
</div>

<style>
  .download {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.25rem;
    padding: clamp(1rem, 2.5vw, 1.5rem);
    border-radius: var(--radius);
    background: var(--c, var(--lime));
    color: var(--on-c, var(--ink));
  }
  .note {
    flex-basis: 100%;
    display: flex;
    gap: 0.5em;
    align-items: baseline;
    font-size: var(--fs-sm);
    font-weight: 500;
  }
  .note :global(svg) {
    flex: none;
    translate: 0 0.15em;
  }
</style>
