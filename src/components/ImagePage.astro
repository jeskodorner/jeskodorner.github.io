---
/** Einzelbild-Seite (funktioniert ohne JavaScript, teilbar mit eigener Vorschau). */
import BaseLayout from '../layouts/BaseLayout.astro';
import Picture from './Picture.astro';
import ShareBox from './ShareBox.astro';
import Icon from './Icon.astro';
import type { Gallery, GalleryImage } from '../lib/galleries';
import { exifRows } from '../lib/exif';
import { getImage } from 'astro:assets';
import { responsive } from '../lib/images';
import { useTranslations, formatDate } from '../i18n';
import { site } from '../config/site';

export interface Props {
  gallery: Gallery;
  image: GalleryImage;
}

const { gallery, image } = Astro.props;
const t = useTranslations();
const n = gallery.images.length;
const prev = gallery.images[image.index - 2];
const next = gallery.images[image.index];
const rows = gallery.showExif ? exifRows(image.exif) : [];
const shotDate = gallery.showExif && image.exif.date ? new Date(image.exif.date) : undefined;
const absUrl = new URL(image.pageUrl, Astro.site ?? site.url).href;
const title = `${image.caption ?? gallery.title} (${t.image.of(image.index, n)})`;

const og = await getImage({ src: image.src, width: 1200, format: 'jpg', quality: 80 });
const set = await responsive(image.src);
const content = set.webpVariants.find((v) => v.width >= 1200) ?? set.largest;

const jsonLd = gallery.isUnlisted
  ? undefined
  : {
      '@context': 'https://schema.org',
      '@type': 'ImageObject',
      contentUrl: new URL(content.url, site.url).href,
      url: absUrl,
      name: image.caption ?? image.alt,
      description: image.alt,
      creator: { '@type': 'Person', name: site.name, url: site.url },
      creditText: site.name,
      copyrightNotice: `© ${site.name}`,
      acquireLicensePage: new URL('/kontakt/', site.url).href,
      isPartOf: { '@type': 'ImageGallery', name: gallery.title, url: new URL(gallery.url, site.url).href },
    };
---

<BaseLayout
  title={title}
  description={image.alt}
  image={{ url: og.src, width: 1200, height: Math.round((1200 * image.src.height) / image.src.width), alt: image.alt }}
  noindex={gallery.isUnlisted}
  noReferrer={gallery.isUnlisted}
  jsonLd={jsonLd}
>
  <div class="container container--wide img-page">
    <nav class="top label" aria-label="Bildnavigation">
      <!-- #pos-N scrollt nur zum Bild; #bild-N würde die Lightbox öffnen -->
      <a class="back" href={`${gallery.url}#pos-${image.index}`}>
        <Icon name="arrow-left" /> {t.image.back}: {gallery.title}
      </a>
      <span class="count muted">{t.image.of(image.index, n)}</span>
    </nav>

    <figure>
      <!-- Bild mit Vor/Zurück links und rechts (auf dem Handy darunter); Pfeiltasten siehe Skript unten -->
      <div class="viewer">
        {
          prev ? (
            <a class="step step--prev" href={prev.pageUrl} rel="prev" aria-keyshortcuts="ArrowLeft" title="Pfeiltaste ←">
              <span class="step-circle" aria-hidden="true">
                <Icon name="arrow-left" />
              </span>
              <span class="step-label">{t.image.prev}</span>
            </a>
          ) : (
            <span class="step step--prev" />
          )
        }
        <div class="frame">
          <Picture
            src={image.src}
            alt={image.alt}
            sizes="(min-width: 1200px) 80vw, 100vw"
            color={image.color}
            lqip={image.lqip}
            loading="eager"
            fetchpriority="high"
            class="main-img"
          />
        </div>
        {
          next ? (
            <a class="step step--next" href={next.pageUrl} rel="next" aria-keyshortcuts="ArrowRight" title="Pfeiltaste →">
              <span class="step-circle" aria-hidden="true">
                <Icon name="arrow-right" />
              </span>
              <span class="step-label">{t.image.next}</span>
            </a>
          ) : (
            <span class="step step--next" />
          )
        }
      </div>
      <figcaption>
        <h1 class="display display-3">{image.caption ?? gallery.title}</h1>
        {image.caption && <p class="label muted">{gallery.title}</p>}
      </figcaption>
    </figure>

    <div class="details">
      {
        (rows.length > 0 || shotDate) && (
          <section aria-labelledby="exif-h">
            <h2 id="exif-h" class="label muted">{t.image.exif}</h2>
            <dl class="exif">
              {rows.map((r) => (
                <div>
                  <dt>{r.label}</dt>
                  <dd>{r.value}</dd>
                </div>
              ))}
              {shotDate && !Number.isNaN(shotDate.getTime()) && (
                <div>
                  <dt>{t.image.date}</dt>
                  <dd>{formatDate(shotDate)}</dd>
                </div>
              )}
            </dl>
          </section>
        )
      }
      <div class="actions">
        {
          image.originalUrl && (
            <a class="btn btn--accent" href={image.originalUrl} target="_blank" rel="noopener noreferrer">
              <Icon name="download" /> {t.download.original}
              <span class="visually-hidden">{t.download.external}</span>
            </a>
          )
        }
        <ShareBox url={absUrl} title={title} template={gallery.shareText} />
      </div>
    </div>

  </div>
  {
    /* Chrome/Edge laden das nächste Bild schon im Hintergrund vor – Weiterblättern wirkt dann sofort.
       Andere Browser ignorieren das. */
    next && <script is:inline type="speculationrules" set:html={JSON.stringify({ prerender: [{ urls: [next.pageUrl] }] })} />
  }
</BaseLayout>

<script>
  // Tastatur: ← vorheriges Bild, → nächstes Bild, Esc zurück zur Galerie
  const isOpen = (sel: string) => {
    try {
      return document.querySelector(sel) !== null;
    } catch {
      return false; // Browser kennt den Selektor nicht
    }
  };
  document.addEventListener('keydown', (e) => {
    if (e.defaultPrevented || e.altKey || e.ctrlKey || e.metaKey || e.shiftKey) return;
    if ((e.target as HTMLElement).closest('input, textarea, select, [contenteditable]')) return;
    if (isOpen(':popover-open') || isOpen('dialog[open]')) return; // z. B. Handy-Menü offen
    const sel = { ArrowLeft: 'a.step[rel="prev"]', ArrowRight: 'a.step[rel="next"]', Escape: 'a.back' }[e.key];
    const link = sel ? document.querySelector<HTMLAnchorElement>(sel) : null;
    if (!link) return;
    e.preventDefault();
    link.click();
  });
</script>

<style>
  .img-page {
    padding-top: clamp(1.25rem, 3vw, 2.5rem);
  }
  .top {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }
  .back {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    text-decoration: none;
  }
  figure {
    margin-top: 1.25rem;
  }

  /* Handy: Bild oben, darunter Zurück (links) und Weiter (rechts) */
  .viewer {
    --frame-pad: clamp(0.5rem, 3vw, 3rem);
    display: grid;
    grid-template-columns: 1fr 1fr;
    grid-template-areas:
      'img img'
      'prev next';
    column-gap: 1rem;
  }
  .frame {
    grid-area: img;
    min-width: 0;
  }
  .step {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    color: var(--ink);
    text-decoration: none;
  }
  .step--prev {
    grid-area: prev;
    justify-self: start;
  }
  .step--next {
    grid-area: next;
    justify-self: end;
    flex-direction: row-reverse;
    text-align: right;
  }
  .step-circle {
    display: grid;
    place-items: center;
    flex: none;
    width: 3.5rem;
    height: 3.5rem;
    border: 2.5px solid var(--ink);
    border-radius: 50%;
    background: var(--wall);
    transition:
      background-color 0.2s,
      scale 0.3s var(--pop);
  }
  .step-circle :global(svg) {
    width: 1.4rem;
    height: 1.4rem;
    transition: translate 0.3s var(--pop);
  }
  .step-label {
    font-size: var(--fs-xs);
    font-weight: 800;
    font-stretch: 85%;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    line-height: 1.3;
  }
  .step:hover .step-circle {
    background: var(--lime);
    scale: 1.06;
  }
  .step--prev:hover .step-circle :global(svg) {
    translate: -0.2rem 0;
  }
  .step--next:hover .step-circle :global(svg) {
    translate: 0.2rem 0;
  }
  /* Fokusring am Kreis statt um die ganze Klickfläche */
  .step:focus-visible {
    outline: none;
  }
  .step:focus-visible .step-circle {
    background: var(--lime);
    outline: 3px solid var(--blue);
    outline-offset: 3px;
  }

  /* Ab Tablet: Zurück links, Weiter rechts neben dem Bild; die ganze Seitenfläche ist klickbar */
  @media (min-width: 900px) {
    .viewer {
      grid-template-columns: minmax(9rem, 1fr) minmax(0, auto) minmax(9rem, 1fr);
      grid-template-areas: 'prev img next';
      column-gap: clamp(1rem, 2vw, 2rem);
    }
    .step {
      flex-direction: column;
      align-items: flex-start;
      justify-self: stretch;
      padding-top: calc(var(--frame-pad) + 1.25rem);
    }
    .step--next {
      flex-direction: column;
      align-items: flex-end;
    }
  }

  /* Das Bild hängt frei an der weißen Wand */
  .frame {
    display: grid;
    place-items: center;
    padding: var(--frame-pad) 0;
  }
  .frame :global(.main-img) {
    width: auto;
    max-width: 100%;
    max-height: calc(100svh - var(--header-h) - 9rem);
    object-fit: contain;
    box-shadow: var(--hang-shadow);
  }
  figcaption {
    margin-top: 1.25rem;
    display: grid;
    gap: 0.4rem;
  }
  .details {
    display: grid;
    gap: 2rem;
    margin-top: 2rem;
    padding: clamp(1.25rem, 3vw, 2rem);
    background: var(--wall-2);
    border-radius: var(--radius);
  }
  @media (min-width: 900px) {
    .details {
      grid-template-columns: 1fr 1fr;
    }
  }
  .exif {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(10rem, 1fr));
    gap: 1rem 1.5rem;
    margin-top: 0.8rem;
  }
  .exif dt {
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--ink-soft);
    font-weight: 650;
  }
  .exif dd {
    font-family: var(--font-display);
    font-size: 1.6rem;
    font-weight: 800;
    font-stretch: 70%;
    line-height: 1.1;
    font-variant-numeric: tabular-nums;
  }
  .actions {
    display: grid;
    gap: 1.5rem;
    align-content: start;
    justify-items: start;
  }
</style>
