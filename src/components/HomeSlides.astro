---
/**
 * Fotofläche der Startseite (Richtung „Bild neben Name“): immer EIN Foto, ganz und scharf, darunter die
 * Bildunterschrift: Albumname und Monat (bis 20.11.2026 auch „Mappe ansehen →“). Die Fotos kommen aus dem Portfolio (Liste „showroom“ in
 * src/content/pages/startseite.md) in dieser Reihenfolge und wechseln alle 7 Sekunden: Das neue Foto blendet weich
 * über dem alten ein (das alte bleibt darunter stehen, bis das neue ganz da ist – keine leere Fläche dazwischen) und
 * setzt sich dabei langsam aus einer leichten Vergrößerung. Alle Fotos füllen dieselbe Fläche (Laptop 4:3, Handy ein
 * Streifen), zugeschnitten auf ihren Bildschwerpunkt – so gibt es keinen Formatwechsel; ganz zu sehen sind sie in
 * der Mappe.
 * Die Stelle wird gemerkt (sessionStorage, nur in diesem Tab): Kommt man aus einer Mappe zurück, geht es mit dem Foto
 * weiter, das zuletzt zu sehen war, nicht wieder am Anfang.
 * Ein Foto wird erst gezeigt, wenn es fertig geladen ist. Ohne JavaScript oder mit „Bewegung reduzieren“: nur das
 * erste Foto. Ein Klick aufs Foto oder auf die Bildunterschrift führt ins Portfolio, genau zu diesem Foto
 * (#werk-<n>); die Mappen erreicht man nur noch übers Portfolio.
 * Größe und Lage bestimmt BlueMenu.astro (Laptop: rechte Spalte, Handy: ganz oben, randlos).
 * Die frühere Doppelbelichtung (zwei Fotos im Modus „Aufhellen“) liegt im Git-Tag alte-version-startseite-ueberblendung.
 */
import Picture from './Picture.astro';
import type { WorkItem } from '../lib/showroom';
import { formatMonth } from '../i18n';
import { tidyTitle } from '../lib/text';
import { HOME_SIZES, HOME_MAX_WIDTH } from '../lib/sizes';

export interface Props {
  works: WorkItem[];
}

const { works } = Astro.props;
// Die Fotos stehen im Portfolio in derselben Reihenfolge (getSelectedWorks) – #werk-<n> ist ihr Platz dort
const slides = works.map((w, i) => ({
  w,
  title: tidyTitle(w.name ?? w.album),
  meta: formatMonth(w.gallery.date),
  href: `/portfolio/#werk-${i + 1}`,
}));
const first = slides[0];
---

{
  first && (
    <div class="hs" data-slides>
      <a class="hs-frame" href={first.href} tabindex="-1" aria-hidden="true" data-slide-link>
        {slides.map((s, i) => (
          <Picture
            src={s.w.image.src}
            alt=""
            sizes={HOME_SIZES}
            maxWidth={HOME_MAX_WIDTH}
            color={s.w.image.color}
            loading={i === 0 ? 'eager' : 'lazy'}
            fetchpriority={i === 0 ? 'high' : 'low'}
            pictureClass={i === 0 ? 'hs-layer is-on' : 'hs-layer'}
            class="hs-img"
            style={`object-position:${s.w.image.focus}`}
          />
        ))}
      </a>
      <p class="hs-cap">
        <a class="hs-link" href={first.href} data-slide-link>
          <span class="hs-title" data-slide-title>{first.title}</span>
          <span class="hs-meta label" data-slide-meta>{first.meta}</span>
        </a>
      </p>
      <script
        type="application/json"
        data-slide-data
        set:html={JSON.stringify(slides.map((s) => ({ href: s.href, title: s.title, meta: s.meta })))}
      />
      {/* Sofort beim Aufbau (vor dem ersten Bild): zuletzt gesehenes Foto statt des ersten zeigen */}
      <script is:inline>
        (() => {
          try {
            const box = document.currentScript.closest('[data-slides]');
            const n = Number(sessionStorage.getItem('jd-slide'));
            const layers = box.querySelectorAll('.hs-layer');
            if (!n || n >= layers.length) return;
            const d = JSON.parse(box.querySelector('[data-slide-data]').textContent)[n];
            const img = layers[n].querySelector('img');
            if (img) img.loading = 'eager';
            layers[0].classList.remove('is-on');
            layers[n].classList.add('is-on');
            box.querySelectorAll('[data-slide-link]').forEach((a) => (a.href = d.href));
            box.querySelector('[data-slide-title]').textContent = d.title;
            box.querySelector('[data-slide-meta]').textContent = d.meta;
            box.dataset.start = String(n);
          } catch {}
        })();
      </script>
    </div>
  )
}

<script>
  const STEP = 7000; // ein neues Foto alle 7 s
  const FADE = 1800; // Dauer der Überblendung (wie im CSS)
  const decoded = (layer: HTMLElement) => {
    const img = layer.querySelector('img');
    if (!img) return Promise.resolve();
    img.loading = 'eager';
    return img.decode().catch(() => undefined);
  };
  const timeout = (ms: number) => new Promise<void>((r) => setTimeout(r, ms));

  function initSlides(box: HTMLElement) {
    const layers = [...box.querySelectorAll<HTMLElement>('.hs-layer')];
    const data: { href: string; title: string; meta: string }[] = JSON.parse(
      box.querySelector('[data-slide-data]')?.textContent || '[]',
    );
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (layers.length < 2 || reduce) return;

    const links = box.querySelectorAll<HTMLAnchorElement>('[data-slide-link]');
    const title = box.querySelector<HTMLElement>('[data-slide-title]');
    const meta = box.querySelector<HTMLElement>('[data-slide-meta]');
    const cap = box.querySelector<HTMLElement>('.hs-cap');
    // Startfoto: das zuletzt gesehene (vom Skript direkt im HTML gesetzt) oder das erste
    let i = Number(box.dataset.start) || 0;
    let z = 1;
    layers[i]!.style.zIndex = String(z);
    const remember = (n: number) => {
      try {
        sessionStorage.setItem('jd-slide', String(n));
      } catch {
        /* privates Fenster o. Ä.: dann eben ohne Merken */
      }
    };

    const tick = async () => {
      if (!document.hidden) {
        const n = (i + 1) % layers.length;
        layers[n]!.classList.add('is-ready');
        await Promise.race([decoded(layers[n]!), timeout(5000)]); // erst laden, dann überblenden
        // Das neue Foto liegt oben und blendet ein; das alte bleibt darunter voll sichtbar und geht erst, wenn das
        // neue ganz da ist – so scheint nie die Fläche dahinter durch
        const old = layers[i]!;
        const next = layers[n]!;
        next.classList.add('is-ready');
        next.style.zIndex = String(++z);
        next.classList.add('is-on');
        remember(n);
        setTimeout(() => old.classList.remove('is-on'), FADE + 100);
        // Bildunterschrift kurz aus- und mit dem neuen Foto wieder einblenden
        cap?.classList.add('is-changing');
        setTimeout(() => {
          const d = data[n];
          if (d) {
            links.forEach((a) => (a.href = d.href));
            if (title) title.textContent = d.title;
            if (meta) meta.textContent = d.meta;
          }
          cap?.classList.remove('is-changing');
        }, 350);
        i = n;
      }
      timer = setTimeout(tick, STEP);
    };
    let timer = setTimeout(tick, STEP);
    // Die übrigen Fotos erst nach dem Laden der Seite holen (in Ruhe, vor dem ersten Wechsel nach 7 s)
    const prepare = () => layers.forEach((l) => l.classList.add('is-ready'));
    if (document.readyState === 'complete') setTimeout(prepare, 1000);
    else addEventListener('load', () => setTimeout(prepare, 1000), { once: true });
    // Zurück aus dem Browser-Speicher (Zurück-Knopf): Foto bleibt, das nächste kommt erst wieder nach vollen 7 s
    addEventListener('pageshow', (e) => {
      if (!e.persisted) return;
      clearTimeout(timer);
      timer = setTimeout(tick, STEP);
    });
  }

  for (const box of document.querySelectorAll<HTMLElement>('[data-slides]')) initSlides(box);
</script>

<style>
  .hs {
    display: grid;
    grid-template-rows: minmax(0, 1fr) auto;
    gap: 0.9rem;
    min-height: 0;
    height: 100%;
  }
  .hs-frame {
    position: relative;
    display: block;
    min-height: 0;
    overflow: hidden;
  }
  /* Überblendung: weich (langsam an, langsam aus), 1,8 s; das neue Foto setzt sich dabei aus 4 % Vergrößerung */
  .hs :global(.hs-layer) {
    position: absolute;
    inset: 0;
    display: block;
    opacity: 0;
    transition: opacity 1.8s cubic-bezier(0.45, 0, 0.25, 1);
  }
  .hs :global(.hs-layer.is-on) {
    opacity: 1;
  }
  /* Ladezeit: Die weiteren Fotos laden erst, wenn die Seite steht (das Skript setzt is-ready nach dem Laden) – so
     teilt sich das erste Foto die Leitung nicht mit vier anderen */
  .hs :global(.hs-layer:not(.is-on):not(.is-ready)) {
    display: none;
  }
  .hs :global(.hs-img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scale(1.04);
    transition: transform 0s 1.9s; /* unsichtbar zurücksetzen, sobald das Foto ausgeblendet ist */
  }
  .hs :global(.hs-layer.is-on .hs-img) {
    transform: none;
    transition: transform 6s cubic-bezier(0.2, 0.6, 0.2, 1);
  }
  /* Bildunterschrift, immer gleich aufgebaut (auch bei langen Albumnamen): oben der Albumname in der Titelschrift
     kursiv (eine Zeile, notfalls mit …), darunter Monat · „Mappe ansehen →“. So bleibt die
     Bildunterschrift immer gleich hoch und das Foto darüber springt beim Wechsel nicht. */
  .hs-cap {
    display: flex;
    align-items: flex-end;
    gap: 1rem;
    color: var(--on-menu);
    transition: opacity 0.35s var(--ease);
  }
  .hs-cap.is-changing {
    opacity: 0;
  }
  .hs-link {
    display: grid;
    gap: 0.25rem;
    min-width: 0;
    min-height: 2.75rem; /* Tippfläche */
    align-content: end;
    color: inherit;
    text-decoration: none;
  }
  .hs-title {
    font-family: var(--font-display);
    font-weight: var(--display-wght);
    font-style: italic;
    font-size: clamp(1.15rem, 1rem + 0.5vw, 1.5rem);
    line-height: 1.1;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .hs-meta {
    justify-self: start;
    white-space: nowrap;
  }
  /* Überfahren: der Titel bekommt den orangen Unterstrich wie alle Titel neben Fotos */
  .hs-link:hover .hs-title {
    text-decoration: underline;
    text-decoration-color: var(--hover-line);
    text-decoration-thickness: 0.08em;
    text-underline-offset: 0.14em;
  }
  /* Laptop: eine feste Fläche im Format 4:3, unten auf der Bildunterschrift stehend (auf niedrigen Bildschirmen
     flacher) – jedes Foto füllt sie, Hoch- wie Querformat, also kein Formatwechsel beim Bildwechsel */
  @media (min-width: 1000px) {
    .hs-frame {
      align-self: end;
      width: 100%;
      aspect-ratio: 4 / 3;
      max-height: 100%;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .hs :global(.hs-layer),
    .hs :global(.hs-img) {
      transition: none;
      transform: none;
    }
  }
</style>
