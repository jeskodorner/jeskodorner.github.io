---
/**
 * Fotofläche der Startseite (Richtung „Bild neben Name“): immer EIN Foto, ganz und scharf, darunter eine Zeile mit
 * Album, Monat, „Album ansehen →“ und dem Zähler. Die Fotos kommen aus dem Portfolio (Liste „showroom“ in
 * src/content/pages/startseite.md) in dieser Reihenfolge und wechseln alle 7 Sekunden mit einer ruhigen Überblendung.
 * Ein Foto wird erst gezeigt, wenn es fertig geladen ist. Ohne JavaScript oder mit „Bewegung reduzieren“: nur das
 * erste Foto. Ein Klick aufs Foto oder auf die Zeile öffnet genau dieses Foto im Album.
 * Größe und Lage bestimmt BlueMenu.astro (Laptop: rechte Spalte, Handy: ganz oben, randlos).
 * Die frühere Doppelbelichtung (zwei Fotos im Modus „Aufhellen“) liegt im Git-Tag alte-version-startseite-ueberblendung.
 */
import Picture from './Picture.astro';
import type { WorkItem } from '../lib/showroom';
import { useTranslations, formatMonth } from '../i18n';
import { tidyTitle } from '../lib/text';

export interface Props {
  works: WorkItem[];
}

const { works } = Astro.props;
const t = useTranslations();
const slides = works.map((w) => ({
  w,
  title: tidyTitle(w.name ?? w.album),
  meta: [formatMonth(w.gallery.date), w.gallery.location].filter(Boolean).join(' · '),
}));
const pad = (n: number) => String(n).padStart(2, '0');
const first = slides[0];
---

{
  first && (
    <div class="hs" data-slides>
      <a class="hs-frame" href={first.w.photoHref} tabindex="-1" aria-hidden="true" data-slide-link>
        {slides.map((s, i) => (
          <Picture
            src={s.w.image.src}
            alt=""
            sizes="(min-width: 1000px) 58vw, 100vw"
            maxWidth={2000}
            color={s.w.image.color}
            loading={i === 0 ? 'eager' : 'lazy'}
            fetchpriority={i === 0 ? 'high' : 'low'}
            pictureClass={i === 0 ? 'hs-layer is-on' : 'hs-layer'}
            class="hs-img"
            style={`object-position:${s.w.image.focus}`}
          />
        ))}
      </a>
      <p class="hs-cap">
        <a class="hs-link" href={first.w.photoHref} data-slide-link>
          <span class="hs-title" data-slide-title>{first.title}</span>
          <span class="hs-meta label">
            <span class="hs-when"><span data-slide-meta>{first.meta}</span> · </span><span class="hs-go">{t.home.viewAlbum} →</span>
          </span>
        </a>
        {slides.length > 1 && (
          <span class="hs-count label" aria-hidden="true">
            <span data-slide-n>{pad(1)}</span> / {pad(slides.length)}
          </span>
        )}
      </p>
      <script
        type="application/json"
        data-slide-data
        set:html={JSON.stringify(slides.map((s) => ({ href: s.w.photoHref, title: s.title, meta: s.meta })))}
      />
    </div>
  )
}

<script>
  const STEP = 7000; // ein neues Foto alle 7 s
  const decoded = (layer: HTMLElement) => {
    const img = layer.querySelector('img');
    if (!img) return Promise.resolve();
    img.loading = 'eager';
    return img.decode().catch(() => undefined);
  };
  const timeout = (ms: number) => new Promise<void>((r) => setTimeout(r, ms));

  function initSlides(box: HTMLElement) {
    const layers = [...box.querySelectorAll<HTMLElement>('.hs-layer')];
    const data: { href: string; title: string; meta: string }[] = JSON.parse(
      box.querySelector('[data-slide-data]')?.textContent || '[]',
    );
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (layers.length < 2 || reduce) return;

    const links = box.querySelectorAll<HTMLAnchorElement>('[data-slide-link]');
    const title = box.querySelector<HTMLElement>('[data-slide-title]');
    const meta = box.querySelector<HTMLElement>('[data-slide-meta]');
    const num = box.querySelector<HTMLElement>('[data-slide-n]');
    const cap = box.querySelector<HTMLElement>('.hs-cap');
    let i = 0;

    const tick = async () => {
      if (!document.hidden) {
        const n = (i + 1) % layers.length;
        await Promise.race([decoded(layers[n]!), timeout(5000)]); // erst laden, dann überblenden
        layers[n]!.classList.add('is-on');
        layers[i]!.classList.remove('is-on');
        // Bildunterschrift kurz aus- und mit dem neuen Foto wieder einblenden
        cap?.classList.add('is-changing');
        setTimeout(() => {
          const d = data[n];
          if (d) {
            links.forEach((a) => (a.href = d.href));
            if (title) title.textContent = d.title;
            if (meta) meta.textContent = d.meta;
          }
          if (num) num.textContent = String(n + 1).padStart(2, '0');
          cap?.classList.remove('is-changing');
        }, 350);
        i = n;
      }
      setTimeout(tick, STEP);
    };
    setTimeout(tick, STEP);
  }

  for (const box of document.querySelectorAll<HTMLElement>('[data-slides]')) initSlides(box);
</script>

<style>
  .hs {
    display: grid;
    grid-template-rows: minmax(0, 1fr) auto;
    gap: 0.9rem;
    min-height: 0;
    height: 100%;
  }
  .hs-frame {
    position: relative;
    display: block;
    min-height: 0;
    overflow: hidden;
    background: rgb(0 0 0 / 0.12);
  }
  .hs :global(.hs-layer) {
    position: absolute;
    inset: 0;
    display: block;
    opacity: 0;
    transition: opacity 1.2s var(--ease);
  }
  .hs :global(.hs-layer.is-on) {
    opacity: 1;
  }
  .hs :global(.hs-img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  /* Bildunterschrift, immer gleich aufgebaut (auch bei langen Albumnamen): oben der Albumname in der Titelschrift
     kursiv (eine Zeile, notfalls mit …), darunter Monat · „Album ansehen →“; rechts der Zähler. So bleibt die
     Bildunterschrift immer gleich hoch und das Foto darüber springt beim Wechsel nicht. */
  .hs-cap {
    display: flex;
    align-items: flex-end;
    gap: 1rem;
    color: var(--on-menu);
    transition: opacity 0.35s var(--ease);
  }
  .hs-cap.is-changing {
    opacity: 0;
  }
  .hs-link {
    display: grid;
    gap: 0.25rem;
    min-width: 0;
    min-height: 2.75rem; /* Tippfläche */
    align-content: end;
    color: inherit;
    text-decoration: none;
  }
  .hs-title {
    font-family: var(--font-display);
    font-weight: var(--display-wght);
    font-style: italic;
    font-size: clamp(1.15rem, 1rem + 0.5vw, 1.5rem);
    line-height: 1.1;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .hs-meta {
    white-space: nowrap;
  }
  /* Überfahren: „Album ansehen →“ bekommt das Koralle-Feld (die Handlung, nicht der Name) */
  .hs-go {
    padding: 0.15em 0.3em;
    margin: -0.15em -0.3em;
    transition:
      background-color 0.2s,
      color 0.2s;
  }
  .hs-link:hover .hs-go {
    background: var(--hover);
    color: var(--ink);
  }
  .hs-count {
    margin-left: auto;
    flex: none;
    font-variant-numeric: tabular-nums;
  }
  /* Handy: Monat weglassen, damit die Zeile in eine Zeile passt */
  @media (max-width: 599.98px) {
    .hs-when {
      display: none;
    }
  }
  /* Laptop: das Foto ganz zeigen (nicht beschneiden), unten links auf der Bildunterschrift stehend – Hoch- und
     Querformate haben so dieselbe Unterkante und linke Kante */
  @media (min-width: 1000px) {
    .hs-frame {
      background: none;
    }
    .hs :global(.hs-img) {
      object-fit: contain;
      object-position: left bottom !important;
      background: none !important;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .hs :global(.hs-layer) {
      transition: none;
    }
  }
</style>
