---
/**
 * „Wand“ (große Ansicht im Album): Jedes Foto hängt einzeln an der weißen Wand –
 * unbeschnitten im Originalformat, mit viel Platz drumherum und leichtem Schatten.
 *   Desktop: ein Foto pro Bildschirm, mittig, so groß, dass es samt Schild ganz zu sehen ist.
 *            Beim Scrollen rastet die Galerie sanft Foto für Foto ein.
 *   Handy:   Foto in voller Breite (mit Rand), Schild darunter.
 * Schild unter dem Foto: Bildunterschrift (falls vorhanden), Aufnahmedaten und „3 / 12“.
 */
import type { GalleryImage, RoomColor } from '../lib/galleries';
import Picture from './Picture.astro';

export interface StageItem {
  image: GalleryImage;
  href: string;
  title?: string;
  kicker?: string;
  kickerHref?: string;
  meta?: string;
  /** Galeriefarbe (für die Nummer auf dem Schild) */
  color?: RoomColor;
  /** Zusätzliche Attribute am Bild-Link (Lightbox-Daten, id) */
  attrs?: Record<string, string | number | undefined>;
  /** Sprungziel ohne Lightbox, z. B. "pos-3" (für „Zur Galerie“ von der Bildseite) */
  anchor?: string;
}

export interface Props {
  items: StageItem[];
  /** Bilder öffnen die Lightbox (Galerieseite) */
  lightbox?: boolean;
  /** Erstes Bild sofort laden (wenn es oben auf der Seite steht) */
  eagerFirst?: boolean;
  /** Beim Scrollen sanft Bild für Bild einrasten (nur Desktop) */
  snap?: boolean;
  id?: string;
  count?: number;
  color?: RoomColor;
}

const { items, lightbox = false, eagerFirst = false, snap = false, id, count, color = 'pink' } = Astro.props;
const total = count ?? items.length;
const pad = (n: number) => String(n).padStart(String(total).length, '0');
---

<ol
  class:list={['stages', { 'stages--snap': snap }]}
  role="list"
  id={id}
  data-gallery={lightbox ? '' : undefined}
  data-count={lightbox ? total : undefined}
  data-layout="showcase"
>
  {
    items.map((s, i) => {
      const r = s.image.src.width / s.image.src.height;
      return (
        <li id={s.anchor} class:list={['stage', `c-${s.color ?? color}`]} style={`--r:${r.toFixed(4)}`}>
          <figure class="wall">
            <a class:list={['frame', { ph: lightbox }]} href={s.href} {...s.attrs}>
              <Picture
                src={s.image.src}
                alt={s.image.alt}
                sizes={`(min-width: 900px) ${Math.min(92, Math.round(r * 46))}vw, 92vw`}
                color={s.image.color}
                lqip={s.image.lqip}
                loading={eagerFirst && i === 0 ? 'eager' : 'lazy'}
                fetchpriority={eagerFirst && i === 0 ? 'high' : undefined}
                class="frame-img"
              />
            </a>
            <figcaption class="placard">
              <span class="pl-text">
                {s.title && <span class="pl-title">{s.title}</span>}
                {s.kicker &&
                  (s.kickerHref ? (
                    <a class="pl-kicker" href={s.kickerHref}>
                      {s.kicker} <span class="arrow" aria-hidden="true">→</span>
                    </a>
                  ) : (
                    <span class="pl-kicker">{s.kicker}</span>
                  ))}
                {s.meta && <span class="pl-meta">{s.meta}</span>}
              </span>
              <span class="pl-num label" aria-hidden="true">
                {pad(i + 1)} / {pad(total)}
              </span>
            </figcaption>
          </figure>
        </li>
      );
    })
  }
</ol>

<style>
  .stages {
    list-style: none;
    padding: 0;
    display: grid;
    gap: clamp(3rem, 2rem + 5vw, 6rem);
    /* Höchstens so hoch, dass Foto + Schild ganz auf den Bildschirm passen */
    --wall-h: max(16rem, calc(100svh - var(--header-h) - 11rem));
  }
  .stage {
    display: grid;
    justify-items: center;
    padding-inline: max(var(--gutter), 1.5rem);
  }
  .wall {
    margin: 0;
    display: grid;
    gap: 0.85rem;
    /* Breite aus dem Seitenverhältnis: nie höher als der Bildschirm erlaubt, nie breiter als der Platz */
    width: min(100%, 1600px, calc(var(--wall-h) * var(--r)));
  }
  .frame {
    display: block;
    box-shadow: var(--hang-shadow);
    cursor: zoom-in;
    outline-offset: 6px;
    transition: box-shadow 0.4s var(--ease);
  }
  .frame :global(.frame-img) {
    display: block;
    width: 100%;
    height: auto;
  }
  @media (hover: hover) {
    .frame:hover {
      box-shadow:
        0 2px 4px rgb(0 0 0 / 0.1),
        0 18px 40px -12px rgb(0 0 0 / 0.35),
        0 50px 90px -30px rgb(0 0 0 / 0.3);
    }
  }

  /* ---------- Schild ---------- */
  .placard {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
  }
  .pl-text {
    display: grid;
    gap: 0.2rem;
    min-width: 0;
    max-width: 40ch;
  }
  .pl-title {
    font-size: clamp(1.05rem, 0.95rem + 0.4vw, 1.3rem);
    font-weight: 700;
    line-height: 1.25;
  }
  .pl-kicker {
    font-size: var(--fs-sm);
    font-weight: 600;
  }
  a.pl-kicker {
    color: var(--accent);
  }
  .pl-meta {
    font-size: var(--fs-xs);
    color: var(--ink-soft);
    font-variant-numeric: tabular-nums;
  }
  .pl-num {
    flex: none;
    color: var(--ink-soft);
    font-variant-numeric: tabular-nums;
  }

  /* ---------- Desktop: ein Foto pro Bildschirm, mittig auf der Wand ---------- */
  @media (min-width: 900px) {
    .stages {
      gap: 0;
    }
    .stage {
      min-height: calc(100svh - var(--header-h));
      align-content: center;
      padding-block: 1.5rem;
    }

    /* Sanftes Einrasten Foto für Foto (Galerieseite) */
    :global(html:has(.stages--snap)) {
      scroll-snap-type: y proximity;
      scroll-padding-top: var(--header-h);
    }
    .stages--snap .stage {
      scroll-snap-align: start;
    }
  }
</style>
