---
/**
 * „Bühne“: Jedes Foto hängt wie ein Werk an der weißen Galeriewand, mit Werkschild daneben.
 * Die Anordnung ergibt sich automatisch aus dem Seitenverhältnis:
 *   Querformat → abwechselnd volle Breite / breit links / breit rechts
 *   Hochformat → abwechselnd links / rechts, Werkschild daneben
 *   (fast) quadratisch → mittig
 */
import type { GalleryImage, RoomColor } from '../lib/galleries';
import ParallaxImage from './ParallaxImage.astro';

export interface StageItem {
  image: GalleryImage;
  href: string;
  title?: string;
  kicker?: string;
  kickerHref?: string;
  meta?: string;
  /** Raumfarbe für Nummern-Sticker und Hover-Schatten */
  color?: RoomColor;
  /** Zusätzliche Attribute am Bild-Link (Lightbox-Daten, id) */
  attrs?: Record<string, string | number | undefined>;
}

export interface Props {
  items: StageItem[];
  /** Bilder öffnen die Lightbox (Galerieseite) */
  lightbox?: boolean;
  /** Erstes Bild sofort laden (wenn es oben auf der Seite steht) */
  eagerFirst?: boolean;
  id?: string;
  count?: number;
  color?: RoomColor;
}

const { items, lightbox = false, eagerFirst = false, id, count, color = 'pink' } = Astro.props;
const total = String(items.length).padStart(2, '0');

let landscape = 0;
let portrait = 0;
const staged = items.map((item, i) => {
  const r = item.image.src.width / item.image.src.height;
  let variant: string;
  if (r >= 1.25) {
    variant = ['full', 'wide-left', 'wide-right'][landscape % 3]!;
    landscape++;
  } else if (r <= 0.85) {
    variant = portrait % 2 === 0 ? 'tall-left' : 'tall-right';
    portrait++;
  } else {
    variant = 'square';
  }
  const sizes =
    variant === 'full'
      ? '(min-width: 900px) 92vw, 100vw'
      : variant.startsWith('wide')
        ? '(min-width: 900px) 70vw, 100vw'
        : variant === 'square'
          ? '(min-width: 900px) 60vw, 100vw'
          : '(min-width: 900px) 55vw, 100vw';
  return {
    ...item,
    variant,
    sizes,
    ratio: r,
    nr: String(i + 1).padStart(2, '0'),
    tilt: i % 2 === 0 ? '-2.5deg' : '2deg',
    color: item.color ?? color,
  };
});
---

<ol
  class="stages"
  role="list"
  id={id}
  data-gallery={lightbox ? '' : undefined}
  data-count={lightbox ? (count ?? items.length) : undefined}
  data-layout="showcase"
>
  {
    staged.map((s, i) => (
      <li class:list={['stage', `stage--${s.variant}`, `c-${s.color}`]} style={`--r:${s.ratio.toFixed(4)};--pop-rot:${s.tilt}`}>
        <ParallaxImage
          src={s.image.src}
          alt={s.image.alt}
          sizes={s.sizes}
          color={s.image.color}
          lqip={s.image.lqip}
          href={s.href}
          loading={eagerFirst && i === 0 ? 'eager' : 'lazy'}
          fetchpriority={eagerFirst && i === 0 ? 'high' : undefined}
          class:list={['stage-frame hang', { ph: lightbox }]}
          attrs={s.attrs}
        />
        <div class="placard rise">
          <p class="badge display" aria-hidden="true">
            {s.nr}
          </p>
          <div class="pl-text">
            <p class="label pl-count">
              Nº {s.nr} / {total}
            </p>
            {s.title && <p class="pl-title">{s.title}</p>}
            {s.kicker &&
              (s.kickerHref ? (
                <a class="pl-kicker" href={s.kickerHref}>
                  {s.kicker} <span class="arrow" aria-hidden="true">→</span>
                </a>
              ) : (
                <p class="pl-kicker">{s.kicker}</p>
              ))}
            {s.meta && <p class="pl-meta">{s.meta}</p>}
          </div>
        </div>
      </li>
    ))
  }
</ol>

<style>
  .stages {
    list-style: none;
    padding: 0;
    display: grid;
    gap: clamp(5rem, 2rem + 12vw, 15rem);
  }
  .stage {
    width: 100%;
    max-width: 2400px;
    margin-inline: auto;
    padding-inline: var(--gutter);
    display: grid;
    gap: clamp(1.25rem, 2.5vw, 2rem);
  }
  .stage :global(.stage-frame) {
    width: 100%;
    transition:
      translate 0.35s var(--pop),
      box-shadow 0.35s var(--pop);
  }
  /* Hover: harter Schatten in der Raumfarbe – das Bild springt von der Wand */
  @media (hover: hover) {
    .stage :global(.stage-frame:hover) {
      translate: -10px -10px;
      box-shadow:
        18px 18px 0 var(--c),
        var(--hang-shadow);
    }
  }

  /* Werkschild */
  .placard {
    display: flex;
    align-items: flex-start;
    gap: clamp(0.9rem, 2vw, 1.4rem);
  }
  .badge {
    flex: none;
    display: grid;
    place-items: center;
    width: clamp(3.6rem, 2.6rem + 3vw, 6rem);
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--c);
    color: var(--on-c);
    font-size: clamp(1.5rem, 1rem + 1.6vw, 2.6rem);
    font-stretch: 70%;
    line-height: 1;
    padding-top: 0.08em;
    rotate: -8deg;
  }
  .pl-text {
    display: grid;
    gap: 0.3rem;
    min-width: 0;
    max-width: 30ch;
    padding-top: 0.2rem;
  }
  .pl-count {
    color: var(--ink-soft);
  }
  .pl-title {
    font-size: clamp(1.15rem, 1rem + 0.7vw, 1.6rem);
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: -0.01em;
  }
  .pl-kicker {
    font-size: var(--fs-sm);
    font-weight: 600;
    color: var(--ink);
    text-decoration: none;
  }
  a.pl-kicker {
    color: var(--accent);
    text-decoration: underline;
  }
  .pl-meta {
    font-size: var(--fs-xs);
    color: var(--ink-soft);
    font-variant-numeric: tabular-nums;
  }

  /* ---------- Mobil: alles groß und untereinander ---------- */
  .stage--full :global(.stage-frame) {
    max-height: 92svh;
  }
  .stage--tall-left :global(.stage-frame),
  .stage--tall-right :global(.stage-frame) {
    max-height: 86svh;
  }

  /* ---------- Desktop: jedes Bild bekommt seine eigene Wand ---------- */
  @media (min-width: 900px) {
    .stage--full {
      padding-inline: clamp(2rem, 4vw, 6rem);
    }
    .stage--wide-left,
    .stage--wide-right {
      grid-template-columns: 70fr 30fr;
      align-items: end;
      column-gap: clamp(1.5rem, 3.5vw, 4rem);
    }
    .stage--wide-right {
      grid-template-columns: 30fr 70fr;
    }
    .stage--wide-right :global(.stage-frame) {
      grid-column: 2;
      grid-row: 1;
    }
    .stage--wide-right .placard {
      grid-column: 1;
      grid-row: 1;
      justify-self: end;
      flex-direction: row-reverse;
      text-align: right;
    }
    .stage--wide-left :global(.stage-frame),
    .stage--wide-right :global(.stage-frame) {
      max-height: 90svh;
    }

    .stage--tall-left,
    .stage--tall-right {
      grid-template-columns: auto 1fr;
      align-items: center;
      column-gap: clamp(2rem, 6vw, 8rem);
    }
    .stage--tall-right {
      grid-template-columns: 1fr auto;
    }
    .stage--tall-left :global(.stage-frame),
    .stage--tall-right :global(.stage-frame) {
      height: min(88svh, 1300px);
      width: auto;
      max-height: none;
    }
    .stage--tall-right :global(.stage-frame) {
      grid-column: 2;
      grid-row: 1;
    }
    .stage--tall-right .placard {
      grid-column: 1;
      grid-row: 1;
      justify-self: end;
      text-align: right;
      flex-direction: row-reverse;
    }

    .stage--square {
      justify-items: center;
    }
    .stage--square :global(.stage-frame) {
      width: min(60vw, 84svh);
    }
  }
</style>
