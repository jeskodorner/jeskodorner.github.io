---
/**
 * „Bühne“: Jedes Foto füllt den Bildschirm.
 *   Querformat        → Vollbild, Werkschild als weiße Karte unten links
 *   Hoch-/Quadratformat mit Titel → Bildschirm geteilt: eine Hälfte Bild, eine Hälfte Galeriefarbe mit großem Titel
 *                       (abwechselnd links/rechts)
 *   Hoch-/Quadratformat ohne Titel → Bild unbeschnitten in voller Höhe mittig, Galeriefarbe füllt links und rechts
 * Auf dem Handy: Bilder in voller Breite im Originalformat (kein Zuschnitt), Werkschild darunter.
 * Ausschnitt bei Vollbild: Feld "focus" pro Bild (z. B. "50% 30%").
 */
import type { GalleryImage, RoomColor } from '../lib/galleries';
import ParallaxImage from './ParallaxImage.astro';

export interface StageItem {
  image: GalleryImage;
  href: string;
  title?: string;
  kicker?: string;
  kickerHref?: string;
  meta?: string;
  /** Galeriefarbe für die Farbhälfte */
  color?: RoomColor;
  /** Zusätzliche Attribute am Bild-Link (Lightbox-Daten, id) */
  attrs?: Record<string, string | number | undefined>;
}

export interface Props {
  items: StageItem[];
  /** Bilder öffnen die Lightbox (Galerieseite) */
  lightbox?: boolean;
  /** Erstes Bild sofort laden (wenn es oben auf der Seite steht) */
  eagerFirst?: boolean;
  /** Beim Scrollen sanft Bild für Bild einrasten (nur Desktop) */
  snap?: boolean;
  id?: string;
  count?: number;
  color?: RoomColor;
}

const { items, lightbox = false, eagerFirst = false, snap = false, id, count, color = 'pink' } = Astro.props;

let splits = 0;
const staged = items.map((item, i) => {
  const r = item.image.src.width / item.image.src.height;
  let variant: 'full' | 'center' | 'split-left' | 'split-right';
  if (r >= 1.2) {
    variant = 'full';
  } else if (!item.title) {
    variant = 'center';
  } else {
    variant = splits % 2 === 0 ? 'split-left' : 'split-right';
    splits++;
  }
  return {
    ...item,
    variant,
    sizes: variant === 'full' ? '100vw' : variant === 'center' ? '(min-width: 900px) 60vw, 100vw' : '(min-width: 900px) 50vw, 100vw',
    color: item.color ?? color,
  };
});
---

<ol
  class:list={['stages', { 'stages--snap': snap }]}
  role="list"
  id={id}
  data-gallery={lightbox ? '' : undefined}
  data-count={lightbox ? (count ?? items.length) : undefined}
  data-layout="showcase"
>
  {
    staged.map((s, i) => (
      <li class:list={['stage', `stage--${s.variant}`, `c-${s.color}`]} style={`--r:${(s.image.src.width / s.image.src.height).toFixed(4)}`}>
        <ParallaxImage
          src={s.image.src}
          alt={s.image.alt}
          sizes={s.sizes}
          color={s.image.color}
          lqip={s.image.lqip}
          href={s.href}
          focus={s.image.focus}
          loading={eagerFirst && i === 0 ? 'eager' : 'lazy'}
          fetchpriority={eagerFirst && i === 0 ? 'high' : undefined}
          class:list={['stage-frame', { ph: lightbox }]}
          attrs={s.attrs}
        />
        <div class="placard">
          <div class="pl-text">
            {s.title && <p class="pl-title">{s.title}</p>}
            {s.kicker &&
              (s.kickerHref ? (
                <a class="pl-kicker" href={s.kickerHref}>
                  {s.kicker} <span class="arrow" aria-hidden="true">→</span>
                </a>
              ) : (
                <p class="pl-kicker">{s.kicker}</p>
              ))}
            {s.meta && <p class="pl-meta">{s.meta}</p>}
          </div>
        </div>
      </li>
    ))
  }
</ol>

<style>
  .stages {
    list-style: none;
    padding: 0;
    display: grid;
    gap: clamp(0.5rem, 1vw, 0.9rem);
    /* Höhe einer Bühne: Bildschirm minus kompakter Header */
    --stage-h: calc(100svh - var(--header-h) + 1rem);
  }
  .stage {
    position: relative;
    display: grid;
  }
  /* Ruhigere Parallax-Bewegung bei Vollbild (weniger Zuschnitt) */
  .stage :global(.stage-frame) {
    --px-scale: 1.08;
    --px-from: -3.5%;
    --px-to: 3.5%;
    width: 100%;
  }

  /* ---------- Werkschild ---------- */
  .placard {
    display: flex;
    align-items: flex-end;
    gap: 1rem;
    padding: clamp(1rem, 3vw, 1.75rem) var(--gutter);
  }
  .pl-text {
    display: grid;
    gap: 0.3rem;
    min-width: 0;
    max-width: 34ch;
    padding-bottom: 0.15rem;
  }
  .pl-title {
    font-size: clamp(1.15rem, 1rem + 0.7vw, 1.6rem);
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: -0.01em;
  }
  .pl-kicker {
    font-size: var(--fs-sm);
    font-weight: 600;
    text-decoration: none;
  }
  a.pl-kicker {
    color: var(--accent);
    text-decoration: underline;
  }
  .pl-meta {
    font-size: var(--fs-xs);
    color: var(--ink-soft);
    font-variant-numeric: tabular-nums;
  }

  /* ---------- Desktop: jedes Bild füllt den Bildschirm ---------- */
  @media (min-width: 900px) {
    .stage {
      height: var(--stage-h);
      min-height: 32rem;
    }
    .stage :global(.stage-frame) {
      aspect-ratio: auto !important;
      height: 100%;
    }

    /* Vollbild + weiße Karte */
    .stage--full :global(.stage-frame) {
      position: absolute;
      inset: 0;
    }
    .stage--full .placard {
      position: absolute;
      left: var(--gutter);
      bottom: var(--gutter);
      z-index: 1;
      padding: 1rem 1.25rem;
      background: var(--wall);
      border-radius: var(--radius);
      box-shadow: 0 10px 40px -12px rgb(0 0 0 / 0.35);
    }

    /* Hochformat ohne Titel: unbeschnitten mittig, Galeriefarbe füllt den Rest */
    .stage--center {
      background: var(--c);
      color: var(--on-c);
      justify-items: center;
    }
    .stage--center :global(.stage-frame) {
      aspect-ratio: var(--r) !important;
      width: auto;
      height: 100%;
      max-width: 100%;
    }
    .stage--center .placard {
      position: absolute;
      left: 0;
      bottom: 0;
      padding: var(--gutter);
    }
    .stage--center .pl-meta,
    .stage--center a.pl-kicker {
      color: inherit;
    }

    /* Geteilter Bildschirm: Bild + Farbhälfte */
    .stage--split-left,
    .stage--split-right {
      grid-template-columns: 1fr 1fr;
    }
    .stage--split-right :global(.stage-frame) {
      grid-column: 2;
      grid-row: 1;
    }
    .stage--split-left .placard,
    .stage--split-right .placard {
      grid-row: 1;
      flex-direction: column;
      align-items: flex-start;
      justify-content: flex-end;
      gap: 1.5rem;
      padding: clamp(2rem, 4vw, 4.5rem);
      background: var(--c);
      color: var(--on-c);
    }
    .stage--split-right .placard {
      grid-column: 1;
    }
    .stage--split-left .pl-meta,
    .stage--split-right .pl-meta {
      color: inherit;
    }
    .stage--split-left .pl-title,
    .stage--split-right .pl-title {
      font-family: var(--font-display);
      font-weight: 860;
      font-stretch: 62%;
      text-transform: uppercase;
      font-size: clamp(3rem, 1rem + 4.5vw, 7.5rem);
      line-height: 0.88;
      letter-spacing: -0.01em;
      padding-top: 0.08em;
    }
    .stage--split-left .pl-text,
    .stage--split-right .pl-text {
      max-width: 36rem;
      gap: 0.75rem;
    }
    .stage--split-left .pl-kicker,
    .stage--split-left .pl-meta,
    .stage--split-right .pl-kicker,
    .stage--split-right .pl-meta {
      font-size: var(--fs-sm);
    }
    .stage--split-left a.pl-kicker,
    .stage--split-right a.pl-kicker {
      color: inherit;
    }

    /* Sanftes Einrasten Bild für Bild (Galerieseite) */
    :global(html:has(.stages--snap)) {
      scroll-snap-type: y proximity;
    }
    .stages--snap .stage {
      scroll-snap-align: start;
      scroll-margin-top: calc(var(--header-h) - 1rem);
    }
  }
</style>
