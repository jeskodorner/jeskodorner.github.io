---
import { site } from '../config/site';
import { useTranslations } from '../i18n';
import Icon from './Icon.astro';
import EmailLink from './EmailLink.astro';

const t = useTranslations();
const year = new Date().getFullYear();
const years = year > site.copyrightSince ? `${site.copyrightSince}–${year}` : String(year);
---

<footer class="site-footer">
  <div class="container container--wide">
    <div class="top">
      <div class="contact">
        <h2 class="visually-hidden">{t.nav.contact}</h2>
        <p class="links">
          <EmailLink class="big-link tap" />
          <a class="big-link tap" href={site.instagram.url} rel="me noopener" target="_blank">
            <Icon name="instagram" size="0.9em" /> {site.instagram.handle.toLowerCase()}
          </a>
        </p>
      </div>
      <nav class="legal" aria-label="Rechtliches">
        <a class="tap" href="/impressum/">{t.footer.imprint}</a>
        <a class="tap" href="/datenschutz/">{t.footer.privacy}</a>
        <a class="to-top tap" href="#top">{t.footer.top} <Icon name="arrow-up" /></a>
      </nav>
    </div>

    <div class="wordmark-wrap">
      <p class="wordmark display" aria-hidden="true">Jesko Dorner</p>
    </div>

    <p class="copy label">
      <small>© {years} {site.name}. {t.footer.rights}</small>
    </p>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: var(--section);
    padding-top: clamp(2.5rem, 5vw, 4.5rem);
    padding-bottom: 1.5rem;
    background: var(--ink);
    color: var(--wall);
    overflow: hidden;
  }
  /* Überfahren: einheitlich das Blau der Links, für Schwarz aufgehellt (auch für den E-Mail-Link aus EmailLink.astro) */
  .site-footer :global(a:hover) {
    color: var(--accent-on-dark);
  }
  /* Adressen links, Rechtliches rechts – beide auf derselben Grundlinie (nicht an der Unterkante der Kästen) */
  .top {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-end;
    align-items: last baseline;
    gap: 1.5rem 2rem;
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 1.15rem 2rem; /* untereinander (Handy): Abstand so, dass die 44-px-Tippflächen nicht überlappen */

  }
  .to-top {
    display: inline-flex;
    align-items: center;
    gap: 0.3em;
  }
  .to-top :global(svg) {
    transition: translate 0.3s var(--pop);
  }
  .to-top:hover :global(svg) {
    translate: 0 -0.2em;
  }
  .contact :global(.big-link) {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    font-size: var(--fs-lead);
    font-weight: 600;
    text-decoration: none;
    line-height: 1.3;
  }
  .legal {
    display: flex;
    flex-wrap: wrap;
    gap: 1.35rem 1.75rem; /* zweite Zeile am Handy: Tippflächen (44 px) überlappen nicht */

    font-size: var(--fs-sm);
    font-weight: 750;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .legal a {
    text-decoration: none;
  }
  /* Der Schriftzug füllt die Breite des Inhaltsbereichs (cqi = 1 % davon): „Jesko Dorner“ ist in Bodoni Moda (Stärke
     600) 6,08 × so breit wie die Schriftgröße → / 6.25 lässt etwas Luft. (Instrument Serif: 4,17 → / 4.3) */
  .wordmark-wrap {
    container-type: inline-size;
  }
  .wordmark {
    margin-top: clamp(2.5rem, 6vw, 5rem);
    white-space: nowrap;
    font-size: clamp(3rem, 23vw, 34rem);
    font-size: calc(100cqi / 6.25);
    font-weight: 600;
    line-height: 0.95;
    /* Der Bogen des „J“ reicht 0,22 Schrifthöhen unter die Grundlinie, die Zeile endet schon bei 0,135 – Platz
       schaffen, damit er nicht in die Copyright-Zeile darunter ragt */
    padding-bottom: 0.1em;
    color: var(--pink);
    user-select: none;
  }
  .copy {
    margin-top: 1.25rem;
    color: var(--ink-soft-on-dark);
  }
  .copy small {
    font-size: inherit;
  }
</style>
