---
import { site } from '../config/site';
import { useTranslations } from '../i18n';
import Icon from './Icon.astro';
import EmailLink from './EmailLink.astro';

const t = useTranslations();
const year = new Date().getFullYear();
const years = year > site.copyrightSince ? `${site.copyrightSince}–${year}` : String(year);
---

<footer class="site-footer">
  <div class="container container--wide">
    <div class="top">
      <div class="contact">
        <h2 class="visually-hidden">{t.nav.contact}</h2>
        <p class="links">
          <EmailLink class="big-link tap" />
          <a class="big-link tap" href={site.instagram.url} rel="me noopener" target="_blank">
            <Icon name="instagram" size="0.9em" /> {site.instagram.handle.toLowerCase()}
          </a>
        </p>
      </div>
      <nav class="legal" aria-label="Rechtliches">
        <a class="tap" href="/impressum/">{t.footer.imprint}</a>
        <a class="tap" href="/datenschutz/">{t.footer.privacy}</a>
        <a class="to-top tap" href="#top">{t.footer.top} <Icon name="arrow-up" /></a>
      </nav>
    </div>

    <div class="wordmark-wrap">
      <p class="wordmark display" aria-hidden="true">Jesko Dorner</p>
    </div>

    <p class="copy label">
      <small>© {years} {site.name}. {t.footer.rights}</small>
    </p>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: var(--section);
    padding-top: clamp(2.5rem, 5vw, 4.5rem);
    padding-bottom: 1.5rem;
    background: var(--orange);
    color: var(--on-orange);
    overflow: hidden;
    /* Überfahren auf Orange: blaues Feld mit heller Schrift (wie bei den orangen Knöpfen), sonst wäre es unsichtbar */
    --hover: var(--blue);
    --on-hover: var(--on-blue);
  }
  /* Fußzeile Portland Orange mit heller Schrift (White Chocolate) – seit 21.11.2026, Jeskos Wahl („orange hell“).
     Kontrast 3,2 : 1: gut für den großen Namen und die fetten Adressen, knapp für die kleine Schrift (Impressum,
     Datenschutz, ©); ein dunkleres Orange (#B8330D, 4,8 : 1) stand zur Wahl, er nahm das helle. Vorher am selben Tag beige
     (--wall-2, Git-Tag alte-version-fusszeile-beige), am 20.11.2026 June Bud, davor Dark Blue wie Startseite und
     Menü, davor Schwarz mit Koralle (Git-Tag alte-version-ultramarin-climate-crisis). */
  .site-footer :global(a:hover) {
    background-color: var(--hover);
    color: var(--on-hover);
  }
  /* Adressen links, Rechtliches rechts – beide auf derselben Grundlinie (nicht an der Unterkante der Kästen) */
  .top {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-end;
    align-items: last baseline;
    gap: 1.5rem 2rem;
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 1.15rem 2rem; /* untereinander (Handy): Abstand so, dass die 44-px-Tippflächen nicht überlappen */

  }
  .to-top {
    display: inline-flex;
    align-items: center;
    gap: 0.3em;
  }
  .to-top :global(svg) {
    transition: translate 0.3s var(--pop);
  }
  .to-top:hover :global(svg) {
    translate: 0 -0.2em;
  }
  .contact :global(.big-link) {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    font-size: var(--fs-lead);
    font-weight: 600;
    text-decoration: none;
    line-height: 1.3;
  }
  .legal {
    display: flex;
    flex-wrap: wrap;
    gap: 1.35rem 1.75rem; /* zweite Zeile am Handy: Tippflächen (44 px) überlappen nicht */

    font-size: var(--fs-sm);
    font-weight: 750;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .legal a {
    text-decoration: none;
  }
  /* Der Schriftzug ist der Name wie auf der Startseite (Migha Black, Großbuchstaben) und füllt die Breite des
     Inhaltsbereichs (cqi = 1 % davon): „JESKO DORNER“ ist 5,90 × so breit wie die Schriftgröße → / 6.05 lässt etwas
     Luft. (Vorher Migha Regular „Jesko Dorner“: 5,64 → / 5.8; Bodoni Moda: 6,08 → / 6.25) */
  .wordmark-wrap {
    container-type: inline-size;
  }
  .wordmark {
    margin-top: clamp(2.5rem, 6vw, 5rem);
    white-space: nowrap;
    font-size: clamp(3rem, 23vw, 34rem);
    font-size: calc(100cqi / 6.05);
    font-family: var(--font-name);
    font-weight: 400;
    font-synthesis-weight: none;
    text-transform: uppercase;
    line-height: 0.95;
    color: inherit;
    user-select: none;
  }
  .copy {
    margin-top: 1.25rem;
    color: inherit;
  }
  .copy small {
    font-size: inherit;
  }
</style>
