---
import { site } from '../config/site';
import { useTranslations } from '../i18n';
import Icon from './Icon.astro';
import EmailLink from './EmailLink.astro';

const t = useTranslations();
const year = new Date().getFullYear();
const years = year > site.copyrightSince ? `${site.copyrightSince}–${year}` : String(year);
---

<footer class="site-footer">
  <div class="container container--wide">
    <div class="top">
      <div class="contact">
        <p class="label">{t.nav.contact}</p>
        <p class="links">
          <EmailLink class="big-link" />
          <a class="big-link" href={site.instagram.url} rel="me noopener" target="_blank">
            <Icon name="instagram" size="0.9em" /> @{site.instagram.handle}
          </a>
        </p>
      </div>
      <nav class="legal" aria-label="Rechtliches">
        <a href="/impressum/">{t.footer.imprint}</a>
        <a href="/datenschutz/">{t.footer.privacy}</a>
        <a href="#top">{t.footer.top} ↑</a>
      </nav>
    </div>

    <div class="wordmark-wrap">
      <p class="wordmark display stretch" aria-hidden="true">Jesko Dorner</p>
    </div>

    <p class="copy label">
      <small>© {years} {site.name}. {t.footer.rights}</small>
    </p>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: var(--section);
    padding-top: clamp(2.5rem, 5vw, 4.5rem);
    padding-bottom: 1.5rem;
    background: var(--ink);
    color: var(--wall);
    overflow: hidden;
  }
  .site-footer a:hover {
    color: var(--lime);
  }
  .top {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-end;
    gap: 2rem;
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 2rem;
    margin-top: 0.6rem;
  }
  .contact :global(.big-link) {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    font-size: var(--fs-lead);
    font-weight: 600;
    text-decoration: none;
    border-bottom: 3px solid var(--pink);
    line-height: 1.3;
  }
  .legal {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.75rem;
    font-size: var(--fs-sm);
    font-weight: 750;
    font-stretch: 85%;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .legal a {
    text-decoration: none;
  }
  /* Der Schriftzug füllt genau die Breite des Inhaltsbereichs (cqi = 1 % davon).
     Bei font-stretch 92 % ist „JESKO DORNER“ 7,26 × so breit wie die Schriftgröße → / 7.4 lässt etwas Luft.
     So passt er auch ohne Scroll-Animation (Firefox, „Bewegung reduzieren“) und auf dem Handy. */
  .wordmark-wrap {
    container-type: inline-size;
  }
  .wordmark {
    --stretch-from: 50%;
    --stretch-to: 92%;
    margin-top: clamp(2.5rem, 6vw, 5rem);
    white-space: nowrap;
    font-size: clamp(3rem, 7.4vw, 21rem);
    font-size: calc(100cqi / 7.4);
    line-height: 0.82;
    font-stretch: 92%;
    color: var(--pink);
    user-select: none;
  }
  .copy {
    margin-top: 1.25rem;
    color: #bdbdbd;
  }
  .copy small {
    font-size: inherit;
  }
</style>
